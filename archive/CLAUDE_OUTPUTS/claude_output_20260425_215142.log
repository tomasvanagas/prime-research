    1	"""
    2	Riemann Explicit Formula for pi(x)
    3	===================================
    4	Computes the prime-counting function pi(x) using:
    5	  pi(x) = R(x) - sum_rho R(x^rho)
    6	
    7	where R(x) is the Riemann prime-counting function:
    8	  R(x) = sum_{n=1}^{inf} mu(n)/n * li(x^{1/n})
    9	
    10	and rho ranges over the non-trivial zeros of the Riemann zeta function.
    11	
    12	Uses mpmath for arbitrary-precision complex exponential integral.
    13	Zeta zeros are precomputed via mpmath.zetazero() and cached to disk.
    14	"""
    15	
    16	import mpmath
    17	import time
    18	import os
    19	import math
    20	
    21	mpmath.mp.dps = 30  # 30 decimal places of precision
    22	
