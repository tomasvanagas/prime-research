# Cross-check: under S74's k_* values {10, 26, 26}, what's block/pi(N) and Q_eff exponent?
import json, math
from pathlib import Path

SPIKE_DIR = Path('experiments/constructions/spike_eigenvectors_chi_p')
JSON_PATH = Path('experiments/constructions/spike_block_21pct_test/spike_block_21pct_test_results.json')
analytic = json.loads(JSON_PATH.read_text())

# S74's table: W=2, k_* values for d=14,16,18,20,22 = 10, 25, 26, 26, 50
s74_kstar = {14: 10, 18: 26, 20: 26}
s82_kstar = {14: 5,  18: 15, 20: 26}

# We need the analytic cum(Q) trajectory. We have it for d=20 in (B.2). For d=14 and d=18 we need to recompute or use canonical.
# Use canonical_table to interpolate Q_eff. canonical_table has Q at a in {0.10, 0.15, 0.20, 0.21, 0.25, 0.30}.

print('Effect of k_* choice (S82 vs S74) on block/pi(N) and Q_eff exponent:')
print()

for d in [14, 18, 20]:
    fn = SPIKE_DIR / f'spike_d{d}_results.json'
    data = json.loads(fn.read_text())[0]
    sigmas = [s['sigma'] for s in data['chi_p_spikes']]
    N = 2**d
    pi_N = analytic['per_d'][str(d)]['pi_N']
    
    block_s82 = sum(s*s for s in sigmas[1:1+s82_kstar[d]])
    block_s74 = sum(s*s for s in sigmas[1:1+s74_kstar[d]])
    
    # For Q_eff, use canonical table interpolation (or linear interp between known points)
    canon = analytic['canonical_table'][str(d)]
    # build a list (Q, cum) sorted
    points = [(int(v['Q']), v['cum']) for k,v in canon.items()]
    points.sort()
    
    def find_qeff(target):
        # Linear interp in (Q, cum) — actually we want the Q at which cum >= target
        # Use log-linear in Q if needed
        for i in range(len(points)-1):
            Q1, c1 = points[i]
            Q2, c2 = points[i+1]
            if c1 <= target <= c2:
                # Linear interpolation in Q
                if c2 == c1:
                    return Q1
                Q = Q1 + (target - c1) / (c2 - c1) * (Q2 - Q1)
                return Q
        # extrapolate
        if target < points[0][1]:
            return points[0][0]
        if target > points[-1][1]:
            return points[-1][0]
        return None
    
    Q_eff_s82 = find_qeff(block_s82)
    Q_eff_s74 = find_qeff(block_s74)
    
    exp_s82 = math.log(Q_eff_s82) / math.log(N) if Q_eff_s82 else float('nan')
    exp_s74 = math.log(Q_eff_s74) / math.log(N) if Q_eff_s74 else float('nan')
    
    print(f'd={d}: pi(N)={pi_N}')
    print(f'   S82 k_*={s82_kstar[d]}: block={block_s82:9.2f}, block/pi={block_s82/pi_N:.4f}, Q_eff={Q_eff_s82:5.2f}, exp={exp_s82:.4f}')
    print(f'   S74 k_*={s74_kstar[d]}: block={block_s74:9.2f}, block/pi={block_s74/pi_N:.4f}, Q_eff={Q_eff_s74:5.2f}, exp={exp_s74:.4f}')
    print(f'   ratio_change: {block_s74/block_s82:.3f}x, exp_change: +{exp_s74-exp_s82:.4f}')
    print()
"

