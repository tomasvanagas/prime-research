from itertools import permutations
def sign(p):
    inv = 0
    for i in range(len(p)):
        for j in range(i+1, len(p)):
            if p[i] > p[j]: inv += 1
    return -1 if inv & 1 else 1

# Print all 24 perms with sign
terms = []
for p in permutations(range(4)):
    s = sign(p)
    sym = '+' if s == 1 else '-'
    terms.append((s, p))
    print(f'{sym} A 0 {p[0]} * A 1 {p[1]} * A 2 {p[2]} * A 3 {p[3]}')
print(f'Total +: {sum(1 for s,_ in terms if s==1)}, -: {sum(1 for s,_ in terms if s==-1)}')
"

