  [Bash] python3 -c "
import sys
sys.path.insert(0, '/apps/aplikacijos/prime-research')
from experiments.algebraic.redei_symbol_prime_triples.redei_symbol_prime_triples import (
    enumerate_admissible_triples, redei_symbol, find_norm_rep_4q, primes_1_mod_4
)
import math

# h(p)=1 primes ≡ 1 mod 4 (from sympy or LMFDB knowledge)
# Use heuristic: p with N(ε_p) = -1 AND h(p) = 1 means every q has +q rep.
# But we need actual h(p).  Use sympy's class_number? Sympy has?
# Quick alternative: check whether all admissible q of form (p/q)=1 have 4q-rep.
N = 1000
all_p = primes_1_mod_4(N)
bad_p = set()
for p in all_p:
    for q in all_p:
        if q == p: continue
        from experiments.algebraic.redei_symbol_prime_triples.redei_symbol_prime_triples import legendre
        if legendre(p, q) != 1: continue
        if find_norm_rep_4q(p, q) is None:
            bad_p.add(p)
            break
print(f'Total p ≡ 1 mod 4 ≤ {N}: {len(all_p)}')
print(f'p with at least one INCONCLUSIVE q: {sorted(bad_p)}')
print(f'Number of \"clean\" p (h(p)=1 in this sense): {len(all_p) - len(bad_p)}')
print()

triples = enumerate_admissible_triples(N)
clean_triples = [(p,q,r) for (p,q,r) in triples if p not in bad_p and q not in bad_p]
print(f'Total admissible triples: {len(triples)}')
print(f'Clean-p triples (excluding bad p, q): {len(clean_triples)}')
print()
# Compute Rédei on clean subset
n_plus = 0; n_minus = 0; n_inc = 0
for (p,q,r) in clean_triples:
    s = redei_symbol(p,q,r)
    if s == 1: n_plus += 1
    elif s == -1: n_minus += 1
    else: n_inc += 1
K = n_plus + n_minus
fplus = n_plus / K if K else 0.5
sigma = 0.5 / math.sqrt(K) if K else 1
z = (fplus - 0.5) / sigma if K else 0
p_val = math.erfc(abs(z) / math.sqrt(2))
print(f'Clean: K={K}, n_+ = {n_plus}, n_- = {n_minus}, f_+ = {fplus:.5f}, z = {z:.3f}, p = {p_val:.4e}')
