  [Bash] python3 -c "
from sympy.solvers.diophantine.diophantine import diop_DN
from sympy.ntheory.residue_ntheory import sqrt_mod
import math

# All solutions to U²-13V²=4·61=244
sols = diop_DN(13, 244)
print('All fundamental solutions:', sols)
sigma = sqrt_mod(13, 937)
print(f'sigma² ≡ 13 mod 937: σ = {sigma}')

# Test each solution
def jacobi(a, n):
    a %= n
    result = 1
    while a:
        while a % 2 == 0:
            a //= 2
            if n % 8 in (3, 5): result = -result
        a, n = n, a
        if a % 4 == 3 and n % 4 == 3: result = -result
        a %= n
    return result if n == 1 else 0

for U, V in sols:
    U, V = int(U), int(V)
    if (U % 2) != (V % 2): continue
    inv2 = pow(2, -1, 937)
    val = ((U + V * sigma) * inv2) % 937
    sym = jacobi(val, 937)
    print(f'  (U,V)=({U},{V}): val mod 937 = {val}, Rédei = {sym}')
