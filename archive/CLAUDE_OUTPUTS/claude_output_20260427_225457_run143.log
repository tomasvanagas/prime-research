    14	def sieve_primes(limit):
    15	    """Fast sieve of Eratosthenes."""
    16	    sieve = bytearray(b'\x01') * (limit + 1)
    17	    sieve[0] = sieve[1] = 0
    18	    for i in range(2, int(limit**0.5) + 1):
    19	        if sieve[i]:
    20	            sieve[i*i::i] = bytearray(len(sieve[i*i::i]))
    21	    return [i for i in range(2, limit + 1) if sieve[i]]
