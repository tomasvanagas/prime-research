  [Bash] python3 -c "
import numpy as np
import math

# Check: for IID Bern f(z) = Σ B_n z^n, what's ‖f‖_4^4 / [Li(N)^4 / N]?
# Theory: (2/3) leading term, but maybe more.
N = 4096
mu = 564/4096
M_fft = 16 * (N + 1)
M_fft = 1 << int(math.ceil(math.log2(M_fft)))

rng = np.random.default_rng(2026)
ratios = []
for trial in range(8):
    coeffs = np.zeros(N+1, dtype=np.float64)
    coeffs[2:] = (rng.random(N-1) < mu).astype(np.float64)
    pad = np.zeros(M_fft, dtype=np.float64)
    pad[:len(coeffs)] = coeffs
    F = np.fft.fft(pad)
    abs_F = np.abs(F)
    L4 = np.mean(abs_F**4)
    Li_N = N/math.log(N)
    ratio = L4 / (Li_N**4 / N)
    ratios.append(ratio)

print('Bern raw L4 ratio:', np.mean(ratios), '+/-', np.std(ratios))

# Check Dirichlet kernel: D_N(theta) = sum_{n=0}^N e^{i theta n}.
# |D_N|^4 integral = ?
ones = np.zeros(M_fft, dtype=np.float64)
ones[:N+1] = 1.0
DN = np.fft.fft(ones)
DN4 = np.mean(np.abs(DN)**4)
print('||D_N||_4^4 =', DN4)
print('||D_N||_4^4 / N^3 =', DN4 / N**3)
print('Expected (2/3) N^3:', (2/3) * N**3)
print()

# And test mu^4 * ||D_N||_4^4:
print('mu^4 * ||D_N||_4^4 =', mu**4 * DN4)
print('Bern empirical ||f||_4^4 (mean):', np.mean([np.mean(np.abs(np.fft.fft(np.r_[0,0,(rng.random(N-1)<mu)],n=M_fft))**4) for _ in range(4)]))
"

