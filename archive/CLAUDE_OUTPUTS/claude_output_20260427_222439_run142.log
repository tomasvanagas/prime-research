import json
import numpy as np
import math

with open('f_vector_N1000000_delsarte_g_obs.json') as f:
    d = json.load(f)

f_vec = np.array(d['f'])
g_obs = np.array(d['g_obs'])
T = d['T_max']
print(f'N={d[chr(34)+chr(78)+chr(34)] if False else 1000000}, T={T}, len(f)={len(f_vec)}')

# show first 30 coefs
print('\nFirst 20 f(t) coefficients:')
for t in range(20):
    print(f'  f({t:3d}) = {f_vec[t]:+.4e}    g_obs({t:3d}) = {g_obs[t]:+.4e}')

# nonzero indices
nz = np.flatnonzero(np.abs(f_vec) > 1e-8)
print(f'\nNonzero f indices ({len(nz)} of {len(f_vec)}):')
print(' ', nz[:50].tolist())

# check parity: most entries should be at even t (since g_HL is supported on even t)
ev_total = np.sum(np.abs(f_vec[2::2]))
od_total = np.sum(np.abs(f_vec[1::2]))
print(f'\nTotal |f| at even t (>=2): {ev_total:.4f}')
print(f'Total |f| at odd t (>=1): {od_total:.4f}')

# residue mod small q
for q in [6, 12, 30]:
    print(f'\nResidues mod {q}:')
    for r in range(q):
        idx = [t for t in range(1, T+1) if t % q == r]
        s = sum(f_vec[t] for t in idx)
        a = sum(abs(f_vec[t]) for t in idx)
        print(f'  r={r:2d}  sum f = {s:+.4e}, sum |f| = {a:.4e}')

# Compute f_hat at uniform sample
M = 8192
xi = np.linspace(0, 0.5, M)
f_hat = f_vec[0] + 2 * np.sum([f_vec[t]*np.cos(2*np.pi*t*xi) for t in range(1, T+1)], axis=0)
print(f'\nf_hat statistics:')
print(f'  f_hat(0)   = {f_hat[0]:.6f}')
print(f'  min f_hat  = {f_hat.min():.6e}  (Bochner constraint enforces >= 0)')
print(f'  max f_hat  = {f_hat.max():.6e}')
print(f'  argmax xi  = {xi[f_hat.argmax()]:.4f}')

# locations of f_hat peaks (modular structure?)
idx_peaks = np.argsort(f_hat)[-30:][::-1]
print(f'\nTop 10 f_hat peak locations (xi value, f_hat):')
for i in idx_peaks[:10]:
    print(f'  xi = {xi[i]:.4f}  (= {xi[i]*1:.4f}),  f_hat = {f_hat[i]:.4f}')
