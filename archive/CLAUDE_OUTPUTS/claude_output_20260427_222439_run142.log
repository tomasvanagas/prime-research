import json, numpy as np
with open('T_sweep_results.json') as f:
    d = json.load(f)
res = d['results']
T = np.array([r['T'] for r in res])
f_obs = np.array([r['f_hat_obs'] for r in res])
f_HL = np.array([r['f_hat_HL'] for r in res])

# fit f_hat = a + b log T
logT = np.log(T)
A = np.vstack([logT, np.ones_like(logT)]).T
b_obs, a_obs = np.linalg.lstsq(A, f_obs, rcond=None)[0]
b_HL, a_HL = np.linalg.lstsq(A, f_HL, rcond=None)[0]
print(f'g_obs:  f_hat^*(0) = {a_obs:.4f} + {b_obs:.4f} * log T')
print(f'g_HL :  f_hat^*(0) = {a_HL:.4f} + {b_HL:.4f} * log T')
print()
print(f'Predicted T to make 1/f_hat = rho = 0.0785 (N=10^6):')
print(f'  g_obs needs f_hat = 12.74; log T = {(12.74-a_obs)/b_obs:.2f}, T = {np.exp((12.74-a_obs)/b_obs):.2e}')
print(f'  g_HL  needs f_hat = 12.74; log T = {(12.74-a_HL)/b_HL:.2f}, T = {np.exp((12.74-a_HL)/b_HL):.2e}')
print()
print(f'Residuals from log-fit (g_obs):')
for r in res:
    pred = a_obs + b_obs * np.log(r['T'])
    actual = r['f_hat_obs']
    print(f'  T={r[chr(34)+chr(84)+chr(34)] if False else r[\"T\"]:>5d}  actual={actual:.3f}  pred={pred:.3f}  resid={actual-pred:+.3f}')
"

