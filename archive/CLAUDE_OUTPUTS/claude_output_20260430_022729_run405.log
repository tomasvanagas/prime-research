import json
data = json.load(open('phase_diagram_results.json'))
rows = data['rows']
print(f'Total rows: {len(rows)}')
print(f'Aggregate err (Phase-Lim valid for sigma_Y>=1)...')

# Check phase_lim accuracy split by sigma_Y regime.
sig_Y_ge_2 = [r for r in rows if r['sigma_Y'] >= 2.0]
sig_Y_lt_2 = [r for r in rows if r['sigma_Y'] < 2.0]
import numpy as np
err_pl_high = np.mean([abs(r['rel_pred_phase_lim']-r['rel_emp']) for r in sig_Y_ge_2])
err_pl_low = np.mean([abs(r['rel_pred_phase_lim']-r['rel_emp']) for r in sig_Y_lt_2])
print(f'  sigma_Y >= 2.0 (n={len(sig_Y_ge_2)}): mean |Δrel_phase_lim| = {err_pl_high:.4f}')
print(f'  sigma_Y <  2.0 (n={len(sig_Y_lt_2)}): mean |Δrel_phase_lim| = {err_pl_low:.4f}')

# Decile breakdown for sigma_norm < 1
sig_lt1 = [r for r in rows if r['sigma_norm'] < 1.0]
print(f'\\nDecile breakdown (sigma_norm < 1.0, n={len(sig_lt1)}):')
deciles = {}
for r in sig_lt1:
    d = min(int(r['alpha']*10), 9)
    deciles.setdefault(d, []).append(r)
for d in range(10):
    if d in deciles:
        rs = deciles[d]
        rels = [r['rel_emp'] for r in rs]
        ms = [r['m'] for r in rs]
        print(f'  decile {d} alpha in [{d/10:.1f},{(d+1)/10:.1f}): n={len(rs)}, mean rel={np.mean(rels):.3f}, max rel={max(rels):.3f}, min rel={min(rels):.3f}, m examples: {ms[:5]}{\"...\" if len(ms)>5 else \"\"}')
    else:
        print(f'  decile {d}: empty')

# Empirical-r is exact, what about peak structure
top10_peaks = sorted(rows, key=lambda r: -r['rel_emp'])[:10]
print(f'\\nTop-10 peaks (rel_emp):')
for r in top10_peaks:
    print(f'  m={r[\"m\"]:>4}  J*={r[\"J_star\"]}  rel={r[\"rel_emp\"]:>7.3f}  alpha={r[\"alpha\"]:.3f}  sig_norm={r[\"sigma_norm\"]:.4f}  sig_Y={r[\"sigma_Y\"]:.3f}')

# Bottom-10 troughs
bot10_troughs = sorted(rows, key=lambda r: r['rel_emp'])[:10]
print(f'\\nBottom-10 troughs (rel_emp):')
for r in bot10_troughs:
    print(f'  m={r[\"m\"]:>4}  J*={r[\"J_star\"]}  rel={r[\"rel_emp\"]:>7.4f}  alpha={r[\"alpha\"]:.3f}  sig_norm={r[\"sigma_norm\"]:.4f}  sig_Y={r[\"sigma_Y\"]:.3f}')
