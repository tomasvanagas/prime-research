import json, math
data = json.load(open('phase_diagram_results.json'))
rows = data['rows']
# Find m=110
r = next(r for r in rows if r['m']==110)
print('m=110 row:', r)
print(f'sigma_norm computed = sigma_Y/m = {r[\"sigma_Y\"]}/{r[\"m\"]} = {r[\"sigma_Y\"]/r[\"m\"]}')

# Now manually compute phase_lim prediction.
def WG(alpha, sigma_norm, jrange=20):
    inv_norm = 1.0/(sigma_norm * math.sqrt(2*math.pi))
    s = 0.0
    for j in range(-jrange, jrange+1):
        z = (j - alpha)/sigma_norm
        s += math.exp(-0.5*z*z)
    return inv_norm * s

print(f'WG(alpha={r[\"alpha\"]}, sigma_norm={r[\"sigma_norm\"]}) =', WG(r['alpha'], r['sigma_norm']))
print(f'rel_pred_phase_lim from JSON =', r['rel_pred_phase_lim'])
