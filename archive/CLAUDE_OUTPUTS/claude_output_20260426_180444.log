import json
import numpy as np
data = json.load(open('spectrum_features.json'))
primes = [r for r in data if r['is_prime']]
comps = [r for r in data if not r['is_prime']]
print(f'primes: {len(primes)}, composites: {len(comps)}')
print()

# Test all numeric features
numeric_keys = []
for k, v in data[0].items():
    if isinstance(v, (int, float)) and k not in ['n', 'phi_n', 'matrix_size']:
        numeric_keys.append(k)

print(f'{\"Feature\":<25} {\"p_min\":>10} {\"p_max\":>10} {\"c_min\":>10} {\"c_max\":>10} {\"sep_z\":>8} {\"AUC\":>6}')
print('-' * 90)
# AUC = how well does feature alone classify?
for k in numeric_keys:
    pvs = np.array([r[k] for r in primes], dtype=np.float64)
    cvs = np.array([r[k] for r in comps], dtype=np.float64)
    p_min, p_max = pvs.min(), pvs.max()
    c_min, c_max = cvs.min(), cvs.max()
    disjoint = (p_max < c_min) or (c_max < p_min)
    sep_med = (np.median(pvs) - np.median(cvs)) / (np.std(pvs) + np.std(cvs) + 1e-9)
    # AUC via Mann-Whitney
    from scipy import stats
    try:
        u, p = stats.mannwhitneyu(pvs, cvs, alternative='two-sided')
        auc = u / (len(pvs) * len(cvs))
        # Use max(auc, 1-auc) as discriminative power
        auc_disc = max(auc, 1 - auc)
    except Exception:
        auc_disc = 0.5
    marker = ' DISJOINT' if disjoint else ''
    print(f'{k:<25} {p_min:>10.4f} {p_max:>10.4f} {c_min:>10.4f} {c_max:>10.4f} {sep_med:>+8.3f} {auc_disc:>6.3f}{marker}')
