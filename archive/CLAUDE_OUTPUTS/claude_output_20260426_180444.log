import json
import numpy as np
from scipy import stats

data = json.load(open('spectrum_features.json'))
primes = [r for r in data if r['is_prime']]
comps = [r for r in data if not r['is_prime']]

# Try normalized variants
def add_features(rows):
    for r in rows:
        m = r['matrix_size']
        r['int_frac'] = r['n_int_eigs'] / m
        r['perfect_frac'] = r['n_perfect_int'] / m
        r['zero_frac'] = r['n_zero_eigs'] / m
        r['mult_frac'] = r['max_mult'] / m
        r['avgmult_frac'] = r['avg_mult'] / m
        r['log_int'] = np.log(max(1, r['n_int_eigs']))
        r['log_perfint'] = np.log(max(1, r['n_perfect_int']))
        r['log_max_mult'] = np.log(max(1, r['max_mult']))
        # how does n_int_eigs / log(n) scale?
        # Empirical: for prime p, expected non-trivial char sum integer => structure
add_features(primes)
add_features(comps)

print(f'{\"Feature\":<22} {\"p_min\":>10} {\"p_max\":>10} {\"c_min\":>10} {\"c_max\":>10} {\"AUC\":>6} {\"DISJOINT?\":>10}')
print('-' * 90)
for k in ['int_frac', 'perfect_frac', 'zero_frac', 'mult_frac', 'avgmult_frac', 'log_int', 'log_perfint', 'log_max_mult']:
    pvs = np.array([r[k] for r in primes], dtype=np.float64)
    cvs = np.array([r[k] for r in comps], dtype=np.float64)
    p_min, p_max = pvs.min(), pvs.max()
    c_min, c_max = cvs.min(), cvs.max()
    disjoint = (p_max < c_min) or (c_max < p_min)
    u, p = stats.mannwhitneyu(pvs, cvs, alternative='two-sided')
    auc = u / (len(pvs) * len(cvs))
    auc_disc = max(auc, 1 - auc)
    marker = '*DISJOINT*' if disjoint else ''
    print(f'{k:<22} {p_min:>10.4f} {p_max:>10.4f} {c_min:>10.4f} {c_max:>10.4f} {auc_disc:>6.3f} {marker:>10}')

# Look at extremes for n_int_eigs
print()
print('Top 20 primes by n_int_eigs:')
sorted_primes = sorted(primes, key=lambda r: -r['n_int_eigs'])
for r in sorted_primes[:20]:
    print(f'  n={r[\"n\"]:5d} (matrix={r[\"matrix_size\"]}), n_int_eigs={r[\"n_int_eigs\"]:4d}, max_mult={r[\"max_mult\"]:3d}, sg_idx={r[\"sg_index\"]}')

print()
