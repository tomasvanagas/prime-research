import json
import numpy as np
data = json.load(open('spectrum_features.json'))
primes = [r for r in data if r['is_prime']]
comps = [r for r in data if not r['is_prime']]
print(f'primes: {len(primes)}, composites: {len(comps)}')
print()
print('Composites with mult_max=2 (sg_index=2, ⟨2,3,5⟩ has index 2):')
for r in comps:
    if r['mult_max'] >= 2:
        print(f'  n={r[\"n\"]:5d}, fac={r[\"factorization\"]:>20}, mult_max={r[\"mult_max\"]}, sg_idx={r[\"sg_index\"]}')
print()
print('Primes with mult_max=2 (very rare? or common?):')
n_prime_mm2 = 0
prime_mm2_examples = []
for r in primes:
    if r['mult_max'] >= 2:
        n_prime_mm2 += 1
        prime_mm2_examples.append(r)
print(f'  total: {n_prime_mm2} of {len(primes)} primes')
for r in prime_mm2_examples[:10]:
    print(f'  n={r[\"n\"]:5d}, mult_max={r[\"mult_max\"]}, sg_idx={r[\"sg_index\"]}')
print()
print('Composite mult_max=1 examples:')
