import json
import numpy as np
from sympy import isprime, factorint, primefactors
from collections import Counter

data = json.load(open('spectrum_features.json'))

# Group by omega(n) = number of distinct prime factors
def omega(n_fac_str):
    # parse {7: 2, 11: 1} -> 2
    fac = eval(n_fac_str)
    return len(fac)

print(f'{\"omega\":>6} {\"is_prime\":>8} {\"count\":>6} {\"min_int\":>8} {\"med_int\":>8} {\"max_int\":>8} {\"min_2omega\":>10}')
groups = {}
for r in data:
    om = omega(r['factorization'])
    key = (om, r['is_prime'])
    groups.setdefault(key, []).append(r)
for key in sorted(groups.keys()):
    rows = groups[key]
    ints = [r['n_int_eigs'] for r in rows]
    print(f'{key[0]:>6} {str(key[1]):>8} {len(rows):>6d} {min(ints):>8d} {int(np.median(ints)):>8d} {max(ints):>8d} {2**key[0]:>10d}')

# Verify n_int_eigs >= 2^omega(n) for all entries
violations = 0
for r in data:
    om = omega(r['factorization'])
    if r['n_int_eigs'] < 2**om:
        violations += 1
        print(f'  VIOLATION: n={r[\"n\"]}, fac={r[\"factorization\"]}, omega={om}, n_int_eigs={r[\"n_int_eigs\"]}, expected >= {2**om}')
print(f'Total violations of n_int_eigs >= 2^omega(n): {violations} / {len(data)}')

# Check tightness of lower bound: how often is n_int_eigs == 2^omega(n)?
tight = 0
for r in data:
    om = omega(r['factorization'])
    if r['n_int_eigs'] == 2**om:
        tight += 1
print(f'Tight (n_int_eigs == 2^omega(n)): {tight} / {len(data)}')

# By group
print()
print('Cyclic (Z/nZ)* status:')
print('  Cyclic iff n=1, 2, 4, p^k, 2p^k for odd prime p.')
# All our n are coprime to 30, so n is odd. Cyclic iff n = p^k (odd p).
# Any n with omega(n) >= 2 is non-cyclic.
# Let's verify: among omega=1 entries, are some prime powers (composite)?
print()
print('omega=1, composite (prime powers):')
for r in data:
    om = omega(r['factorization'])
    if om == 1 and not r['is_prime']:
        print(f'  n={r[\"n\"]}, fac={r[\"factorization\"]}, n_int_eigs={r[\"n_int_eigs\"]}, max_mult={r[\"max_mult\"]}')
