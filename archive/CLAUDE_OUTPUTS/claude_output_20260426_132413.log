# Quick sanity verification of the TT-rank claim at L=10 (cheap)
import numpy as np
from sympy import isprime
L=10; N=2**L
chi=np.array([1.0 if isprime(i) else 0 for i in range(N)])
T=chi.reshape((2,)*L)
A=T.reshape(2,-1); ranks=[1]
for ell in range(L-1):
    U,S,Vt=np.linalg.svd(A,full_matrices=False)
    s0=S[0] if S[0]>0 else 1
    r=int(np.sum(S>1e-10*s0))
    ranks.append(r)
    A=(np.diag(S[:r])@Vt[:r])
    if ell+1<L-1: A=A.reshape(r*2,-1)
