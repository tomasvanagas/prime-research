"""Find the W=20 triangulation with smallest max prime / smallest sum of below-diagonal entries."""
import sympy
from math import gcd

def is_prime(n):
    return n >= 2 and sympy.isprime(n)

W = 20
R = 9

live_cols = [k for k in range(W) if gcd(k+1, W) == 1]
dead_col_options = [k for k in range(W) if gcd(k+1, W) != 1 and is_prime(k+1)]

def slab_row(r):
    return [1 if is_prime(r*W + k + 1) else 0 for k in range(W)]

rows = [slab_row(r) for r in range(W)]

best = None  # (max_prime_in_diagonal, max_below_composite, ...)
solutions = []

for dead_col in dead_col_options:
    col_set = sorted(live_cols + [dead_col])
    if len(col_set) != R:
        continue
    sub = [[rows[r][c] for c in col_set] for r in range(W)]

    # Backtrack and collect all solutions (cap at 100)
    used_rows = [False] * W
    used_cols = [False] * R
    rho = []
    sigma = []
    found = []
    
    def backtrack(level):
        if len(found) > 5000:
            return
        if level == R:
            found.append((rho[:], sigma[:]))
            return
        for r in range(W):
            if used_rows[r]: continue
            ok = True
            for j in range(level):
                if sub[r][sigma[j]] != 0:
                    ok = False; break
            if not ok: continue
            for c in range(R):
                if used_cols[c]: continue
                if sub[r][c] != 1: continue
                rho.append(r); sigma.append(c)
                used_rows[r]=True; used_cols[c]=True
                backtrack(level+1)
                rho.pop(); sigma.pop()
                used_rows[r]=False; used_cols[c]=False
    
    backtrack(0)
    
    print(f"dead_col={dead_col}, cols={col_set}, found {len(found)} solutions")
    
    for rho_s, sigma_s in found:
        sigma_actual = [col_set[s] for s in sigma_s]
        diag = [rho_s[i]*W + sigma_actual[i] + 1 for i in range(R)]
        below = []
        for i in range(R):
            for j in range(i):
                v = rho_s[i]*W + sigma_actual[j] + 1
                below.append(v)
        max_diag = max(diag)
        max_below = max(below) if below else 0
        sum_diag = sum(diag)
        # primary: minimize max_diag; secondary: minimize max_below; tertiary: minimize sum_diag
        key = (max_diag, max_below, sum_diag)
        if best is None or key < best[0]:
            best = (key, dead_col, rho_s, sigma_actual, diag, sorted(set(below)))

if best:
    key, dead_col, rho, sigma, diag, below = best
    print(f"\nBEST:")
    print(f"  dead_col = {dead_col}")
    print(f"  rho     = {rho}")
    print(f"  sigma   = {sigma}")
    print(f"  diag    = {diag}")
    print(f"  below   = {below}")
    print(f"  max_diag={key[0]}, max_below={key[1]}, sum_diag={key[2]}")
    print(f"  unique primes on diag: {sorted(set(diag))}")
    print(f"  total below-diagonal composites: {len(below)}")
