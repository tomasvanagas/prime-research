  [Bash] cat << 'EOF' > /tmp/presearch_w20_full.py
"""Search W=20 solutions optimizing for smallest max diagonal prime."""
import sympy
from math import gcd

def is_prime(n):
    return n >= 2 and sympy.isprime(n)

W = 20
R = 9
live_cols = [k for k in range(W) if gcd(k+1, W) == 1]
dead_col_options = [k for k in range(W) if gcd(k+1, W) != 1 and is_prime(k+1)]

def slab_row(r):
    return [1 if is_prime(r*W + k + 1) else 0 for k in range(W)]

rows = [slab_row(r) for r in range(W)]
print(f"all primes in slab indices 1..{W*W}:")
for r in range(W):
    primes_in_row = [(r*W+k+1) for k in range(W) if rows[r][k]]
    print(f"  row {r:2d}: {primes_in_row}")

# Search with all caps removed
best = None
total_count = 0

for dead_col in dead_col_options:
    col_set = sorted(live_cols + [dead_col])
    sub = [[rows[r][c] for c in col_set] for r in range(W)]
    used_rows = [False] * W
    used_cols = [False] * R
    rho = []
    sigma = []
    
    def backtrack(level):
        global best, total_count
        if level == R:
            total_count += 1
            sigma_actual = [col_set[s] for s in sigma]
            diag = [rho[i]*W + sigma_actual[i] + 1 for i in range(R)]
            below = []
            for i in range(R):
                for j in range(i):
                    below.append(rho[i]*W + sigma_actual[j] + 1)
            max_diag = max(diag)
            max_below = max(below) if below else 0
            key = (max_diag, max_below)
            if best is None or key < best[0]:
                best = (key, dead_col, rho[:], sigma_actual[:], diag, sorted(set(below)))
            return
        for r in range(W):
            if used_rows[r]: continue
            ok = True
            for j in range(level):
                if sub[r][sigma[j]] != 0:
                    ok = False; break
            if not ok: continue
            for c in range(R):
                if used_cols[c]: continue
                if sub[r][c] != 1: continue
                rho.append(r); sigma.append(c)
                used_rows[r]=True; used_cols[c]=True
                backtrack(level+1)
                rho.pop(); sigma.pop()
                used_rows[r]=False; used_cols[c]=False
    backtrack(0)

print(f"\nTotal solutions found: {total_count}")
if best:
    key, dead_col, rho, sigma, diag, below = best
    print(f"BEST (min max_diag, then min max_below):")
    print(f"  dead_col = {dead_col}")
    print(f"  rho     = {rho}")
    print(f"  sigma   = {sigma}")
    print(f"  diag    = {diag}")
    print(f"  below   = {below}")
    print(f"  max_diag={key[0]}, max_below={key[1]}")
    print(f"  unique primes on diag: {sorted(set(diag))}")
