  [Bash] python3 -c "
import json, math
from spike_eigenvalue_l_squared import L_squared_contributions

# Within-block: do sigma^2 values match individual |L|^2 values?
with open('../spike_eigenvectors_chi_p/spike_d20_results.json') as f:
    rec = json.load(f)[0]
spikes = rec['chi_p_spikes']

# Group spikes by min_q_conductor.
print('Within-block per-spike sigma^2 vs per-character |L|^2:')
print()

for p, q_target in [(3, 6), (5, 10), (7, 14), (11, 22)]:
    block_sigmas2 = sorted([s['sigma']**2 for s in spikes if s.get('min_q_conductor') == q_target], reverse=True)
    if not block_sigmas2:
        continue
    _, contribs = L_squared_contributions(p)
    L2s = sorted([c[1] for c in contribs], reverse=True)
    print(f'q={q_target}, p={p}:')
    print(f'  spike sigma^2 (desc): {[round(x,1) for x in block_sigmas2]}')
    print(f'  spread: max/min = {block_sigmas2[0]/block_sigmas2[-1]:.2f}')
    print(f'  |L(1,chi)|^2 (desc): {[round(x,4) for x in L2s]}')
    if len(L2s) > 1:
        print(f'  spread: max/min = {L2s[0]/L2s[-1]:.2f}')
    print()
"

