  [Bash] cd /tmp && python3 << 'EOF'
"""
Independent re-implementation of cum(Q) for d=14, 16, 18, 20.

Method: For each squarefree q in [2, Q*]:
  E(q, N) = (1/N) * sum_{k coprime to q} | f_hat(k/q) |^2
where f_hat(k/q) = sum_{p prime <= N} e^{2πi k p / q}.

We compute this using FFT on the prime indicator vector.
chi_P[n] = 1 if n prime, 0 else, for n=0..N-1
For each q, restrict to indices and compute Fourier transform on Z/q
"""
import numpy as np
from math import gcd, log

def sieve(N):
    s = np.ones(N+1, dtype=bool)
    s[:2] = False
    for i in range(2, int(N**0.5)+1):
        if s[i]: s[i*i::i] = False
    return s

def is_squarefree(q):
    n = q
    p = 2
    while p*p <= n:
        if n % p == 0:
            n //= p
            if n % p == 0:
                return False
        else:
            p += 1
    return True

def E_q(prime_arr, q, N):
    """Independent: compute via histogram + FFT on Z/q."""
    # Bin primes by residue mod q
    counts = np.bincount(prime_arr % q, minlength=q).astype(np.float64)
    # FFT of counts on Z/q
    F = np.fft.fft(counts)
    # E(q, N) = (1/N) * sum_{k coprime to q} |F[k]|^2
    energy = 0.0
    for k in range(1, q):
        if gcd(k, q) == 1:
            energy += float(F[k].real**2 + F[k].imag**2) / N
    return energy

import json
prev = json.loads(open('/apps/aplikacijos/prime-research/experiments/constructions/spike_block_21pct_test/spike_block_21pct_test_results.json').read())

for d in [14, 16, 18, 20]:
    N = 2**d
    primes = np.nonzero(sieve(N))[0]
    pi_N = len(primes)
    Q_star = max(2, int(round(N**0.21)))
    cum = 0.0
    for q in range(2, Q_star+1):
        if is_squarefree(q):
            cum += E_q(primes, q, N)
    prev_cum = prev['per_d'][str(d)]['cum_emp_Qstar']
    prev_pi = prev['per_d'][str(d)]['pi_N']
    print(f"d={d}, N={N}, pi(N)={pi_N} (prev {prev_pi}), Q*={Q_star}")
    print(f"  cum_emp(Q*) = {cum:.4f}  vs prev {prev_cum:.4f}  diff {cum-prev_cum:+.6f}")
    print(f"  cum / pi(N) = {cum/pi_N:.6f}, ratio to 0.21pi(N) = {cum/(0.21*pi_N):.4f}")
