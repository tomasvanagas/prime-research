# Independent re-derivation of cum(Q^*) from scratch, no SVD dependency.
# Cross-check the d=14 number end-to-end.
import math, json
import numpy as np

def sieve(N):
    is_p = np.ones(N+1, dtype=bool)
    is_p[:2] = False
    for i in range(2, int(N**0.5)+1):
        if is_p[i]: is_p[i*i::i]=False
    return is_p

def is_sqf(q):
    n=q; p=2
    while p*p<=n:
        if n%p==0:
            n//=p
            if n%p==0: return False
        p+=1
    return q>=1

# d=14
d=14; N=2**d; primes = np.nonzero(sieve(N))[0]; pi_N=len(primes)
print(f'd={d}, N={N}, pi_N={pi_N}')

# E(q,N) by direct trig
def E(q,N,primes):
    # sum over k=1..q-1 with gcd(k,q)=1 of |S_k|^2 / N where S_k = sum_p exp(2pi i k p / q)
    tot=0.0
    for k in range(1,q):
        if math.gcd(k,q)!=1: continue
        a=2*math.pi*k*primes/q
        c=float(np.cos(a).sum()); s=float(np.sin(a).sum())
        tot += (c*c+s*s)/N
    return tot

cum=0.0
Q_star = max(2, int(round(N**0.21)))
print(f'Q_star = round(N^0.21) = {Q_star}')
target = 0.21*pi_N
print(f'target 0.21*pi(N)={target}')
qs = [q for q in range(2,Q_star+1) if is_sqf(q)]
for q in qs:
    cum += E(q,N,primes)
print(f'cum(Q*={Q_star}) = {cum:.4f}, ratio to target = {cum/target:.4f}')

# also at the spike block target
spike_block_d14 = 424.8073  # from JSON
cum=0.0
Q=2
while cum < spike_block_d14:
    if is_sqf(Q):
        cum += E(Q,N,primes)
    if cum >= spike_block_d14: break
    Q+=1
print(f'd=14 cum reaches spike_block at Q={Q}, log Q / log N = {math.log(Q)/math.log(N):.6f}')
"

