# How sensitive is Q_eff to k_* choice?
import json, math
import numpy as np

def sieve(N):
    is_p = np.ones(N+1, dtype=bool); is_p[:2]=False
    for i in range(2,int(N**0.5)+1):
        if is_p[i]: is_p[i*i::i]=False
    return is_p

def is_sqf(q):
    n=q; p=2
    while p*p<=n:
        if n%p==0:
            n//=p
            if n%p==0: return False
        p+=1
    return q>=1

def E(q,N,primes):
    tot=0.0
    for k in range(1,q):
        if math.gcd(k,q)!=1: continue
        a=2*math.pi*k*primes/q
        c=float(np.cos(a).sum()); s=float(np.sin(a).sum())
        tot += (c*c+s*s)/N
    return tot

# For each d, build cum table and look up Q_eff for k_*-1, k_*, k_*+1
for d in [14, 18, 20]:
    N=2**d; primes = np.nonzero(sieve(N))[0]; pi_N=len(primes)
    data = json.load(open(f'../spike_eigenvectors_chi_p/spike_d{d}_results.json'))[0]
    sigmas = [s['sigma'] for s in data['chi_p_spikes']]
    k0 = data['k_star_assumed']
    # spike block sums for k0-1, k0, k0+1 and also k0+2 (excludes rank1=sigma[0])
    blocks = {}
    for k in [k0-1, k0, k0+1, k0+2]:
        if 1 <= k < len(sigmas):
            blocks[k] = sum(s*s for s in sigmas[1:1+k])
    # Build cum(Q) table
    Qmax = max(60, int(round(N**0.30)))
    cum=0.0
    cum_arr=[]
    for q in range(2, Qmax+1):
        if is_sqf(q):
            cum += E(q,N,primes)
        cum_arr.append((q, cum))
    # For each block, find Q_eff
    print(f'd={d}, N={N}, pi(N)={pi_N}, k_*={k0}')
    for k, blk in blocks.items():
        for q, c in cum_arr:
            if c >= blk:
                exp_e = math.log(q)/math.log(N)
                print(f'  k_*={k}: spike_block={blk:.2f}, Q_eff={q}, exp={exp_e:.6f}')
                break
"

