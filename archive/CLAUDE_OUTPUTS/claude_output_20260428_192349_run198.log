import json, math
with open('bit_J_pn_cross_modulus_results.json') as f:
    R = json.load(f)
last_p = R['last_prime']
sqrt_p = math.sqrt(last_p)
print(f'L = {R[\"limit\"]:,}, last_p = {last_p:,}, sqrt(p) = {sqrt_p:,.0f}')
print()
print(f'{\"m\":>4} {\"J*\":>3} {\"m^J*\":>10} {\"sqrt(p)/m^J*\":>14} {\"predicted_shift\":>16}    shift_hist[J*]')
for r in R['modulus_results']:
    m = r['m']
    J = r['J_star_observed']
    mJ = m ** J
    pred_shift = round(sqrt_p / mJ) % m
    sh = r['rows'][J]['shift_hist']
    # Top 3 shifts
    indexed = sorted(enumerate(sh), key=lambda x: -x[1])[:3]
    top_str = ', '.join(f's={i}:{p:.4f}' for i,p in indexed)
    print(f'{m:>4} {J:>3} {mJ:>10} {sqrt_p/mJ:>14.3f} {pred_shift:>16}    {top_str}')
print()
# Verify F1.a-3 cross-check: digit_0 LSB structure for primorial m.
print('--- F1.a-5 LSB structure for primorial m ---')
print(f'{\"m\":>4} {\"phi(m)\":>7} {\"H_p(J=0)\":>10} {\"log2_phi(m)\":>12} {\"H_l(J=0)\":>10} {\"log2(m)\":>10}')
def phi(n):
    r = n
    p = 2
    while p*p <= n:
        if n % p == 0:
            while n % p == 0: n //= p
            r -= r // p
        p += 1
    if n > 1: r -= r // n
    return r
for r in R['modulus_results']:
    m = r['m']
    H_p_0 = r['rows'][0]['H_p_bits']
    H_l_0 = r['rows'][0]['H_l_bits']
    print(f'{m:>4} {phi(m):>7} {H_p_0:>10.4f} {math.log2(phi(m)):>12.4f} {H_l_0:>10.4f} {math.log2(m):>10.4f}')
"

