"""Compute the empirical distribution of e = p_n - round(Li^{-1}(n)) at L=2e8."""
import math
import numpy as np
import sys
sys.path.insert(0, '.')
from bit_J_pn_cross_modulus import sieve_primes, li_inverse_vectorised

L = 200_000_000
print(f"Sieving L={L:,}...", flush=True)
primes = sieve_primes(L)
n_arr = np.arange(1, len(primes)+1, dtype=np.uint64)
li_pred = np.round(li_inverse_vectorised(n_arr)).astype(np.int64)
p_arr = primes.astype(np.int64)
e = p_arr - li_pred
print(f"Computed e at L={L:,} on N={len(primes):,} primes")
print(f"  e mean   = {e.mean():.2f}")
print(f"  e median = {np.median(e):.2f}")
print(f"  e std    = {e.std():.2f}")
print(f"  e min    = {int(e.min())}")
print(f"  e max    = {int(e.max())}")
print(f"  sqrt(last_p) = {math.sqrt(int(primes[-1])):.0f}")
print(f"  sqrt(median p) = {math.sqrt(int(np.median(p_arr))):.0f}")
print(f"  P(e > 0) = {float((e > 0).mean()):.4f}")
print(f"  P(e == 0) = {float((e == 0).mean()):.4f}")
# Now analyse: predicted shift mode for each m
print("\nShift_hist mode = mode(e mod m) at digit-0 of e")
print("Better predictor: shift mode at J* = round_to_nearest_int(mean(e/m**J*)) mod m")
for m, J in [(3, 8), (5, 5), (6, 5), (30, 2), (210, 1)]:
    mJ = m ** J
    e_norm_mean = float((e / mJ).mean())
    e_norm_median = float(np.median(e) / mJ)
    pred_mean = round(e_norm_mean) % m
    pred_median = round(e_norm_median) % m
    print(f"  m={m:3d} J*={J} m^J*={mJ:>10}  mean(e/m^J*)={e_norm_mean:7.3f} -> predicted_mode_mean={pred_mean}  median_form={pred_median}")
