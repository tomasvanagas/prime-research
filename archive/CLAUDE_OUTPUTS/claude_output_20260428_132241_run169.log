"""Independent reimplementation of the Fourier energy at squarefree q."""
import math
import numpy as np

def primes_up_to(N):
    sieve = np.ones(N+1, dtype=bool)
    sieve[:2] = False
    for i in range(2, int(N**0.5)+1):
        if sieve[i]:
            sieve[i*i::i] = False
    return np.nonzero(sieve)[0]

def factor(q):
    f = []
    n = q
    p = 2
    while p*p <= n:
        if n % p == 0:
            e = 0
            while n % p == 0:
                n //= p; e += 1
            f.append((p, e))
        p += 1
    if n > 1:
        f.append((n, 1))
    return f

def is_sqf(q):
    return q == 1 or all(e==1 for _, e in factor(q))

def euler_phi(q):
    if q == 1: return 1
    res = q
    for p, _ in factor(q):
        res = res // p * (p - 1)
    return res

def E_via_residues(primes, q, N):
    """Independent: count primes by residue class, take squared deviation from uniform.
    Same as Fourier energy on coprime classes.
    E(q,N) = sum_{a coprime q} (#primes ≡ a mod q - mean)² / N
    where mean = (#primes coprime to q) / phi(q)
    """
    # bucket primes by residue mod q
    res = primes % q
    counts = np.bincount(res, minlength=q)
    # only sum over residues coprime to q
    coprime_res = [a for a in range(q) if math.gcd(a, q) == 1]
    coprime_counts = np.array([counts[a] for a in coprime_res], dtype=float)
    mean = coprime_counts.mean()
    # E(q,N) via Fourier = (1/N) sum_{k coprime q, k!=0} |c_k|^2
    # Equivalent: sum_a (count_a - count-not-divisible/phi)^2 * phi(q)/N
    # Actually, the orthogonality:
    # (1/N) sum_{k=1}^{q-1, gcd(k,q)=1} |sum_p exp(2pi i k p / q)|^2
    # Equivalent identity (Plancherel on coprime characters):
    # sum_{a coprime q} (count_a - mean)^2 * phi(q) / N
    # But let me just compute Fourier directly.
    energy = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1: continue
        ang = 2 * np.pi * k * primes / q
        c = float(np.sum(np.cos(ang)))
        s = float(np.sum(np.sin(ang)))
        energy += (c*c + s*s) / N
    return energy

# Verify d=14
d = 14
N = 2**d
primes = primes_up_to(N)
pi_N = len(primes)
print(f"d={d}, N={N}, pi(N)={pi_N}")
Q_star = max(2, int(round(N**0.21)))
print(f"Q*=N^0.21 rounded = {Q_star}")

cum = 0.0
for q in range(2, Q_star + 1):
    if is_sqf(q):
        E = E_via_residues(primes, q, N)
        cum += E
        print(f"  q={q} sqf E={E:.4f} cum={cum:.4f}")

print(f"\ncum(Q*={Q_star}) = {cum:.4f}")
print(f"0.21 * pi(N) = {0.21 * pi_N:.4f}")
print(f"ratio = {cum / (0.21*pi_N):.4f}")
print(f"\nClaim from session 169: cum(Q*=8) emp = 530.67, 0.21*pi=399.00, ratio=1.3300")
