import math
import numpy as np

def primes_up_to(N):
    sieve = np.ones(N+1, dtype=bool)
    sieve[:2] = False
    for i in range(2, int(N**0.5)+1):
        if sieve[i]:
            sieve[i*i::i] = False
    return np.nonzero(sieve)[0]

def factor(q):
    f = []
    n = q; p = 2
    while p*p <= n:
        if n % p == 0:
            e = 0
            while n % p == 0:
                n //= p; e += 1
            f.append((p, e))
        p += 1
    if n > 1: f.append((n, 1))
    return f

def is_sqf(q):
    return q == 1 or all(e==1 for _, e in factor(q))

def E_q(primes, q, N):
    energy = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1: continue
        ang = 2 * np.pi * k * primes / q
        c = float(np.sum(np.cos(ang)))
        s = float(np.sum(np.sin(ang)))
        energy += (c*c + s*s) / N
    return energy

# Verify d=18
for d in [18, 20]:
    N = 2**d
    primes = primes_up_to(N)
    pi_N = len(primes)
    Q_star = max(2, int(round(N**0.21)))
    cum = 0.0
    for q in range(2, Q_star + 1):
        if is_sqf(q):
            cum += E_q(primes, q, N)
    print(f"d={d}, N={N}, pi(N)={pi_N}, Q*={Q_star}, cum(Q*)={cum:.4f}, ratio_to_0.21pi={cum/(0.21*pi_N):.4f}")
