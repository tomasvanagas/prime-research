import numpy as np

def primes_up_to(N):
    sieve = np.ones(N+1, dtype=bool)
    sieve[:2] = False
    for i in range(2, int(N**0.5)+1):
        if sieve[i]: sieve[i*i::i] = False
    return np.nonzero(sieve)[0]

def factor(q):
    f = []; n = q; p = 2
    while p*p <= n:
        if n % p == 0:
            e = 0
            while n % p == 0: n //= p; e += 1
            f.append((p, e))
        p += 1
    if n > 1: f.append((n, 1))
    return f

def is_sqf(q):
    return q == 1 or all(e==1 for _, e in factor(q))

def E_q(primes, q, N):
    energy = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1: continue
        ang = 2 * np.pi * k * primes / q
        c = float(np.sum(np.cos(ang)))
        s = float(np.sum(np.sin(ang)))
        energy += (c*c + s*s) / N
    return energy

# d=20 canonical table
d = 20; N = 2**d
primes = primes_up_to(N)
pi_N = len(primes)
