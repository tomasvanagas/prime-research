import math, time
import numpy as np

def primes_up_to(N):
    sieve = np.ones(N+1, dtype=bool)
    sieve[:2] = False
    for i in range(2, int(N**0.5)+1):
        if sieve[i]:
            sieve[i*i::i] = False
    return np.nonzero(sieve)[0]

def factor(q):
    f = []; n = q; p = 2
    while p*p <= n:
        if n % p == 0:
            e = 0
            while n % p == 0: n //= p; e += 1
            f.append((p, e))
        p += 1
    if n > 1: f.append((n, 1))
    return f

def is_sqf(q):
    return q == 1 or all(e==1 for _, e in factor(q))

def E_q(primes, q, N):
    energy = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1: continue
        ang = 2 * np.pi * k * primes / q
        c = float(np.sum(np.cos(ang)))
        s = float(np.sum(np.sin(ang)))
        energy += (c*c + s*s) / N
    return energy

t0 = time.time()
d = 22; N = 2**d
primes = primes_up_to(N)
pi_N = len(primes)
print(f"d={d} N={N} pi(N)={pi_N}, sieve done in {time.time()-t0:.1f}s")

Q_star = max(2, int(round(N**0.21)))
print(f"Q*=N^0.21 rounded = {Q_star}")
cum = 0.0
for q in range(2, Q_star+1):
    if is_sqf(q):
        cum += E_q(primes, q, N)
print(f"cum(Q*={Q_star}) = {cum:.4f}, 0.21*pi = {0.21*pi_N:.4f}, ratio = {cum/(0.21*pi_N):.4f}")
print(f"Synthesis claim: cum=72844.00, ratio=1.1721")
print(f"Time: {time.time()-t0:.1f}s")
