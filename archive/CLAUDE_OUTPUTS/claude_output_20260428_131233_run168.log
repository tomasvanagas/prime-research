import math
import numpy as np

def primes_up_to(N):
    is_p = np.ones(N+1, dtype=bool); is_p[:2] = False
    for i in range(2, int(N**0.5)+1):
        if is_p[i]: is_p[i*i::i] = False
    return np.nonzero(is_p)[0]

def factor(q):
    f = []; n = q; p = 2
    while p*p <= n:
        if n % p == 0:
            e = 0
            while n % p == 0:
                n //= p; e += 1
            f.append((p, e))
        p += 1
    if n > 1: f.append((n, 1))
    return f

def is_sqf(q): return q == 1 or all(e == 1 for _, e in factor(q))
def phi(q):
    if q == 1: return 1
    res = q
    for p, _ in factor(q): res = res // p * (p - 1)
    return res

# Independent re-implementation: E(q, N) via direct character sum
# E(q, N) = (1/N) * sum_{k coprime to q, 1<=k<q} |S_k|^2
# where S_k = sum_{p prime <= N} exp(2*pi*i*k*p / q)

N = 16384
primes = primes_up_to(N)
pi_N = len(primes)
target = 0.21 * pi_N
print(f'd=14 N={N} pi(N)={pi_N} target=0.21*pi={target}')

# Independent: use complex exp, not separated cos+sin
cum = 0.0
for q in range(2, 9):  # Q*=8 inclusive
    if not is_sqf(q): continue
    # Direct sum
    E = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1: continue
        # Compute S_k via complex
        z = np.exp(2j * np.pi * k * primes / q)
        S = z.sum()
        E += abs(S)**2 / N
    cum += E
    print(f'  q={q} sqf phi={phi(q)} E(q,N)={E:.6f} cum={cum:.4f}')
print(f'cum_at_Qstar=8 = {cum:.4f}')
print(f'ratio cum / (0.21*pi(N)) = {cum/target:.4f}')
"

