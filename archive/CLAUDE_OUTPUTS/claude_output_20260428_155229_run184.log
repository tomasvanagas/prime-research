import numpy as np

# Character-cliff fractions at τ=0.02 (run rule)
data = {
    14: {'k_canon': 5, 'frac_canon': 0.2236, 'k_char': 7, 'frac_char': 0.2698},
    18: {'k_canon': 15, 'frac_canon': 0.2212, 'k_char': 12, 'frac_char': 0.1994},
    20: {'k_canon': 26, 'frac_canon': 0.2198, 'k_char': 20, 'frac_char': 0.1971},
}
# Also τ=0.05
data2 = {
    14: {'frac_char': 0.2698},
    18: {'frac_char': 0.1917},
    20: {'frac_char': 0.1715},
}
# Also τ=0.01 (more permissive)
data01 = {
    14: 0.3508,
    18: 0.1994,
    20: 0.2011,
}

ds = np.array([14, 18, 20], dtype=float)
inv_d = 1.0 / ds

print('=== Linear-in-1/d extrapolation (a + b/d) ===')
for tag, fracs in [
    ('canonical R0', [data[d]['frac_canon'] for d in [14,18,20]]),
    ('char-run τ=0.02', [data[d]['frac_char'] for d in [14,18,20]]),
    ('char-run τ=0.05', [data2[d]['frac_char'] for d in [14,18,20]]),
    ('char-run τ=0.01', [data01[d] for d in [14,18,20]]),
]:
    fracs = np.array(fracs)
    A = np.column_stack([np.ones_like(inv_d), inv_d])
    a, b = np.linalg.lstsq(A, fracs, rcond=None)[0]
    res = fracs - (a + b*inv_d)
    print(f'  {tag:25s}: a={a:.4f}, b={b:.3f}, res={[f\"{r:+.4f}\" for r in res]}, asymptote={a:.4f}')

print()
print('=== Excluding d=14 (char cliff might be \"undercounted-by-finite-d\" at d=14) ===')
ds2 = np.array([18, 20], dtype=float)
inv_d2 = 1.0 / ds2
for tag, fracs in [
    ('canonical R0 d≥18', [0.2212, 0.2198]),
    ('char-run τ=0.02 d≥18', [0.1994, 0.1971]),
    ('char-run τ=0.05 d≥18', [0.1917, 0.1715]),
]:
    fracs = np.array(fracs)
    A = np.column_stack([np.ones_like(inv_d2), inv_d2])
    a, b = np.linalg.lstsq(A, fracs, rcond=None)[0]
    print(f'  {tag:30s}: 2-pt extrap a={a:.4f}, b={b:.3f}')

print()
print('=== Difference canonical vs character-cliff ===')
for d in [14, 18, 20]:
    diff = data[d]['frac_canon'] - data[d]['frac_char']
    print(f'  d={d}: canon-char_τ0.02 = {diff:+.4f}, k_canon-k_char = {data[d][\"k_canon\"]-data[d][\"k_char\"]:+d}')
