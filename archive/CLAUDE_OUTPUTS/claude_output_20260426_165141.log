Let me sanity-check the free cumulant computation against MP theory directly.
  [Bash] python3 -c "
import numpy as np

# Test on iid centered Gaussian m x n with m > n
np.random.seed(42)
m, n = 4000, 1000  # c = n/m = 0.25
X = np.random.randn(m, n)

# Eigenvalues of (1/m) X^T X
sv2 = np.linalg.svd(X, compute_uv=False) ** 2 / m

# These should follow MP(c = n/m = 0.25) with mean c = 0.25
print(f'shape: {X.shape}, c=n/m={n/m}')
print(f'mean(sv2) = {sv2.mean():.4f} (expected ~ {n/m})')
print(f'sv2 in [{sv2.min():.4f}, {sv2.max():.4f}]')
print(f'  expected support [{(1-np.sqrt(n/m))**2:.4f}, {(1+np.sqrt(n/m))**2:.4f}]')

# Standardize to mean 1 and compute free cumulants
mean = sv2.mean()
y = sv2 / mean
moments = [np.mean(y**k) for k in range(1, 5)]
m1, m2, m3, m4 = moments
k1 = m1; k2 = m2 - m1**2; k3 = m3 - 3*m1*m2 + 2*m1**3; k4 = m4 - 4*m1*m3 - 2*m2**2 + 10*m1**2*m2 - 5*m1**4
print(f'moments after std: {moments}')
print(f'free cumulants:    ({k1:.3f}, {k2:.3f}, {k3:.3f}, {k4:.3f})')
print(f'predicted (c=1/c-1)^? : c^{{1-r}} = ({1, 1/0.25, 1/0.0625, 1/0.015625})')
print(f'predicted (c^{{r-1}}): ({1, 0.25, 0.0625, 0.015625})')
"

