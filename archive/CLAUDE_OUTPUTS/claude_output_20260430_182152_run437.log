import math

# Thread-7-shape: sigma_pred(x, K) = sqrt(x) * log K / (pi * sqrt(2K) * log x)
# Worst-case-of-N draws from Gaussian with std sigma: typical max ~ sigma * sqrt(2 ln N)
# K_emp where worst-case ≈ epsilon = 1

def sigma_pred(x, K):
    return math.sqrt(x) * math.log(K) / (math.pi * math.sqrt(2*K) * math.log(x))

def find_K_emp(x, N=30, eps=1.0, factor=1.0):
    # binary search for K such that factor * sigma_pred(x, K) * sqrt(2 ln N) = eps
    f = math.sqrt(2*math.log(N))
    target = eps / (f * factor)  # sigma_pred we need
    lo, hi = 100, 10**8
    for _ in range(60):
        mid = (lo + hi) // 2
        if sigma_pred(x, mid) > target:
            lo = mid
        else:
            hi = mid
    return mid

# GUE-corrected: empirical sigma_eff/sigma_pred ratio drifts 0.72 → 0.79 → 0.88 → 1.0 across log10 x = 4 → 5.5

print('Thread-7-shape K_emp predictions (no GUE correction, factor=1.0):')
for lx in [4.0, 4.5, 5.0, 5.3, 5.5, 5.7, 6.0]:
    x = 10**lx
    K = find_K_emp(x, N=30, eps=1.0, factor=1.0)
    c = K / (math.sqrt(x) * math.log(x)**2)
    print(f'log10 x={lx}: K_emp_T7={K:>8d}, c_emp_T7={c:.4f}')

print()
print('With GUE correction (factor=0.755 — Thread 7 mean):')
for lx in [4.0, 4.5, 5.0, 5.3, 5.5, 5.7, 6.0]:
    x = 10**lx
    K = find_K_emp(x, N=30, eps=1.0, factor=0.755)
    c = K / (math.sqrt(x) * math.log(x)**2)
    print(f'log10 x={lx}: K_emp_T7={K:>8d}, c_emp_T7={c:.4f}')
"

