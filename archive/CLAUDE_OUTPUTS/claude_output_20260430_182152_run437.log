import csv
import math
from collections import defaultdict
import numpy as np

buckets = defaultdict(list)
with open('experiments/analytic/galway_constant/slot2_extended_traces.csv') as f:
    rdr = csv.DictReader(f)
    for row in rdr:
        lx = row['log10_x_anchor']
        K = int(row['K'])
        e = float(row['abs_err'])
        buckets[(lx, K)].append(e)

# Fit RMS to err ~ a/K^p over the K=2000..20000 window
print('Anchor   |   RMS-fit a, p (over K=2000..20000)   |   sigma_pred at K=K_max')
for lx in ['5.0', '5.3', '5.5']:
    Ks = []
    rms = []
    for (lxx, K), es in sorted(buckets.items()):
        if lxx != lx: continue
        if K < 2000 or K > 20000: continue
        Ks.append(K)
        rms.append(math.sqrt(sum(e*e for e in es)/len(es)))
    Ks = np.array(Ks); rms = np.array(rms)
    x = np.log(Ks); y = np.log(rms)
    coef = np.polyfit(x, y, 1)
    p = -coef[0]; a = math.exp(coef[1])
    x_anchor = 10 ** float(lx)
    # Thread-7 sigma_pred = sqrt(x) * log(K) / (pi sqrt(2K) log x)
    sigma_pred_K20k = math.sqrt(x_anchor) * math.log(20000) / (math.pi * math.sqrt(2*20000) * math.log(x_anchor))
    sigma_eff_K20k = rms[-1]
    print(f'log10 x={lx}: RMS ~ {a:.3f}/K^{p:.3f},  sigma_pred(K=20k)={sigma_pred_K20k:.3f},  sigma_eff(K=20k)={sigma_eff_K20k:.3f},  ratio {sigma_eff_K20k/sigma_pred_K20k:.3f}')
"

