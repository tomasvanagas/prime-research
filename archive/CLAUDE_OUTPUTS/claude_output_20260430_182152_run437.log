  [Bash] python3 -c "
import csv
import math
from collections import defaultdict

# Group worst-case |err| at each (log10_x, K) — pick max over samples
buckets = defaultdict(list)
with open('experiments/analytic/galway_constant/slot2_extended_traces.csv') as f:
    rdr = csv.DictReader(f)
    for row in rdr:
        lx = row['log10_x_anchor']
        K = int(row['K'])
        e = float(row['abs_err'])
        buckets[(lx, K)].append(e)

# For each anchor, fit err_worst vs K under err ~ a/K^p
import numpy as np
for lx in ['5.0', '5.3', '5.5']:
    Ks = []
    errs = []
    for (lxx, K), es in sorted(buckets.items()):
        if lxx != lx: continue
        if K < 1000: continue  # ignore the very-low-K transient
        if K > 20000: continue
        Ks.append(K)
        errs.append(max(es))
    Ks = np.array(Ks); errs = np.array(errs)
    # Fit log(err) = log(a) - p * log(K)
    if len(Ks) >= 3:
        x = np.log(Ks); y = np.log(errs)
        coef = np.polyfit(x, y, 1)
        p = -coef[0]; a = math.exp(coef[1])
        # Predicted K_emp where err drops to 1.0 under fitted shape
        K_emp_fit = (a) ** (1/p)
        x_anchor = 10 ** float(lx)
        c_emp_fit = K_emp_fit / (math.sqrt(x_anchor) * math.log(x_anchor) ** 2)
