import math
import numpy as np

# Independent reimplementation of E(q, N) = (1/N) sum_{k coprime to q} |sum_{p prime <= N} omega_q^{k p}|^2
# Cross-check at d=20 by direct computation
def primes_up_to(N):
    sieve = np.ones(N+1, dtype=bool)
    sieve[:2] = False
    for i in range(2, int(N**0.5)+1):
        if sieve[i]:
            sieve[i*i::i] = False
    return np.nonzero(sieve)[0]

def is_squarefree(q):
    n = q
    p = 2
    while p*p <= n:
        if n % (p*p) == 0:
            return False
        if n % p == 0:
            n //= p
        else:
            p += 1
    return True

def E(p_arr, q, N):
    # Sum over k coprime to q
    e = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1:
            continue
        ang = 2*math.pi*k*p_arr / q
        c = float(np.sum(np.cos(ang)))
        s = float(np.sum(np.sin(ang)))
        e += (c*c + s*s) / N
    return e

# d=20 spot check
N = 2**20
primes = primes_up_to(N)
piN = len(primes)
print(f'N={N}, piN={piN}')

# Cumulate over squarefree q in [2, 18] (Q_star at d=20 = round(N^0.21))
Qstar = round(N**0.21)
print(f'Qstar={Qstar}')
cum = 0.0
for q in range(2, Qstar+1):
    if is_squarefree(q):
        e = E(primes, q, N)
        cum += e
        print(f'  q={q}, E(q,N)={e:.4f}, cum={cum:.4f}')
print(f'cum(Q*) = {cum:.4f}')
print(f'0.21 * piN = {0.21*piN:.4f}')
print(f'ratio = {cum/(0.21*piN):.4f}')

# spike block at d=20 from S82 saved data: 18027.69
# leakage: spike/cum = 18027.69 / cum
print(f'spike block / cum(Q*) = {18027.69/cum:.4f}')
"

