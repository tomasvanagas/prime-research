import numpy as np
import math

def primes_up_to(N):
    sieve = np.ones(N+1, dtype=bool)
    sieve[:2] = False
    for i in range(2, int(N**0.5)+1):
        if sieve[i]:
            sieve[i*i::i] = False
    return np.nonzero(sieve)[0]

def is_squarefree(q):
    n = q
    p = 2
    while p*p <= n:
        if n % (p*p) == 0:
            return False
        if n % p == 0:
            n //= p
        else:
            p += 1
    return True

def E(p_arr, q, N):
    e = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1:
            continue
        ang = 2*math.pi*k*p_arr / q
        c = float(np.sum(np.cos(ang)))
        s = float(np.sum(np.sin(ang)))
        e += (c*c + s*s) / N
    return e

# d=16: compute Q_eff for several k_star choices
N = 2**16
primes = primes_up_to(N)
piN = len(primes)

# Spike block from fresh SVD at d=16
chi = np.zeros(N, dtype=np.float64); chi[primes] = 1.0
M = chi.reshape(256, 256)
_, S, _ = np.linalg.svd(M, full_matrices=False)

cum = 0.0
cum_traj = [(0, 0.0)]
for q in range(2, 60):
    if is_squarefree(q):
        cum += E(primes, q, N)
        cum_traj.append((q, cum))

print(f'd=16, N={N}, piN={piN}')
print(f'cum at q=10 (S168 Q*): {[c for q,c in cum_traj if q==10]}')
print()
print('k_star | spike_block | block/piN | Q_eff | log Q_eff / log N')
for k_star in [5, 7, 8, 10, 12, 15]:
    spike = sum(s*s for s in S[1:1+k_star])
    Q_eff = None
    for q, c in cum_traj:
        if c >= spike:
            Q_eff = q
            break
    exp = math.log(Q_eff)/math.log(N) if Q_eff else float('nan')
    print(f' {k_star:5d} | {spike:10.2f} | {spike/piN:.4f} | {Q_eff:5d} | {exp:.4f}')
"

