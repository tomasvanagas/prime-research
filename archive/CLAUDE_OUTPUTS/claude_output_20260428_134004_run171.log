import math
import numpy as np
import json

def primes_up_to(N):
    sieve = np.ones(N+1, dtype=bool)
    sieve[:2] = False
    for i in range(2, int(N**0.5)+1):
        if sieve[i]:
            sieve[i*i::i] = False
    return np.nonzero(sieve)[0]

def is_squarefree(q):
    n = q
    p = 2
    while p*p <= n:
        if n % (p*p) == 0:
            return False
        if n % p == 0:
            n //= p
        else:
            p += 1
    return True

def E(p_arr, q, N):
    e = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1:
            continue
        ang = 2*math.pi*k*p_arr / q
        c = float(np.sum(np.cos(ang)))
        s = float(np.sum(np.sin(ang)))
        e += (c*c + s*s) / N
    return e

# Investigate Q_eff sensitivity to k_star choice
# Build cum trajectory
print('=== Q_eff sensitivity ===')
for d in [14, 18, 20]:
    spike_data = json.load(open(f'experiments/constructions/spike_eigenvectors_chi_p/spike_d{d}_results.json'))[0]
    sigmas = [s['sigma'] for s in spike_data['chi_p_spikes']]
    
    N = 2**d
    primes = primes_up_to(N)
    
    # Build cum trajectory
    cum_traj = [(0, 0.0)]
    cum = 0.0
    for q in range(2, 80):
        if is_squarefree(q):
            cum += E(primes, q, N)
            cum_traj.append((q, cum))
    
    # For each k_star choice, find Q_eff
    print(f'\\nd={d}, N={N}')
    print('  k_star | spike_block | Q_eff | log Q_eff / log N')
    for k_star_test in [3, 5, 10, 15, 20, 25, 26, 30, 40, 50]:
        if k_star_test >= len(sigmas):
            continue
        spike_block = sum(s*s for s in sigmas[1:1+k_star_test])
        Q_eff = None
        for q, c in cum_traj:
