import numpy as np
import math

def primes_up_to(N):
    sieve = np.ones(N+1, dtype=bool)
    sieve[:2] = False
    for i in range(2, int(N**0.5)+1):
        if sieve[i]:
            sieve[i*i::i] = False
    return np.nonzero(sieve)[0]

def is_squarefree(q):
    n = q
    p = 2
    while p*p <= n:
        if n % (p*p) == 0:
            return False
        if n % p == 0:
            n //= p
        else:
            p += 1
    return True

def E(p_arr, q, N):
    e = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1:
            continue
        ang = 2*math.pi*k*p_arr / q
        c = float(np.sum(np.cos(ang)))
        s = float(np.sum(np.sin(ang)))
        e += (c*c + s*s) / N
    return e

# At d=16, what is the cum trajectory?
