import math
import numpy as np
import json

def primes_up_to(N):
    sieve = np.ones(N+1, dtype=bool)
    sieve[:2] = False
    for i in range(2, int(N**0.5)+1):
        if sieve[i]:
            sieve[i*i::i] = False
    return np.nonzero(sieve)[0]

def is_squarefree(q):
    n = q
    p = 2
    while p*p <= n:
        if n % (p*p) == 0:
            return False
        if n % p == 0:
            n //= p
        else:
            p += 1
    return True

def E(p_arr, q, N):
    e = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1:
            continue
        ang = 2*math.pi*k*p_arr / q
        c = float(np.sum(np.cos(ang)))
        s = float(np.sum(np.sin(ang)))
        e += (c*c + s*s) / N
    return e

# For each d, find Q_eff = first q where cum >= spike block
for d in [14, 18, 20]:
    spike = json.load(open(f'experiments/constructions/spike_eigenvectors_chi_p/spike_d{d}_results.json'))[0]
    sigmas = [s['sigma'] for s in spike['chi_p_spikes']]
    k_star = spike['k_star_assumed']
    spike_block = sum(s*s for s in sigmas[1:1+k_star])
    
    N = 2**d
    primes = primes_up_to(N)
    cum = 0.0
    Q_eff = None
    for q in range(2, 60):
        if is_squarefree(q):
            cum += E(primes, q, N)
            if cum >= spike_block and Q_eff is None:
                Q_eff = q
                break
    exp = math.log(Q_eff)/math.log(N)
    print(f'd={d}, k_star={k_star}, spike_block={spike_block:.2f}, Q_eff={Q_eff}, log Q_eff / log N = {exp:.4f}')
"

