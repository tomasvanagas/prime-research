Now I have the scaling. Let me check the structural identity of the λ_1 eigenvector that consistently overlaps with primes.
  [Bash] python3 -c "
import numpy as np
from scipy.linalg import eigh
import sys; sys.path.insert(0, '.')
from ctqw_chi_p import divisor_graph, prime_indicator
from sympy import primerange, isprime

x = 128
A = divisor_graph(x)
lam, U = eigh(A)
v_p = prime_indicator(x)
overlaps = np.abs(U.T @ v_p)
top = np.argsort(overlaps)[::-1][:3]

for k in top:
    print(f'\nEigenvalue λ_{k} = {lam[k]:+.4f}, overlap with v_p = {overlaps[k]:.4f}')
    vec = U[:, k]
    # absolute amplitude on primes vs composites
    primes = [p for p in primerange(2, x+1)]
    comps = [n for n in range(2, x+1) if not isprime(n)]
    pa = np.abs(vec[[p-1 for p in primes]]).mean()
    ca = np.abs(vec[[c-1 for c in comps]]).mean()
    print(f'  mean |amp| on primes: {pa:.5f}')
    print(f'  mean |amp| on composites: {ca:.5f}')
    print(f'  ratio prime/composite mean amp: {pa/ca:.3f}')
    # Top entries
    abs_vec = np.abs(vec)
    top_vert = np.argsort(abs_vec)[::-1][:8]
    for v in top_vert:
        nver = v + 1  # 1-indexed
        flag = 'P' if isprime(nver) else (' ' if nver != 1 else '1')
        print(f'   vertex {nver:>3d} ({flag}): vec entry {vec[v]:+.5f}')
"

