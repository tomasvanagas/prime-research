import numpy as np
import math

def sieve(N):
    s = np.ones(N+1, dtype=bool)
    s[:2] = False
    for i in range(2, int(N**0.5)+1):
        if s[i]: s[i*i::i] = False
    return s

# d=14 control test (smaller to be fast)
d = 14
N = 2**d
W = 2  # MPS bond dim factor
# matrix shape per the saved JSON: ?
# spike_d14_results.json shape from shape field
import json
data = json.loads(open('experiments/constructions/spike_eigenvectors_chi_p/spike_d14_results.json').read())[0]
print('d=14: shape=', data['shape'], 'k_star=', data['k_star_assumed'])
sigmas_chi = [s['sigma'] for s in data['chi_p_spikes']]
# spike block
spike_block_chi = sum(sigmas_chi[k]**2 for k in range(1, data['k_star_assumed']+1))
print('chi_P spike block (k=1..k_star):', spike_block_chi)

# What's the shape? 1024x1024 doesn't apply; let me check
# d=14 N=2^14=16384, sqrt=128, so likely 128x128
R, C = data['shape']
print(f'R={R}, C={C}, R*C={R*C}, N={N}')

# Now control: use chi_P then random Bernoulli of same density
chi = sieve(N).astype(float)
M = chi[:R*C].reshape(R, C)
# Verify chi_P SVD reproduces saved sigmas
U, S, Vt = np.linalg.svd(M, full_matrices=False)
print('chi_P top sigmas (computed):', list(S[:6]))
print('chi_P top sigmas (saved):   ', sigmas_chi[:6])
print('chi_P sigma_0^2 =', S[0]**2, 'pi(N)^2/N=', sum(chi)**2/N)
# Spike block via SVD
piN = int(sum(chi))
print('pi(N) =', piN)
spike_block_chi_recomputed = sum(S[k]**2 for k in range(1, data['k_star_assumed']+1))
print('chi_P spike block (recomputed):', spike_block_chi_recomputed)
print('chi_P spike block / pi(N) =', spike_block_chi_recomputed / piN)

# CONTROL: random binary with same density, averaged over seeds
np.random.seed(42)
trials = 5
ratios = []
for trial in range(trials):
    perm = np.random.permutation(N)
    chi_shuffled = chi[perm]
    M_ctrl = chi_shuffled[:R*C].reshape(R, C)
    U2, S2, V2t = np.linalg.svd(M_ctrl, full_matrices=False)
    spike_ctrl = sum(S2[k]**2 for k in range(1, data['k_star_assumed']+1))
    ratios.append(spike_ctrl / piN)
print('CONTROL (chi_P shuffled): k_star=26, spike block / pi(N):')
print('  trials:', [f'{r:.4f}' for r in ratios])
print('  mean:', np.mean(ratios), 'std:', np.std(ratios))
