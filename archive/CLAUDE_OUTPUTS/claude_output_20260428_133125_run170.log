print('N =', data['N'], 'd =', data['d'], 'k_star_assumed =', data['k_star_assumed'])
print('total spikes recorded =', len(sigmas))
print('sigma_0 =', sigmas[0], 'sigma_0^2 =', sigmas[0]**2)
print('First 30 sigmas (k, sigma, sigma^2):')
for k, s in zip(ks[:35], sigmas[:35]):
    print(f'  k={k}, sigma={s:.4f}, sigma^2={s*s:.4f}')
print('---')
import math
N = data['N']
# pi(N) for N=2^20
def pi_count(N):
    s = [True]*(N+1); s[0]=s[1]=False
    for i in range(2, int(N**0.5)+1):
        if s[i]: s[i*i::i]=[False]*len(s[i*i::i])
    return sum(s)
piN = pi_count(N)
print('pi(N) =', piN)
print('rank-1 mean sigma^2 = piN^2/N =', piN*piN/N, '  (should match sigma_0^2)')
# Spike block sum (k=1..k_star=26) i.e. sigma indices 1..26
spike_block = sum(sigmas[k]**2 for k in range(1, 27))
print('spike_block_sum (k=1..26) =', spike_block, ' / pi(N) =', spike_block/piN)
