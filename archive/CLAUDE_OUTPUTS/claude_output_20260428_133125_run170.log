import numpy as np
import math, json

def sieve(N):
    s = np.ones(N+1, dtype=bool); s[:2] = False
    for i in range(2, int(N**0.5)+1):
        if s[i]: s[i*i::i] = False
    return s

# All three scales: d=14, 18, 20
print('=== Adversarial control: shuffled chi_P vs true chi_P ===')
print('d | shape | k_star | chi_P block/pi | shuffled (mean of 5 seeds)')
for d, k_star in [(14, 5), (18, 15), (20, 26)]:
    N = 2**d
    chi = sieve(N).astype(float)
    R = C = 2**(d//2)
    if R*C != N:
        # for odd d, e.g. d=15 R=2^8 C=2^7
        R = 2**((d+1)//2); C = 2**(d//2)
    M = chi[:R*C].reshape(R, C)
    U, S, Vt = np.linalg.svd(M, full_matrices=False)
    piN = int(sum(chi))
    chi_block = sum(S[k]**2 for k in range(1, k_star+1))
    chi_ratio = chi_block/piN
    
    np.random.seed(42)
    ratios = []
    for _ in range(5):
        chi_shuf = chi[np.random.permutation(N)]
        Mc = chi_shuf[:R*C].reshape(R, C)
        Sc = np.linalg.svd(Mc, compute_uv=False)
        ratios.append(sum(Sc[k]**2 for k in range(1, k_star+1)) / piN)
    print(f'{d:2d} | {R}x{C} | {k_star:2d} | {chi_ratio:.4f} | {np.mean(ratios):.4f} +/- {np.std(ratios):.4f}')
"

