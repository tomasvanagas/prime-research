import json, math

# Test: is the 0.21 fraction stable to baseline-subtraction?
# d=18, 20 have baseline_spikes data
for d in [18, 20]:
    with open(f'/apps/aplikacijos/prime-research/experiments/constructions/spike_eigenvectors_chi_p/spike_d{d}_results.json') as f:
        data = json.load(f)
    rec = data[0]
    N = rec['N']
    k_star = rec['k_star_assumed']
    sig_chi = rec['S_chi_top60']
    sig_base = rec['S_baseline_top60']
    print(f"d={d} N={N} k_star={k_star}")
    # Compare top sigmas
    print(f"  σ²_chi  top10: {[f'{s**2:.1f}' for s in sig_chi[1:11]]}")
    print(f"  σ²_base top10: {[f'{s**2:.1f}' for s in sig_base[1:11]]}")
    # Baseline-subtracted "excess" spike block
    # Subtract σ²_base[k] from σ²_chi[k] for matched k=1..k_star
    excess = sum(sig_chi[k]**2 - sig_base[k]**2 for k in range(1, k_star+1))
    full_chi = sum(sig_chi[k]**2 for k in range(1, k_star+1))
    full_base = sum(sig_base[k]**2 for k in range(1, k_star+1))
    from sympy import primepi
    pi_N = int(primepi(N))
    print(f"  full_chi={full_chi:.1f}  full_base={full_base:.1f}  excess={excess:.1f}")
    print(f"  excess/π(N)={excess/pi_N:.4f}  full_chi/π(N)={full_chi/pi_N:.4f}")
    # Also: at what k does σ_chi ≈ σ_base (i.e., character signal ends)?
    last_signif = 0
    for k in range(1, len(sig_chi)):
        if sig_chi[k] > 1.05 * sig_base[k]:  # 5% above baseline
            last_signif = k
    print(f"  last_k_with_chi>1.05*base: {last_signif} (vs k_star_assumed={k_star})")
    print()
