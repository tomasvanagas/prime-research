import json, math

for d in [14, 18, 20]:
    with open(f'/apps/aplikacijos/prime-research/experiments/constructions/spike_eigenvectors_chi_p/spike_d{d}_results.json') as f:
        data = json.load(f)
    rec = data[0]
    W = rec['W']
    N = rec['N']
    k_star = rec['k_star_assumed']
    sigmas = rec['S_chi_top60']
    print(f"d={d} W={W} N={N} k_star={k_star} top60_len={len(sigmas)}")
    # Compute spike block (top k_star, exclude rank-1)
    # Convention from prior verifies: block_sum = sum of σ²_k for k=2..k_star+1 (drop first as mean)
    # But S187 says k=1..k_star — let me follow S187: block_sum = sum_{k=1..k_star} sigma_k^2
    # Actually S82 starts at k=1 but k=0 (the largest) is the rank-1 mean spike.
    # Look at sigma_0 — it should be huge (~ pi(N))
    print(f"  sigma_0={sigmas[0]:.4f}  sigma_1={sigmas[1]:.4f}  sigma_{k_star}={sigmas[k_star]:.4f} sigma_{k_star+1}={sigmas[k_star+1]:.4f}")
    # block_sum: σ_k² for k=1..k_star (excluding rank-1 mean spike at k=0)
    block_sum = sum(sigmas[k]**2 for k in range(1, k_star+1))
    # also: σ_k² for k=0 .. k_star (including mean)
    block_sum_with_mean = sum(sigmas[k]**2 for k in range(0, k_star+1))
    # Also σ_k for k=1..k_star (NOT squared) — to check if S187 swapped sigma vs sigma^2
    block_sum_no_sq = sum(sigmas[k] for k in range(1, k_star+1))
    print(f"  block_sum_sigsq (k=1..k_star)={block_sum:.2f}")
    print(f"  block_sum_sigsq (k=0..k_star)={block_sum_with_mean:.2f}")
    print(f"  block_sum_sigma  (k=1..k_star)={block_sum_no_sq:.2f}")
    # pi(N)
    from sympy import primepi
    pi_N = int(primepi(N))
    print(f"  pi(N)={pi_N}  0.21*pi(N)={0.21*pi_N:.2f}")
    print(f"  ratio_sigsq / 0.21pi(N) = {block_sum/(0.21*pi_N):.4f}")
    print(f"  fraction_sigsq / pi(N)  = {block_sum/pi_N:.4f}")
    print()
