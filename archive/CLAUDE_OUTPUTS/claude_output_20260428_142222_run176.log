Let me also run my new adversarial probe before writing the verdict — drop non-squarefree-conductor spikes and check whether the 21% agreement persists.
  [Bash] python3 -c "
import json, math

def is_squarefree(q):
    if q == 1: return True
    n = q
    p = 2
    while p*p <= n:
        if n % p == 0:
            n //= p
            if n % p == 0:
                return False
        p += 1
    return True

# d=20 conductor table from S82 results doc:
# k=21,23,24,25 have cond=88 (=2^3*11) - NOT sqf
# k=22 has cond=42 (=2*3*7) - sqf
# k=1..20 have sqf conductors (6, 10, 14, 30) - all sqf
# So only k=21, 23, 24, 25 are non-sqf-conductor

for d, non_sqf_ks, k_star in [(20, {21, 23, 24, 25}, 26)]:
    data = json.load(open(f'experiments/constructions/spike_eigenvectors_chi_p/spike_d{d}_results.json'))[0]
    sigmas = [s['sigma'] for s in data['chi_p_spikes']]
    pi_N = {14:1900, 18:23000, 20:82025}[d]
    target = 0.21 * pi_N
    
    full_block = sum(s*s for s in sigmas[1:1+k_star])
    sqf_only_block = sum(sigmas[k]**2 for k in range(1, 1+k_star) if k not in non_sqf_ks)
    print(f'd={d}: full block (k=1..{k_star}) = {full_block:.2f}, ratio to 0.21*pi(N) = {full_block/target:.4f}')
    print(f'd={d}: sqf-only block (excluding k={sorted(non_sqf_ks)}) = {sqf_only_block:.2f}, ratio = {sqf_only_block/target:.4f}')
    # Also check: per-spike sigma values for the excluded ones
    print(f'  excluded sigmas: {[round(sigmas[k],3) for k in sorted(non_sqf_ks)]}')
    print(f'  removed energy: {sum(sigmas[k]**2 for k in non_sqf_ks):.2f}')
"

