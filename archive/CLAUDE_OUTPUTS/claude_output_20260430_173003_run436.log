import csv
import math
from collections import defaultdict

with open('slot2_extended_traces.csv') as f:
    rows = list(csv.DictReader(f))

# For each (log10x, K), compute mean(|err|), median(|err|), max(|err|), std
by_aK = defaultdict(list)
for r in rows:
    by_aK[(r['log10_x_anchor'], int(r['K']))].append(float(r['abs_err']))

print('Per-(anchor, K) stats: sigma_eff = sqrt(<err^2>) over 30 samples')
print(f'{\"log10x\":>8s} {\"K\":>6s} {\"mean\":>7s} {\"median\":>7s} {\"sqr_eff\":>8s} {\"sgm_pred\":>8s} {\"ratio\":>6s}')
for log10x in ['5.00', '5.30', '5.50']:
    x = 10**float(log10x)
    print(f'\\n=== log10x = {log10x} (x = {x:.0f}) ===')
    for K in sorted(set(k for a,k in by_aK if a==log10x)):
        errs = by_aK[(log10x, K)]
        sigma_eff_rms = math.sqrt(sum(e*e for e in errs)/len(errs))
        sigma_pred = math.sqrt(x) * math.log(K) / (math.pi * math.sqrt(2*K) * math.log(x))
        ratio = sigma_eff_rms / sigma_pred if sigma_pred > 0 else 0
        median = sorted(errs)[len(errs)//2]
        meanv = sum(errs)/len(errs)
        print(f'{log10x:>8s} {K:>6d} {meanv:>7.3f} {median:>7.3f} {sigma_eff_rms:>8.3f} {sigma_pred:>8.3f} {ratio:>6.3f}')
