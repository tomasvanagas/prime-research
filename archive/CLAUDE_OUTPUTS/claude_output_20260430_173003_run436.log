import csv
import math
from statistics import mean, stdev

# Combined finite-K c_emp values (excluding LB)
data = [
    (4.00, 1250, 10000, 0.1474),
    (4.10, 1250, 12589, 0.1250),
    (4.20, 1250, 15849, 0.1062),
    (4.30, 1750, 19953, 0.1264),
    (4.40, 2250, 25119, 0.1383),
    (4.50, 4750, 31623, 0.2488),
    (4.60, 3750, 39811, 0.1675),
    (5.00, 9000, 100000, 0.2147),
    (5.30, 9000, 199526, 0.1353),
]

# Galway-shape fit: K_emp = c * sqrt(x) * log^2(x), c constant
# Best-fit c = mean(c_emp)
cs = [d[3] for d in data]
print(f'mean c_emp (finite-K, 9 anchors): {mean(cs):.4f} +/- {stdev(cs):.4f}')
print(f'range: [{min(cs):.4f}, {max(cs):.4f}]')

# Thread-7-shape: K_emp = factor * x * log^2(K) / log^2(x)
# Or in c_emp form: c_emp = factor * K_pred / (sqrt(x) * log^2(x))
# Predicted by Thread-7-shape with sigma_eff/sigma_pred fitted:
# At each anchor, compute the factor sigma_eff^2/sigma_pred^2 = c_emp / c_emp_T7
# c_emp_T7 in our slot 2 uses 0.61 as the squared GUE factor
import math
print()
print('Galway-shape fit residuals (c_emp - mean):')
for log10x, K_emp, x, c in data:
    resid = c - mean(cs)
    galway_pred = mean(cs) * math.sqrt(x) * math.log(x)**2
    print(f'  log10x={log10x}: K_emp={K_emp}, c_emp={c:.4f}, resid={resid:+.4f}, Galway-pred K={galway_pred:.0f}')

# At log10 x = 5.5, predicted by Galway-shape (c=mean) = ?
x_55 = 316228
K_galway_55 = mean(cs) * math.sqrt(x_55) * math.log(x_55)**2
print(f'\\nGalway-shape K_emp(5.5) prediction with c=mean({mean(cs):.4f}): {K_galway_55:.0f}')
print(f'Empirical K_emp(5.5) > 20001 (K=20000 budget exhausted, worst err = 1.609)')
print(f'Galway-shape requires K_emp < 20000 if c <= 0.222 (since 0.222*316228^.5*log(316228)^2 = 20019)')
print(f'Empirical c_emp(5.5) > 0.222 (lower bound from K=20000 budget)')

# Worst-case err extrapolation: K_emp ~ K * (worst_err/eps)^2 if err ~ 1/sqrt(K)
# At K=20000, worst=1.609 -> K_emp ~ 20000 * 1.609^2 = 51,777
worst_at_20k = 1.609
K_extrap = 20000 * worst_at_20k**2
c_extrap = K_extrap / (math.sqrt(x_55) * math.log(x_55)**2)
print(f'\\nExtrapolated K_emp(5.5) from worst err = 1.609 at K=20000: K = {K_extrap:.0f}')
print(f'Extrapolated c_emp(5.5): {c_extrap:.4f}')
print(f'Thread-7-shape prediction c_emp_T7(5.5) = 0.5958 (with factor 0.61 = (sigma_eff/sigma_pred)^2 = 0.755^2)')

# Compute the sigma_eff/sigma_pred implied by extrapolated c_emp
# c_emp_T7 = factor * K_pred / (sqrt(x) * log^2(x))
# 0.5958 = 0.61 * K_pred / (sqrt(x) * log^2(x))
# So K_pred / (sqrt(x) * log^2(x)) = 0.5958 / 0.61 = 0.9767
# c_extrap / 0.9767 = factor (which is sigma_eff^2/sigma_pred^2)
factor_extrap = c_extrap / (0.5958 / 0.61)
sigma_ratio_extrap = math.sqrt(factor_extrap)
print(f'Implied sigma_eff/sigma_pred from extrapolation: sqrt({factor_extrap:.3f}) = {sigma_ratio_extrap:.3f}')
print(f'Slot 1 reported 0.796 +/- 0.092 across 12 cells; slot 2 finegrid 0.707 +/- 0.063 across 7 cells.')
