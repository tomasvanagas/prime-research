    1	"""Parallel-worker driver: generate zeta zeros for a given (start, end) range
    2	at 15 dps and write to a chunk file. Designed to be spawned in multiple
    3	processes for disjoint ranges so the main gen_zeros_8000.py process and
    4	these workers cover the (2001..8000) range together.
    5	
    6	Usage: python3 gen_zeros_parallel.py <start_k> <end_k> <out_path>
    7	"""
    8	import sys
    9	import time
    10	import mpmath
    11	import os
    12	
    13	mpmath.mp.dps = 15
    14	
    15	start = int(sys.argv[1])
    16	end = int(sys.argv[2])  # inclusive
    17	out_path = sys.argv[3]
    18	
    19	results = []
    20	t0 = time.time()
    21	for k in range(start, end + 1):
    22	    z = mpmath.im(mpmath.zetazero(k))
    23	    s = mpmath.nstr(z, 15)
    24	    results.append(s)
    25	    if (k - start + 1) % 50 == 0:
    26	        elapsed = time.time() - t0
    27	        per = elapsed / (k - start + 1)
    28	        remaining = (end - k) * per
    29	        print(f"[{out_path}] k={k}  done={k-start+1}/{end-start+1} "
    30	              f"elapsed={elapsed:.0f}s ETA={remaining:.0f}s", flush=True)
