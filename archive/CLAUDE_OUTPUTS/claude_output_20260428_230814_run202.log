import json, numpy as np
data = json.loads(open('bc_endomotive_galois_chi_p_results.json').read())
print(f'{\"N\":>5} | per-bin (length L: chi obs vs null mean ± std, z-score):')
for r in data:
    line = f'N={r[\"N\"]:>5}: '
    chi = r['chi_eq_distribution']
    null_d = r['null_eq_distribs']
    all_L = sorted(set(chi) | set().union(*null_d))
    for L in all_L:
        obs = chi.get(L, 0)
        nulls = [d.get(L, 0) for d in null_d]
        mu, sd = np.mean(nulls), np.std(nulls) + 1e-9
        z = (obs - mu) / sd
        line += f'L={L}: chi={obs} null={mu:.1f}±{sd:.1f} z={z:+.2f}; '
    print(line)
