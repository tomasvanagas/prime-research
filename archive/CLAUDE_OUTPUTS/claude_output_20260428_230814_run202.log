Let me verify that the numerical zero detection matches the exact cyclotomic-Z[ζ_M] reduction for a small case.
  [Bash] python3 -c "
from bc_endomotive_galois_chi_p import (
    cyclic_decomp, all_dlogs, char_exp, sum_exact_value, sum_exact_is_zero
)
from itertools import product
from math import lcm
from sympy import primerange, gcd

for N in [30, 60]:
    gens = cyclic_decomp(N)
    d_list = [d for _, d in gens]
    M = lcm(*d_list) if len(d_list) > 1 else d_list[0]
    M_factors = [M // d for d in d_list]
    dlog = all_dlogs(N, gens)
    P_N = [p for p in primerange(2, N + 1) if gcd(p, N) == 1]
    
    char_tuples = list(product(*[range(d) for d in d_list]))
    print(f'N={N}: testing {len(char_tuples)} characters')
    disagreements = 0
    for kt in char_tuples:
        exps = [char_exp(kt, dlog[a], M_factors, M) for a in P_N]
        val, is_zero_num = sum_exact_value(exps, M, exact_check=False)
        is_zero_alg = sum_exact_is_zero(exps, M)
        if is_zero_num != is_zero_alg:
            disagreements += 1
            print(f'  DISAGREE: char={kt}, |val|={abs(val)}, num={is_zero_num}, alg={is_zero_alg}')
    print(f'N={N}: {disagreements}/{len(char_tuples)} disagreements')
"

