  [Bash] python3 -c "
import numpy as np, math
import sys
sys.path.insert(0, '.')
from bdj_toeplitz_hankel_chi_p import sieve_chi_p, build_toeplitz, build_hankel

for N in [500, 1000, 2000]:
    chi = sieve_chi_p(N)
    p = float(chi.mean())
    s = (chi - p) / math.sqrt(p*(1-p))
    T = build_toeplitz(s, N)
    H = build_hankel(sieve_chi_p(2*N-1) - p, N) / math.sqrt(p*(1-p))
    wT = np.linalg.eigvalsh(T) / math.sqrt(N)
    wH = np.linalg.eigvalsh(H) / math.sqrt(N)
    # Top 5 + bottom 5 + bulk stats
    print(f'N={N} p={p:.4f} log N={math.log(N):.2f}')
    print(f'  Toeplitz top-5 eigs:  {wT[-5:]}')
    print(f'  Toeplitz bot-5 eigs:  {wT[:5]}')
    # bulk = exclude top-1 and bot-1
    bulk = wT[1:-1]
    print(f'  Toeplitz bulk: m_2={(bulk**2).mean():.3f} m_4={(bulk**4).mean():.3f} m_6={(bulk**6).mean():.3f}')
    full_m4 = (wT**4).mean(); full_m6 = (wT**6).mean()
    top1_m4 = wT[-1]**4 / N; bot1_m4 = wT[0]**4 / N
    print(f'  Toeplitz full: m_4={full_m4:.3f}, top-eig contributes {top1_m4:.3f} ({top1_m4/full_m4*100:.1f}%), bot-eig {bot1_m4:.3f} ({bot1_m4/full_m4*100:.1f}%)')
    # Predicted q=2 peak height
    q2_predicted_peak = 2.0 * (chi.sum()-1) / math.sqrt(p*(1-p))  # |F_N(-1)| * 2 / sigma
    print(f'  Predicted lam_max (q=2 peak): {q2_predicted_peak/math.sqrt(N):.3f}')
    print(f'  Hankel top-5 eigs:    {wH[-5:]}')
    print(f'  Hankel bot-5 eigs:    {wH[:5]}')
    print()
"

