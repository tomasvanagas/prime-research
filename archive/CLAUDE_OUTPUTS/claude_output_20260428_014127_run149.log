# Generate the 49 entry computations for W=9 corner
rho = [0, 1, 3, 5, 2, 4, 6]
sigma = [2, 1, 3, 7, 0, 4, 6]
W = 9

primes_in_set = set()
composites_in_set = set()

def is_prime(n):
    if n < 2: return False
    for i in range(2, int(n**0.5)+1):
        if n % i == 0: return False
    return True

# Compute all 49 entries
print('# 49 entry table for W=9 corner')
print('# i j  -> ρ(i)*9 + σ(j) + 1 = N (chiP value)')
for i in range(7):
    for j in range(7):
        n = rho[i] * 9 + sigma[j] + 1
        v = 1 if is_prime(n) else 0
        if v: primes_in_set.add(n)
        else: composites_in_set.add(n)
        print(f'  ({i},{j}): rho={rho[i]} sig={sigma[j]} -> chiP({n}) = {v}')

print()
print(f'Primes used: {sorted(primes_in_set)}')
print(f'Composites used: {sorted(composites_in_set)}')
print(f'Composites count: {len(composites_in_set)}')
"

