rho_vals = [0, 1, 3, 5, 2, 4, 6]
sigma_vals = [2, 1, 3, 7, 0, 4, 6]
W = 9

def is_prime(n):
    if n < 2: return False
    for i in range(2, int(n**0.5)+1):
        if n % i == 0: return False
    return True

# Map prime -> chiP_X_eq_one helper name
prime_names = {
    2: 'chiP_two_eq_one',
    3: 'chiP_three_eq_one',
    5: 'chiP_five_eq_one',
    7: 'chiP_seven_eq_one',
    11: 'chiP_eleven_eq_one',
    13: 'chiP_thirteen_eq_one',
    17: 'chiP_seventeen_eq_one',
    19: 'chiP_nineteen_eq_one',
    23: 'chiP_twenty_three_eq_one',
    29: 'chiP_twenty_nine_eq_one',
    31: 'chiP_thirty_one_eq_one',
    37: 'chiP_thirty_seven_eq_one',
    41: 'chiP_forty_one_eq_one',
    43: 'chiP_forty_three_eq_one',
    47: 'chiP_forty_seven_eq_one',
    53: 'chiP_fifty_three_eq_one',
    59: 'chiP_fifty_nine_eq_one',
    61: 'chiP_sixty_one_eq_one',
}

# All composites used (from earlier analysis)
composites = sorted({1, 4, 8, 10, 12, 14, 16, 20, 21, 22, 25, 26, 28, 30, 32, 34, 35, 38, 39, 40, 44, 46, 48, 49, 50, 52, 55, 56, 57, 58, 62})

def number_word(n):
    return {1:'one',4:'four',8:'eight',10:'ten',12:'twelve',14:'fourteen',16:'sixteen',
            20:'twenty',21:'twenty_one',22:'twenty_two',25:'twenty_five',26:'twenty_six',
            28:'twenty_eight',30:'thirty',32:'thirty_two',34:'thirty_four',35:'thirty_five',
            38:'thirty_eight',39:'thirty_nine',40:'forty',44:'forty_four',46:'forty_six',
            48:'forty_eight',49:'forty_nine',50:'fifty',52:'fifty_two',55:'fifty_five',
            56:'fifty_six',57:'fifty_seven',58:'fifty_eight',62:'sixty_two'}[n]

# rho-domain bound names (for h_X_lt_pow_j)
rho_set = sorted(set(rho_vals))  # {0, 1, 2, 3, 4, 5, 6}
sigma_set = sorted(set(sigma_vals))  # {0, 1, 2, 3, 4, 6, 7}

def pj_name(r):
    if r == 0: return 'h_pow_j_pos'
    return f'h_{r}_lt_pow_j'

def pdj_name(s):
    if s == 0: return 'h_zero_lt_pow_dj'
    return f'h_{s}_lt_pow_dj'

print("/-")
print("**Corner-case prime exhibit (W = 9, d = j + 1).**")
print()
print("Closed at S152 via the BlockTriangular `(1 + 3 + 3)` decomposition")
print("identified in S151's pre-search. The construction uses")
print("`ρ : Fin 7 → Fin (9^j)` mapping `(0..6) ↦ (0, 1, 3, 5, 2, 4, 6)` and")
print("`σ : Fin 7 → Fin (9^((j+1)-j))` mapping `(0..6) ↦ (2, 1, 3, 7, 0, 4, 6)`.")
print("The `7 × 7` submatrix decomposes (via `finSumFinEquiv : Fin 4 ⊕ Fin 3 ≃ Fin 7`)")
print("into `Matrix.fromBlocks A B 0 D` with `A : Matrix (Fin 4) (Fin 4) ℚ` (det -1)")
print("and `D : Matrix (Fin 3) (Fin 3) ℚ` (det -1), giving total det = `(-1) · (-1) = 1`,")
print("hence `IsUnit` over `ℚ`. Uses `chiP_thirteen_eq_one`, `chiP_forty_one_eq_one`,")
print("`chiP_fifty_three_eq_one`, `chiP_sixty_one_eq_one` (new at S152) plus existing")
print("helpers for primes `{2, 3, 5, 7, 11, 17, 19, 23, 29, 31, 37, 43, 47, 59}`.")
print("First instance using `Matrix.det_fromBlocks_zero_21` (a determinant technique")
print("orthogonal to the previous nine corner closures).")
print("-/")
print("set_option maxHeartbeats 800000 in")
print("theorem exists_invertible_submatrix_W_eq_9_d_eq_j_plus_1")
print("    (j : ℕ) (hj : 1 ≤ j) :")
print("    ∃ (ρ : Fin 7 → Fin (9 ^ j))")
print("      (σ : Fin 7 → Fin (9 ^ ((j + 1) - j))),")
print("      IsUnit ((unfolding 9 (j + 1) j).submatrix ρ σ) := by")
print("  have h_sub : (j + 1 : ℕ) - j = 1 := by omega")
print("  have h_pow_j_pos : 0 < 9 ^ j := Nat.pow_pos (by norm_num)")

# rho bounds: 1, 2, 3, 4, 5, 6 < 9^j
for r in [1, 2, 3, 4, 5, 6]:
    print(f"  have h_{r}_lt_pow_j : {r} < 9 ^ j := by")
    print(f"    calc ({r} : ℕ) < 9 := by norm_num")
    print(f"      _ = 9 ^ 1 := by norm_num")
    print(f"      _ ≤ 9 ^ j := Nat.pow_le_pow_right (by norm_num) hj")

# sigma bounds: 1, 2, 3, 4, 6, 7 < 9^((j+1)-j)
print("  have h_zero_lt_pow_dj : (0 : ℕ) < 9 ^ ((j + 1) - j) := by rw [h_sub]; norm_num")
for s in [1, 2, 3, 4, 6, 7]:
    print(f"  have h_{s}_lt_pow_dj : ({s} : ℕ) < 9 ^ ((j + 1) - j) := by rw [h_sub]; norm_num")

# Define rho, sigma via refine + if-then-else
print("  -- ρ ↦ (0, 1, 3, 5, 2, 4, 6)")
print("  -- σ ↦ (2, 1, 3, 7, 0, 4, 6)")
print("  refine ⟨fun i =>")
for k, r in enumerate(rho_vals):
    if k == 0:
        bound = pj_name(r)
        print(f"           if i.val = 0 then ⟨{r}, {bound}⟩")
    elif k < 6:
        bound = pj_name(r)
        print(f"           else if i.val = {k} then ⟨{r}, {bound}⟩")
    else:
        bound = pj_name(r)
        print(f"           else ⟨{r}, {bound}⟩,")
print("         fun i =>")
for k, s in enumerate(sigma_vals):
    if k == 0:
        bound = pdj_name(s)
        print(f"           if i.val = 0 then ⟨{s}, {bound}⟩")
    elif k < 6:
        bound = pdj_name(s)
        print(f"           else if i.val = {k} then ⟨{s}, {bound}⟩")
    else:
        bound = pdj_name(s)
        print(f"           else ⟨{s}, {bound}⟩, ?_⟩")
print("  rw [Matrix.isUnit_iff_isUnit_det]")

# Not-prime decidability
print("  -- Non-primality for the composites used in the entries.")
for n in composites:
    if n == 1:
        print(f"  have h_not_prime_{n} : ¬ Nat.Prime {n} := Nat.not_prime_one")
    else:
        print(f"  have h_not_prime_{n} : ¬ Nat.Prime {n} := by decide")

# 49 entry lemmas
print("  -- Compute the 49 entries of the 7×7 submatrix.")
for i in range(7):
    for j in range(7):
        r = rho_vals[i]
        s = sigma_vals[j]
        n = r * 9 + s + 1
        is_p = is_prime(n)
        const = '1' if is_p else '0'
        pj = pj_name(r)
        pdj = pdj_name(s)
        var_name = f'hE{i}{j}'
        print(f"  have {var_name} : unfolding 9 (j + 1) j ⟨{r}, {pj}⟩ ⟨{s}, {pdj}⟩ = {const} := by")
        print(f"    change chiP ({r} * 9 ^ ((j + 1) - j) + {s} + 1) = {const}")
        print(f"    rw [h_sub]")
        print(f"    have h_eq : ({r} * 9 ^ 1 + {s} + 1 : ℕ) = {n} := by norm_num")
        print(f"    rw [h_eq]")
        if is_p:
            print(f"    exact {prime_names[n]}")
        else:
            print(f"    simp [chiP, h_not_prime_{n}]")

# Fin val helpers and ne helpers
print("  -- Fin 7 .val and ≠ helpers for the if-then-else ρ, σ.")
for k in range(7):
    print(f"  have hv{k} : ({k} : Fin 7).val = {k} := rfl")
print("  have hne_1_0 : (1 : ℕ) ≠ 0 := by decide")
for a, b in [(2,0),(2,1),(3,0),(3,1),(3,2),(4,0),(4,1),(4,2),(4,3),(5,0),(5,1),(5,2),(5,3),(5,4),(6,0),(6,1),(6,2),(6,3),(6,4),(6,5)]:
    print(f"  have hne_{a}_{b} : ({a} : ℕ) ≠ {b} := by decide")

# Define M via set
print("  -- Set up the named ρ, σ, M for the rest of the proof.")
print("  set Mρ : Fin 7 → Fin (9 ^ j) :=")
for k, r in enumerate(rho_vals):
    bound = pj_name(r)
    if k == 0:
        print(f"    fun i => if i.val = 0 then ⟨{r}, {bound}⟩")
    elif k < 6:
        print(f"             else if i.val = {k} then ⟨{r}, {bound}⟩")
    else:
        print(f"             else ⟨{r}, {bound}⟩ with hMρ_def")
print("  set Mσ : Fin 7 → Fin (9 ^ ((j + 1) - j)) :=")
for k, s in enumerate(sigma_vals):
    bound = pdj_name(s)
    if k == 0:
