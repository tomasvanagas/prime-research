print("                 hne_1_0, hne_2_0, hne_2_1, hne_3_0, hne_3_1, hne_3_2,")
print("                 hne_4_0, hne_4_1, hne_4_2, hne_4_3,")
print("                 hne_5_0, hne_5_1, hne_5_2, hne_5_3, hne_5_4,")
print("                 hne_6_0, hne_6_1, hne_6_2, hne_6_3, hne_6_4, hne_6_5]")
