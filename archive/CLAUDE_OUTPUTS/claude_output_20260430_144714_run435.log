import csv, math
from collections import defaultdict

traces = defaultdict(lambda: defaultdict(list))
with open('/apps/aplikacijos/prime-research/experiments/analytic/galway_constant/slot1_traces.csv') as fh:
    r = csv.reader(fh)
    next(r)
    for row in r:
        a, x, pi_x, K, err = float(row[0]), int(row[1]), int(row[2]), int(row[3]), float(row[4])
        traces[a][K].append(err)

# Compute sigma_eff vs sigma_pred at K=8000 for each anchor
import mpmath as mp
def sigma_pred(x, K):
    return float(mp.sqrt(mp.mpf(x)) * mp.log(K) / (mp.pi * mp.sqrt(2*K) * mp.log(x)))

print(f'{\"log10x\":>8s} {\"K\":>6s} {\"sigma_eff\":>10s} {\"sigma_pred\":>10s} {\"ratio\":>8s}  (eff = RMS of errors)')
for a in sorted(traces.keys()):
    x = 10**a
    Ks = [100, 500, 1000, 2000, 4000, 8000]
    for K in Ks:
        errs = traces[a][K]
        rms = math.sqrt(sum(e*e for e in errs)/len(errs))
        sp = sigma_pred(x, K)
        print(f'{a:>8.2f} {K:>6d} {rms:>10.4f} {sp:>10.4f} {rms/sp:>8.3f}')
    print()
