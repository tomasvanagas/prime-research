import numpy as np
import math

# Independent re-implementation of the Fourier sieve
def primes_up_to(N):
    is_p = np.ones(N+1, dtype=bool)
    is_p[:2] = False
    for i in range(2, int(N**0.5)+1):
        if is_p[i]:
            is_p[i*i::i] = False
    return np.nonzero(is_p)[0]

def factor(q):
    f = []
    n = q
    p = 2
    while p*p <= n:
        if n%p==0:
            e=0
            while n%p==0:
                n//=p; e+=1
            f.append((p,e))
        p+=1
    if n>1: f.append((n,1))
    return f

def is_squarefree(q):
    return q==1 or all(e==1 for _,e in factor(q))

def E(primes, q, N):
    e = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1: continue
        ang = 2*np.pi*k*primes/q
        e += (np.sum(np.cos(ang))**2 + np.sum(np.sin(ang))**2)/N
    return e

# Independent reproduction at d=14
N = 2**14
primes = primes_up_to(N)
piN = len(primes)
print(f'd=14, N={N}, pi(N)={piN}')
Qstar = round(N**0.21)
print(f'Q*=round(N^0.21) = {Qstar}')

# All squarefree q in [2, Qstar]
sqf = [q for q in range(2, Qstar+1) if is_squarefree(q)]
print(f'Squarefree q in [2,{Qstar}]: {sqf}')
cum = 0.0
for q in sqf:
    e = E(primes, q, N)
    cum += e
    print(f'  q={q}: E(q,N) = {e:.4f}, cum = {cum:.4f}')
print(f'cum(Q*) = {cum:.4f}')
print(f'0.21*pi(N) = {0.21*piN:.4f}')
print(f'ratio = {cum/(0.21*piN):.4f}')
print(f'  -- expected ratio per S169 table: 1.3300')
print()
print('SVD spike block (d=14) = 424.81 (loaded above)')
print(f'spike / 0.21*pi(N) = {424.81/(0.21*piN):.4f} (S169 reports 1.0647)')
print(f'spike / cum(Q*) = {424.81/cum:.4f} (S169 reports 0.8005, leakage -19.95%)')
