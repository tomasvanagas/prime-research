import numpy as np
import math

def primes_up_to(N):
    is_p = np.ones(N+1, dtype=bool)
    is_p[:2] = False
    for i in range(2, int(N**0.5)+1):
        if is_p[i]:
            is_p[i*i::i] = False
    return np.nonzero(is_p)[0]

def factor(q):
    f = []
    n = q
    p = 2
    while p*p <= n:
        if n%p==0:
            e=0
            while n%p==0:
                n//=p; e+=1
            f.append((p,e))
        p+=1
    if n>1: f.append((n,1))
    return f

def is_squarefree(q):
    return q==1 or all(e==1 for _,e in factor(q))

def E(primes, q, N):
    e = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1: continue
        ang = 2*np.pi*k*primes/q
        e += (np.sum(np.cos(ang))**2 + np.sum(np.sin(ang))**2)/N
    return e

# Check the spike block / 0.21*pi(N) ratio at d=18, 20 and Q_eff exponent
for d, expected_spike, expected_ratio in [(18, 5087.28, 1.0533), (20, 18027.69, 1.0466)]:
    N = 2**d
    primes = primes_up_to(N)
    piN = len(primes)
    print(f'd={d}, N={N}, pi(N)={piN}')
    print(f'  0.21*pi(N) = {0.21*piN:.2f}')
    print(f'  SVD spike block = {expected_spike:.2f}')
    actual_ratio = expected_spike / (0.21*piN)
    print(f'  spike/0.21pi = {actual_ratio:.4f} (S169: {expected_ratio})')

    # Find Q_eff: cum(Q_eff) >= spike block
    Q_eff = None
    cum = 0.0
    Q_max = max(60, int(round(N**0.30)))
    for q in range(2, Q_max+1):
        if not is_squarefree(q): continue
        cum += E(primes, q, N)
        if cum >= expected_spike and Q_eff is None:
            Q_eff = q
            print(f'  Q_eff = {q}: cum = {cum:.4f}')
            print(f'  log Q_eff / log N = {math.log(q)/math.log(N):.4f}')
            break
"

