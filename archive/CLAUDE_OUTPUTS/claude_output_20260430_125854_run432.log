  [Bash] python3 -c "
import math, csv
# Empirical Delta(w) values from slot3_predictions.csv
rows = list(csv.DictReader(open('/apps/aplikacijos/prime-research/experiments/analytic/k_tuple_batched/slot3_predictions.csv')))
ws = [int(r['w']) for r in rows]
Ds = [float(r['Delta_w']) for r in rows]
# Fit Delta = alpha * w * log(w) + beta * w (least squares on the 6 cells)
import numpy as np
W = np.array([[w * math.log(w), w] for w in ws])
D = np.array(Ds)
coef, _, _, _ = np.linalg.lstsq(W, D, rcond=None)
alpha, beta = coef
print(f'Delta(w) ≈ {alpha:.4f} * w log(w) + {beta:.4f} * w')
print(f'  alpha = {alpha:.4f}')
print(f'  beta  = {beta:.4f}')
# Test at every cell
for w, D_emp in zip(ws, Ds):
    D_pred = alpha * w * math.log(w) + beta * w
    print(f'  w={w}  empirical Delta={D_emp:.0f}  fit Delta={D_pred:.0f}  rel_err={abs(D_emp-D_pred)/abs(D_emp)*100:.2f}%')
# Also try alpha/log(6) heuristic
import math
C_2 = 0.660161815847
S4_avg = 24 * C_2 * C_2
print()
print(f'24 C_2^2 = {S4_avg:.4f}')
print(f'24 C_2^2 / log(6) = {S4_avg/math.log(6):.4f}')
print(f'log(6) = {math.log(6):.4f}')
"

