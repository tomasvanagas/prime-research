print('Ei(rho*log x) =', mpmath.ei(rho*log_x))
print('|Ei| =', float(abs(mpmath.ei(rho*log_x))))

# sum over 200 zeros
s = R(x)
for gamma in zeros:
    rho = mpmath.mpc(0.5, gamma)
    s -= 2 * mpmath.ei(rho*log_x).real
print('R(100) - sum_{200} 2*Re Ei(rho log 100) =', float(s))
print('pi(100) =', int(primepi(100)))
