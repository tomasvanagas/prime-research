# R(x)
def R(x):
    s = mpmath.mpf(0)
    k = 1
    while True:
        root = x ** (mpmath.mpf(1)/k)
        if root <= mpmath.mpf('1.05'):
            break
        mu = mobius(k)
        if mu != 0:
            s += mpmath.mpf(mu)/k * mpmath.li(root)
        k += 1
        if k > 30: break
    return s

