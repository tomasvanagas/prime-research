  -- After Finset.sum_eq_single, M.det = 1 * (M.submatrix 0.succAbove Fin.succ).det.
  rw [Matrix.det_succ_column_zero]
  -- Goal: IsUnit (∑ i, (-1)^i.val * M i 0 * (M.submatrix i.succAbove Fin.succ).det)
  rw [Finset.sum_eq_single (0 : Fin 7)]
  -- Three subgoals: f 0 expression, ∀ b ≠ 0, f b = 0, 0 ∉ univ → f 0 = 0.
  · -- f 0: simplify (-1)^0 * M[0,0] * det(M_minor) to det(M_minor).
    -- M[0,0] = unfolding ⟨0, h_pow_j_pos⟩ ⟨2, h_two_lt_pow_dj⟩ = 1 (from hE_0_0).
    show IsUnit
      ((-1 : ℚ)^(0 : Fin 7).val *
        (unfolding 9 (j + 1) j).submatrix _ _ 0 0 *
        ((unfolding 9 (j + 1) j).submatrix _ _).submatrix
          (0 : Fin 7).succAbove Fin.succ |>.det)
    sorry
  · -- ∀ b ∈ univ, b ≠ 0 → f b = 0.
    intro b _ hb_ne
    fin_cases b
    · exact absurd rfl hb_ne
    all_goals
      show (-1 : ℚ)^_ * (unfolding 9 (j + 1) j).submatrix _ _ _ 0 * _ = 0
      sorry
  · -- 0 ∉ univ → ... (impossible)
    intro h
    exact absurd (Finset.mem_univ _) h
