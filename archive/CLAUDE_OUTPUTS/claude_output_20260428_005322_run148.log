from sympy import isprime
W = 9
# rho values: (0, 1, 3, 5, 2, 4, 6) = ρ(0..6)
rho = [0, 1, 3, 5, 2, 4, 6]
# sigma values: (2, 1, 3, 7, 0, 4, 6) = σ(0..6)
sigma = [2, 1, 3, 7, 0, 4, 6]

# Print the 7x7 matrix
print("# Submatrix entries (i is row index in Fin 7, k is col index)")
print("# Entry (i, k) = chiP(rho[i] * 9 + sigma[k] + 1)")
print()
print("Matrix:")
for i in range(7):
    row = []
    for k in range(7):
        n = rho[i] * 9 + sigma[k] + 1
        row.append(1 if isprime(n) else 0)
    print(f"  i={i} (rho={rho[i]}): {row}  (n: {[rho[i]*9+sigma[k]+1 for k in range(7)]})")

# Print primes and composites
primes_used = set()
composites_used = set()
for i in range(7):
    for k in range(7):
        n = rho[i] * 9 + sigma[k] + 1
        if isprime(n):
            primes_used.add(n)
        else:
            composites_used.add(n)
print()
print(f"Primes used: {sorted(primes_used)}")
print(f"Composites used: {sorted(composites_used)}")
print()
print("# Block decomposition:")
print("# After det_succ_column_zero: M.det = M[0,0] * det(M_minor)")
print("# M_minor (6x6) is M with row 0 and col 0 removed: rows 1..6 × cols 1..6")
print()
print("M_minor (6x6) entries:")
for i in range(1, 7):
    row = []
    for k in range(1, 7):
        n = rho[i] * 9 + sigma[k] + 1
        row.append(1 if isprime(n) else 0)
    print(f"  M_minor row {i-1}: {row}")
