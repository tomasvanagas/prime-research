/--
**Corner-case prime exhibit (W = 9, d = j + 1).**

Exhibits a `7 × 7` invertible submatrix of `(unfolding 9 (j+1) j)`,
which is **block upper-triangular** as `1 + 6` (top row alone, then
6×6 minor) and the `6 × 6` minor is **block-DIAGONAL** as `3 + 3`.
Determinant via two nested `det_fromBlocks_zero₂₁` is `1 · (-1) · (-1) = 1`.
-/
theorem exists_invertible_submatrix_W_eq_9_d_eq_j_plus_1
    (j : ℕ) (hj : 1 ≤ j) :
    ∃ (ρ : Fin 7 → Fin (9 ^ j))
      (σ : Fin 7 → Fin (9 ^ ((j + 1) - j))),
      IsUnit ((unfolding 9 (j + 1) j).submatrix ρ σ) := by
  have h_sub : (j + 1 : ℕ) - j = 1 := by omega
  have h_pow_j_pos : 0 < 9 ^ j := Nat.pow_pos (by norm_num)
  have h_one_lt_pow_j : 1 < 9 ^ j := by
    calc (1 : ℕ) < 9 := by norm_num
      _ = 9 ^ 1 := by norm_num
      _ ≤ 9 ^ j := Nat.pow_le_pow_right (by norm_num) hj
  have h_two_lt_pow_j : 2 < 9 ^ j := by
    calc (2 : ℕ) < 9 := by norm_num
      _ = 9 ^ 1 := by norm_num
      _ ≤ 9 ^ j := Nat.pow_le_pow_right (by norm_num) hj
  have h_three_lt_pow_j : 3 < 9 ^ j := by
    calc (3 : ℕ) < 9 := by norm_num
      _ = 9 ^ 1 := by norm_num
      _ ≤ 9 ^ j := Nat.pow_le_pow_right (by norm_num) hj
  have h_four_lt_pow_j : 4 < 9 ^ j := by
    calc (4 : ℕ) < 9 := by norm_num
      _ = 9 ^ 1 := by norm_num
      _ ≤ 9 ^ j := Nat.pow_le_pow_right (by norm_num) hj
  have h_five_lt_pow_j : 5 < 9 ^ j := by
    calc (5 : ℕ) < 9 := by norm_num
      _ = 9 ^ 1 := by norm_num
      _ ≤ 9 ^ j := Nat.pow_le_pow_right (by norm_num) hj
  have h_six_lt_pow_j : 6 < 9 ^ j := by
    calc (6 : ℕ) < 9 := by norm_num
      _ = 9 ^ 1 := by norm_num
      _ ≤ 9 ^ j := Nat.pow_le_pow_right (by norm_num) hj
  have h_zero_lt_pow_dj : (0 : ℕ) < 9 ^ ((j + 1) - j) := by rw [h_sub]; norm_num
  have h_one_lt_pow_dj : (1 : ℕ) < 9 ^ ((j + 1) - j) := by rw [h_sub]; norm_num
  have h_two_lt_pow_dj : (2 : ℕ) < 9 ^ ((j + 1) - j) := by rw [h_sub]; norm_num
  have h_three_lt_pow_dj : (3 : ℕ) < 9 ^ ((j + 1) - j) := by rw [h_sub]; norm_num
  have h_four_lt_pow_dj : (4 : ℕ) < 9 ^ ((j + 1) - j) := by rw [h_sub]; norm_num
  have h_six_lt_pow_dj : (6 : ℕ) < 9 ^ ((j + 1) - j) := by rw [h_sub]; norm_num
  have h_seven_lt_pow_dj : (7 : ℕ) < 9 ^ ((j + 1) - j) := by rw [h_sub]; norm_num
  -- ρ : (0..6) ↦ (0, 1, 3, 5, 2, 4, 6).
  -- σ : (0..6) ↦ (2, 1, 3, 7, 0, 4, 6).
  refine ⟨fun i => if i.val = 0 then ⟨0, h_pow_j_pos⟩
                   else if i.val = 1 then ⟨1, h_one_lt_pow_j⟩
                   else if i.val = 2 then ⟨3, h_three_lt_pow_j⟩
                   else if i.val = 3 then ⟨5, h_five_lt_pow_j⟩
                   else if i.val = 4 then ⟨2, h_two_lt_pow_j⟩
                   else if i.val = 5 then ⟨4, h_four_lt_pow_j⟩
