  [Bash] python3 << 'EOF'
from itertools import permutations
import numpy as np

# Block 1
B1 = np.array([
  [1, 1, 1],
  [1, 1, 0],
  [1, 0, 1]
])

# Block 2
B2 = np.array([
  [1, 1, 0],
  [1, 1, 1],
  [0, 1, 1]
])

def check_upper_tri_perm(B):
    found = []
    for rp in permutations(range(3)):
        for cp in permutations(range(3)):
            M = B[np.ix_(rp, cp)]
            ok = True
            for i in range(3):
                if M[i, i] == 0:
                    ok = False; break
                for j in range(i):
                    if M[i, j] != 0:
                        ok = False; break
                if not ok: break
            if ok:
                found.append((rp, cp, M.copy()))
    return found

print("Block 1 upper-tri permutations:")
for rp, cp, M in check_upper_tri_perm(B1):
    print(f"  rows={rp}, cols={cp}, M=")
    for row in M:
        print(f"    {list(row)}")

print("\nBlock 2 upper-tri permutations:")
for rp, cp, M in check_upper_tri_perm(B2):
    print(f"  rows={rp}, cols={cp}, M=")
    for row in M:
        print(f"    {list(row)}")
