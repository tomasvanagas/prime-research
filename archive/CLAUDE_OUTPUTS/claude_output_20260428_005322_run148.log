from itertools import combinations
from math import gcd
from sympy import isprime, Matrix

W = 9
live = [k for k in range(W) if gcd(k+1, W) == 1]
dead = [k for k in range(W) if gcd(k+1, W) != 1 and isprime(k+1)]
cols = sorted(live + [dead[0]])  # [0,1,2,3,4,6,7]
dead_col_idx = cols.index(dead[0])  # 2
live_col_idxs = [i for i in range(7) if i != dead_col_idx]

def chiP(n):
    return 1 if isprime(n) else 0

M = [[chiP(r*W + c + 1) for c in cols] for r in range(W)]

EXISTING = {2, 3, 5, 7, 11, 17, 19, 23, 29, 31, 37, 43, 47, 59, 89, 97,
            109, 127, 149, 179, 199, 211, 241, 293, 337}

# Find the candidate with minimum new primes needed
best = None
for rows6 in combinations([1,2,3,4,5,6,7,8], 6):
    for A_rows in combinations(rows6, 3):
        B_rows = tuple(r for r in rows6 if r not in A_rows)
        for A_cols in combinations(live_col_idxs, 3):
            B_cols = tuple(c for c in live_col_idxs if c not in A_cols)
            if any(M[r][c] != 0 for r in B_rows for c in A_cols):
                continue
            MA = Matrix([[M[r][c] for c in A_cols] for r in A_rows])
            dA = MA.det()
            if dA == 0:
                continue
            MB = Matrix([[M[r][c] for c in B_cols] for r in B_rows])
            dB = MB.det()
            if dB == 0:
                continue
            # Collect primes used (entries that are 1)
            primes_used = set()
            # Row 0 entries (all of them: the row is in the matrix, with 1 at non-zero positions)
            for c_idx in [dead_col_idx] + list(A_cols) + list(B_cols):
                n = 0*W + cols[c_idx] + 1
                if isprime(n):
                    primes_used.add(n)
            # A block entries
            for r in A_rows:
                for c_idx in A_cols:
                    n = r*W + cols[c_idx] + 1
                    if isprime(n):
                        primes_used.add(n)
            # B block entries
            for r in B_rows:
                for c_idx in B_cols:
                    n = r*W + cols[c_idx] + 1
                    if isprime(n):
                        primes_used.add(n)
            # Off-diagonal upper block entries: row 0 -> A,B; A_rows -> B_cols
            for r in A_rows:
                for c_idx in B_cols:
                    n = r*W + cols[c_idx] + 1
                    if isprime(n):
                        primes_used.add(n)
            new_primes = primes_used - EXISTING
            if best is None or len(new_primes) < len(best[0]):
                best = (new_primes, primes_used, A_rows, A_cols, B_rows, B_cols, dA, dB, rows6)

print('Best candidate (fewest new primes needed):')
print(f'  new primes: {sorted(best[0])}')
print(f'  all primes used: {sorted(best[1])}')
print(f'  A_rows = {best[2]}, A_cols (chosen idx) = {best[3]} -> k-vals = {[cols[i] for i in best[3]]}')
print(f'  B_rows = {best[4]}, B_cols (chosen idx) = {best[5]} -> k-vals = {[cols[i] for i in best[5]]}')
print(f'  det A = {best[6]}, det B = {best[7]}')
print()

# Show all candidates with the minimum new prime count
min_new = len(best[0])
print(f'\n=== All candidates with min ({min_new}) new primes ===')
seen = set()
for rows6 in combinations([1,2,3,4,5,6,7,8], 6):
    for A_rows in combinations(rows6, 3):
        B_rows = tuple(r for r in rows6 if r not in A_rows)
        for A_cols in combinations(live_col_idxs, 3):
            B_cols = tuple(c for c in live_col_idxs if c not in A_cols)
            if any(M[r][c] != 0 for r in B_rows for c in A_cols):
                continue
            MA = Matrix([[M[r][c] for c in A_cols] for r in A_rows])
            dA = MA.det()
            if dA == 0:
                continue
            MB = Matrix([[M[r][c] for c in B_cols] for r in B_rows])
            dB = MB.det()
            if dB == 0:
                continue
            primes_used = set()
            for c_idx in [dead_col_idx] + list(A_cols) + list(B_cols):
                n = 0*W + cols[c_idx] + 1
                if isprime(n):
                    primes_used.add(n)
            for r in A_rows:
                for c_idx in A_cols:
                    n = r*W + cols[c_idx] + 1
                    if isprime(n):
                        primes_used.add(n)
            for r in B_rows:
                for c_idx in B_cols:
                    n = r*W + cols[c_idx] + 1
                    if isprime(n):
                        primes_used.add(n)
            for r in A_rows:
                for c_idx in B_cols:
                    n = r*W + cols[c_idx] + 1
                    if isprime(n):
                        primes_used.add(n)
            new_primes = primes_used - EXISTING
            if len(new_primes) == min_new:
                key = (A_rows, frozenset(A_cols), B_rows, frozenset(B_cols))
                if key in seen: continue
                seen.add(key)
                print(f'A_rows={A_rows}, A_kcols={[cols[i] for i in A_cols]}, B_rows={B_rows}, B_kcols={[cols[i] for i in B_cols]}, dA={dA}, dB={dB}, new primes={sorted(new_primes)}')
