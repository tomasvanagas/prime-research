from itertools import combinations, permutations
from math import gcd
from sympy import isprime, Matrix

W = 9
live = [k for k in range(W) if gcd(k+1, W) == 1]
dead = [k for k in range(W) if gcd(k+1, W) != 1 and isprime(k+1)]
cols = sorted(live + [dead[0]])
print('chosen cols:', cols)
print('dead col index in chosen cols:', cols.index(dead[0]))
R = 7

# Build full 9x7 matrix
def chiP(n):
    return 1 if isprime(n) else 0

M = [[chiP(r*W + c + 1) for c in cols] for r in range(W)]
dead_col_idx = cols.index(dead[0])  # = 2

# Live col indices in `cols`:
live_col_idxs = [i for i in range(7) if i != dead_col_idx]
print('live col indices in chosen cols:', live_col_idxs, '-> values:', [cols[i] for i in live_col_idxs])

# Search: find rows R6 (6 rows from {1..8}), partition (A_rows, B_rows) of size 3+3,
# partition (A_cols, B_cols) of live_col_idxs of size 3+3,
# such that:
#  (a) M[A, A'] det nonzero
#  (b) M[B, B'] det nonzero
#  (c) M[B, A'] all zeros  (block-diagonal-like for label 2 × label 1 cols)
#  (d) M[A, B'] could be anything (does not matter for upper-block)
# This is BlockTriangular id form with b: row 0 -> 0, A_rows -> 1, B_rows -> 2.
# Permutation: re-order rows so row 0 first, then A_rows, then B_rows; cols dead_col first, then A_cols, then B_cols.

candidates = []
for rows6 in combinations([1,2,3,4,5,6,7,8], 6):
    for A_rows in combinations(rows6, 3):
        B_rows = tuple(r for r in rows6 if r not in A_rows)
        for A_cols in combinations(live_col_idxs, 3):
            B_cols = tuple(c for c in live_col_idxs if c not in A_cols)
            # Check (c): M[B, A'] all zeros
            if any(M[r][c] != 0 for r in B_rows for c in A_cols):
                continue
            # Check (a)
            MA = Matrix([[M[r][c] for c in A_cols] for r in A_rows])
            dA = MA.det()
            if dA == 0:
                continue
            # Check (b)
            MB = Matrix([[M[r][c] for c in B_cols] for r in B_rows])
            dB = MB.det()
            if dB == 0:
                continue
            candidates.append((A_rows, A_cols, B_rows, B_cols, dA, dB))

print(f'Total candidates: {len(candidates)}')
# Print first few
for tup in candidates[:5]:
    print(tup)
