    5	 *   1  PUSH1       push 1
    6	 *   2  PUSH_N      push current emit-count (out_count)
    7	 *   3  INC         TOS += 1 (saturating at INT_CAP)
    8	 *   4  ADD         pop a, b; push min(a+b, INT_CAP)
    9	 *   5  SUB         pop a, b; push max(b-a, 0)
    10	 *   6  MUL         pop a, b; push min(a*b, INT_CAP)
    11	 *   7  SHR1        TOS >>= 1
    12	 *   8  LOG2        TOS <- floor(log2(TOS))   (log2(0) := 0)
    13	 *   9  LI          pop a; push floor(a / log a) for a >= 2 else 0
    14	 *   a  DIV_LOG     pop a, b; push floor(b / log max(a, 2))
    15	 *   b  GEO_SUM     pop a; push 1 + a + a^2 + ... while sum <= T_MAX
    16	 *   c  DUP         duplicate TOS
    17	 *   d  EMIT_S      pop a; emit (a & 1) bit
    18	 *   e  EMIT0       emit 0 bit
    19	 *   f  HALT        stop
    20	 *
    21	 * Programs of length L (in nibbles) loop: pc wraps to 0 when reaching L.
    22	 *
    23	 * Returns the count of bits emitted (<= target_len).  Sets *out_bits to
    24	 * the LSB-first packed bit pattern, *steps_out to the number of executed
    25	 * instructions when termination occurred.
    26	 */
