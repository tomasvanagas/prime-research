The formula matches V_p + V_{2p} primitive energy to 4-5 decimals. Let me extend to d=22 and write the full derivation.
  [Bash] timeout 600 python3 -c "
import numpy as np
import math
import time

def sieve(N):
    is_p = np.ones(N + 1, dtype=bool)
    is_p[:2] = False
    for i in range(2, int(N**0.5) + 1):
        if is_p[i]:
            is_p[i * i :: i] = False
    return is_p

def primes_up_to(N):
    return np.nonzero(sieve(N))[0]

def primitive_v_q_energy_direct(prime_list, N, q):
    energy = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1:
            continue
        angle = 2 * np.pi * k * prime_list / q
        sr = float(np.sum(np.cos(angle)))
        si = float(np.sum(np.sin(angle)))
        contrib = (sr*sr + si*si) / N
        energy += contrib
    return energy

t0 = time.time()
d = 22
N = 2 ** d
print(f'Sieve N={N}...')
primes = primes_up_to(N)
pi_N = len(primes)
print(f'pi(N)={pi_N}, t={time.time()-t0:.1f}s')

print(f'\\n=== d={d} N={N} pi(N)={pi_N} ===')
for p in [3, 5, 7, 11, 13]:
    e_p = primitive_v_q_energy_direct(primes, N, p)
    e_2p = primitive_v_q_energy_direct(primes, N, 2 * p)
    pred = 2 * pi_N ** 2 / ((p - 1) * N)
    log2N = math.log(N) ** 2
    K = (e_p + e_2p) * p * log2N / N
    K_pred = pred * p * log2N / N
    K_asymp = 2 * p / (p - 1)
    pi_log_N_ratio = pi_N * math.log(N) / N
    K_finite = K_asymp * pi_log_N_ratio**2
    print(f'  p={p}: V_p={e_p:.2f}  V_2p={e_2p:.2f}  sum={e_p+e_2p:.2f}  pred={pred:.2f}  ratio={(e_p+e_2p)/pred:.4f}')
    print(f'         K_emp={K:.3f}, K_finite={K_finite:.3f}, K_asymp={K_asymp:.3f}, pi*logN/N = {pi_log_N_ratio:.4f}')
