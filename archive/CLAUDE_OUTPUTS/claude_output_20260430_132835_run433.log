import csv, math
import numpy as np

trows = []
with open('experiments/analytic/k_tuple_batched/slot4_t_delta.csv') as f:
    r = csv.DictReader(f)
    for row in r:
        trows.append({'w': int(row['w']), 'K': int(row['K']), 'Delta': float(row['Delta']), 'log_w': float(row['log_w'])})

# Fit on ALL points (K >= 50)
data = [r for r in trows if r['K'] >= 50]
n = len(data)
print(f'Data: K from {data[0]["K"]} to {data[-1]["K"]}, n={n}')

C2 = 0.6601629382
C2sq = C2*C2

# Targets
targets = {
    '12 C_2^2': 12*C2sq,
    '24 C_2^2': 24*C2sq,
    '24 C_2^2 / 2': 12*C2sq,
    '4 C_2^2 * pi^2/2': 4*C2sq*math.pi**2/2,
}

def fit_model(name, model_fn, n_params):
    """model_fn(log_w) returns design row. Fit y=Delta/w."""
    X = []
    y = []
    for r in data:
        X.append(model_fn(r['log_w']))
        y.append(r['Delta']/r['w'])
    X = np.array(X)
    y = np.array(y)
    beta, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
    pred = X @ beta
    res = y - pred
    rms = np.sqrt(np.mean(res**2))
    max_rel = np.max(np.abs(res / y))
    print(f'{name}:')
    for j, b in enumerate(beta):
        print(f'   c{j} = {b:+.6f}')
    print(f'   rms residual = {rms:.4f},  max rel res = {max_rel:.2e}')
    return beta, rms

# Model 1: Delta/w = -alpha log w + beta
print('\n=== Model 1: Delta/w = a log w + b (linear) ===')
fit_model('M1', lambda x: [x, 1.0], 2)

# Model 2: Delta/w = a log^2 w + b log w + c
print('\n=== Model 2: Delta/w = a log^2 w + b log w + c (quadratic) ===')
fit_model('M2', lambda x: [x*x, x, 1.0], 3)

# Model 3: Delta/w = a log w * log log w + b log w + c
print('\n=== Model 3: Delta/w = a log w * log log w + b log w + c (log * log log) ===')
fit_model('M3', lambda x: [x*math.log(x), x, 1.0], 3)

# Model 4: 4-param mixed
print('\n=== Model 4: Delta/w = a log w log log w + b log^2 w + c log w + d ===')
fit_model('M4', lambda x: [x*math.log(x), x*x, x, 1.0], 4)

# Model 5: Delta/w = a (log w log log w + linear correction) — test 12 C_2^2 candidate
print('\n=== Model 5: Δ/w = -12 C_2^2 log w log log w + b log w + c (forced coefficient) ===')
target_a = -12*C2sq
X = []
y = []
for r in data:
    yi = r['Delta']/r['w'] - target_a * r['log_w'] * math.log(r['log_w'])
    X.append([r['log_w'], 1.0])
    y.append(yi)
X = np.array(X)
y = np.array(y)
beta, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
pred = X @ beta + target_a * np.array([r['log_w']*math.log(r['log_w']) for r in data])
y_real = np.array([r['Delta']/r['w'] for r in data])
res = y_real - pred
rms = np.sqrt(np.mean(res**2))
print(f'   a = {target_a:+.6f} (forced = -12 C_2^2)')
print(f'   b = {beta[0]:+.6f},  c = {beta[1]:+.6f}')
print(f'   rms residual = {rms:.4f}')

# Test rolling alpha at log log w
print('\n=== Rolling alpha vs log log w ===')
print('K range, log w mid, alpha (linear fit), expected 12 C_2^2 log log w + offset')
bands = [(50, 200), (200, 500), (500, 1000), (1000, 5000),
         (5000, 20000), (20000, 50000), (50000, 200000)]
xs = []
ys = []
for K_lo, K_hi in bands:
    band = [r for r in trows if K_lo <= r['K'] <= K_hi]
    if len(band) < 2: continue
    Xb = np.array([[r['log_w'], 1.0] for r in band])
    yb = np.array([r['Delta']/r['w'] for r in band])
    beta, _, _, _ = np.linalg.lstsq(Xb, yb, rcond=None)
    log_w_mid = sum(r['log_w'] for r in band)/len(band)
    log_log_mid = math.log(log_w_mid)
    alpha = -beta[0]
    xs.append(log_log_mid)
    ys.append(alpha)
    print(f'  K=[{K_lo:>6d}, {K_hi:>6d}]  log_w_mid={log_w_mid:.3f}  log_log={log_log_mid:.3f}  alpha={alpha:.4f}')

# Linear fit alpha(log log w)
xs = np.array(xs); ys = np.array(ys)
slope, intercept = np.polyfit(xs, ys, 1)
print(f'\nLinear fit: alpha = {slope:.4f} log log w + {intercept:.4f}')
print(f'Slope candidates:')
print(f'   24 C_2^2 / log(6) = {24*C2sq/math.log(6):.4f}')
print(f'   12 C_2^2          = {12*C2sq:.4f}')
print(f'   24 C_2^2 / pi     = {24*C2sq/math.pi:.4f}')
print(f'   8 C_2^2           = {8*C2sq:.4f}')

# Direct test: at finite w, what's the contribution -24 C_2^2 sum_{p<=K} 1/(p-2)?
print('\n=== Direct prime sum -24 C_2^2 * sum_{5<=p<=K} 1/(p-2) ===')
def primes_up_to(N):
    sieve = bytearray(b'\x01')*(N+1)
    sieve[0]=sieve[1]=0
    for i in range(2, int(N**.5)+1):
        if sieve[i]:
            sieve[i*i:N+1:i] = b'\x00'*(((N-i*i)//i)+1)
    return [i for i,v in enumerate(sieve) if v]

primes = primes_up_to(300_000)

print(f'  K, sum_{{5<=p<=K}} 1/(p-2), -24 C_2^2 * sum * w_match')
for r in trows:
    if r['K'] not in [50, 500, 5000, 50000, 200000]: continue
    K = r['K']
    psum = sum(1/(p-2) for p in primes if 5 <= p <= K)
    pred_R = -24*C2sq * r['w'] * psum
    pred_Delta_via_R = pred_R - 12*C2sq*r['w']
    print(f'  K={K:>6d}  w={r["w"]}  sum_1/(p-2)={psum:.4f}  pred_Delta={pred_Delta_via_R:.4e}  actual={r["Delta"]:.4e}  ratio={r["Delta"]/pred_Delta_via_R:.3f}')
