import csv, math

rows = []
with open('experiments/analytic/k_tuple_batched/slot4_h_residual.csv') as f:
    r = csv.DictReader(f)
    for row in r:
        rows.append((int(row['K']), int(row['N']), float(row['H_N']), float(row['leading']), float(row['residual']), float(row['log_N'])))

# Fit residual = a log^2(N) + b log(N) + c on tail (K >= 1000)
import numpy as np
tail = [r for r in rows if r[0] >= 1000]
X = np.array([[r[5]**2, r[5], 1.0] for r in tail])
y = np.array([r[4] for r in tail])

# least squares
beta, *_ = np.linalg.lstsq(X, y, rcond=None)
a, b, c = beta
print(f'Fit residual = a log^2(N) + b log(N) + c:')
print(f'   a (log^2)  = {a:+.6f}')
print(f'   b (log)    = {b:+.6f}')
print(f'   c (const)  = {c:+.6f}')

# Compute residuals
res = np.dot(X, beta) - y
print(f'   max |fit residual| = {np.max(np.abs(res)):.4f}')
print(f'   RMS                = {np.sqrt(np.mean(res**2)):.4f}')

# Now compute Delta(w) = T(w) - 2C_2^2 w^2 = sum_{m=1}^{w-1} H(m) - 2C_2^2 w^2
# = sum (H(m) - 4 C_2^2 m) + (sum 4 C_2^2 m - 2 C_2^2 w^2)
# = sum residual(m) + 4 C_2^2 (w-1)w/2 - 2 C_2^2 w^2
# = sum residual + 2 C_2^2 (w-1) w - 2 C_2^2 w^2
# = sum residual - 2 C_2^2 w
# 
# Wait let me redo. T(w) = sum_{m=1}^{w-1} H(m), and sum_{m=1}^{w-1} 4 C_2^2 m = 4 C_2^2 (w-1)w/2.
# So sum residual(m) = T(w) - 4 C_2^2 (w-1)w/2 = T(w) - 2 C_2^2 w(w-1) = T(w) - 2 C_2^2 w^2 + 2 C_2^2 w.
# Thus Delta(w) = T(w) - 2 C_2^2 w^2 = sum residual(m) - 2 C_2^2 w.
# 
# OK so Delta = (sum of H(m) - 4 C_2^2 m, m from 1 to w-1) - 2 C_2^2 w.
#
# If H(m) - 4 C_2^2 m ~ a log^2 m + b log m + c, then
# sum_{m=1}^{w-1} ~ integral_0^w (a log^2 u + b log u + c) du
#   = a (w log^2 w - 2 w log w + 2 w) + b (w log w - w) + c w
#   = a w log^2 w + (b - 2a) w log w + (-b + 2a + c) w.
#
# Then Delta(w) ~ a w log^2 w + (b - 2a) w log w + (-b + 2a + c - 2 C_2^2) w.
#
# For our fit, a = log^2 coefficient. Note we expect -alpha for the w log w coefficient.
# alpha = -(b - 2a) = 2a - b.

alpha_pred = 2*a - b
print()
print(f'Predicted Delta(w) ~ a w log^2 w + (b-2a) w log w + (...) w')
print(f'   coefficient of w log^2 w = a = {a:+.6f}')
print(f'   coefficient of w log w   = b - 2a = {b - 2*a:+.6f}  =>  alpha_pred (as -coef) = {alpha_pred:.4f}')
print()

# Now check: if the H residual fit is a log^2 + b log + c with these values,
# does it match the observed Delta(w)?
# Sum_{m=1}^{w-1} H_residual(m) should be approximated by integral.
# But H_residual is at admissible m, summed only every 6.
# Let me actually compute it: Delta(w) = sum_{m=1}^{w-1} H(m) - 2 C_2^2 w^2.
# But we have H at admissible m. H is constant between consecutive admissible m's.

# Read T_delta data for comparison
trows = []
with open('experiments/analytic/k_tuple_batched/slot4_t_delta.csv') as f:
    r = csv.DictReader(f)
    for row in r:
        trows.append((int(row['w']), int(row['K']), float(row['T_w']), float(row['leading']), float(row['Delta']), float(row['log_w'])))

print(f'Compare Delta(w) to predicted from H-residual fit:')
print(f'  {\"w\":>8s} {\"Delta_emp\":>14s} {\"Delta_pred_log2\":>16s} {\"diff\":>10s}')
C2 = 0.6601629382
C2_sq = C2*C2
for w, K, T, lead, Delta, log_w in trows:
    # Predicted from integral of fit on H_residual:
    pred = a * w * log_w**2 + (b - 2*a) * w * log_w + (-b + 2*a + c - 2*C2_sq) * w
    print(f'  {w:>8d} {Delta:>14.4f} {pred:>16.4f} {Delta-pred:>10.4f}')
"

