import csv, math
import numpy as np

trows = []
with open('experiments/analytic/k_tuple_batched/slot4_t_delta.csv') as f:
    r = csv.DictReader(f)
    for row in r:
        trows.append((int(row['w']), int(row['K']), float(row['T_w']), float(row['leading']), float(row['Delta']), float(row['log_w'])))

# Try fits with various tail cutoffs
C2 = 0.66016293819077
C2sq = C2*C2

print('Fits Delta(w) = w (a log^2 w + b log w + c):')
for K_min in [100, 500, 1000, 5000, 10000]:
    tail = [r for r in trows if r[1] >= K_min]
    if len(tail) < 4: continue
    X = np.array([[r[5]**2 * r[0], r[5] * r[0], r[0]] for r in tail])
    y = np.array([r[4] for r in tail])
    beta, *_ = np.linalg.lstsq(X, y, rcond=None)
    a, b, c = beta
    res = np.dot(X, beta) - y
    print(f'K_min={K_min:>5d}, n={len(tail):>2d}: a={a:+.6f}  b={b:+.6f}  c={c:+.6f}  rel_res={np.max(np.abs(res/y)):.2e}')

print()
print('Without log^2 term (Delta = w (b log w + c)):')
for K_min in [100, 500, 1000, 5000, 10000]:
    tail = [r for r in trows if r[1] >= K_min]
    if len(tail) < 3: continue
    X = np.array([[r[5] * r[0], r[0]] for r in tail])
    y = np.array([r[4] for r in tail])
    beta, *_ = np.linalg.lstsq(X, y, rcond=None)
    b, c = beta
    res = np.dot(X, beta) - y
    print(f'K_min={K_min:>5d}: alpha=-{b:.4f} ({b:+.4f})  beta={c:+.4f}  rel_res={np.max(np.abs(res/y)):.2e}')

print()
# Pure log^2 model: Delta = -A w log^2 w + (...)
# Maybe alpha is -d/d(log w) [Delta/w] which from the data is
# computed numerically.
print('Numerical d(Delta/w)/d(log w):')
for i in range(1, len(trows)):
    w1, _, _, _, D1, lw1 = trows[i-1]
    w2, _, _, _, D2, lw2 = trows[i]
    s = (D2/w2 - D1/w1) / (lw2 - lw1)
    log_w_mid = (lw1 + lw2)/2
    print(f'  log_w_mid={log_w_mid:6.3f}  d(Delta/w)/d(log w)={s:+.4f}  (=> if a log^2 w model, slope = 2a log w + b)')
