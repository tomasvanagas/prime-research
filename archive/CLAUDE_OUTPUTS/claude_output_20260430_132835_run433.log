  [Bash] python3 -c "
import csv, math

vals = []
with open('experiments/analytic/k_tuple_batched/slot3_s4_profile.csv') as f:
    r = csv.DictReader(f)
    for row in r:
        vals.append((int(row['k']), int(row['m']), float(row['S_4(0,2,m,m+2)'])))

# Twin-prime constant
def twin_prime_constant(P=200000):
    primes = []
    sieve = bytearray(b'\x01')*(P+1)
    sieve[0]=sieve[1]=0
    for i in range(2, int(P**.5)+1):
        if sieve[i]:
            sieve[i*i:P+1:i] = b'\x00'*(((P-i*i)//i)+1)
    primes = [i for i,v in enumerate(sieve) if v]
    val = 1.0
    for p in primes:
        if p < 3: continue
        val *= (1.0 - 1.0/(p-1)**2)
    return val

C2 = twin_prime_constant()
target = 24 * C2 * C2  # 10.4596
print(f'C_2 = {C2:.12f}')
print(f'24 C_2^2 = {target:.12f}')
print(f'4 C_2^2 = {4*C2*C2:.12f}')

# Compute T(w) for w = 6 K + 1 for K = 30, 60, ..., 678
# m ranges 6, 12, ..., 6K. T(w) = sum (w-m) S_4(m). w = 6K+? — we'll align m's exactly.
# Pick w = 6 * K + 5 so all m=6,...,6K are included.

# H(m_max) = sum of S_4 over admissible m up to m_max
# Pick m_max = 6 * K, then H = cumulative sum at K

cum_S4 = 0.0
H_data = []
for k, m, s4 in vals:
    cum_S4 += s4
    H_data.append((m, cum_S4))

# Compute Delta_H(N) := H(N) - 4 C_2^2 * N
print('\\nN, H(N), 4C_2^2*N, H-4C_2^2*N, log(N)')
for k_idx in [10, 30, 60, 100, 200, 300, 400, 500, 600, 678]:
    if k_idx > len(H_data): continue
    m_N, H_N = H_data[k_idx-1]
    leading = 4*C2*C2*m_N
    diff = H_N - leading
    print(f'm={m_N:6d}  H={H_N:10.4f}  leading={leading:10.4f}  diff={diff:9.4f}  log(m)={math.log(m_N):.4f}')

# Compute T(w) for w = 6K+1 (so we sum (w-m) for m = 6, 12, ..., 6K)
print('\\nT(w) computation, with w = 6K+5 (so all m = 6,...,6K included; w-6K=5):')
print('w, K, T, leading, Delta, Delta/(w*log w)')
for K in [30, 60, 100, 200, 300, 400, 500, 600, 678]:
    if K > len(vals): continue
    w = 6*K + 5
    T = 0.0
    for j in range(K):
        m = 6 * (j+1)
        s4 = vals[j][2]
        T += (w - m) * s4
    leading = 2 * C2*C2 * w * w
    Delta = T - leading
    print(f'w={w:5d} K={K:4d} T={T:14.4f} leading={leading:14.4f} Delta={Delta:11.4f} alpha_est={-Delta/(w*math.log(w)):.4f}')
"

