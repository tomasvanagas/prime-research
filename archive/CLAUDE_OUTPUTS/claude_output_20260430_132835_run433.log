import csv, math
import numpy as np

trows = []
with open('experiments/analytic/k_tuple_batched/slot4_t_delta.csv') as f:
    r = csv.DictReader(f)
    for row in r:
        trows.append((int(row['w']), int(row['K']), float(row['T_w']), float(row['leading']), float(row['Delta']), float(row['log_w'])))

# Fit Delta(w) = w * (a log^2 w + b log w + c) on tail (K >= 1000)
tail = [r for r in trows if r[1] >= 1000]
print(f'Fit on {len(tail)} tail points (K >= 1000):')
X = np.array([[r[5]**2 * r[0], r[5] * r[0], r[0]] for r in tail])
y = np.array([r[4] for r in tail])
beta, *_ = np.linalg.lstsq(X, y, rcond=None)
a, b, c = beta
print(f'  Delta(w) = w * (a log^2 w + b log w + c):')
print(f'    a (log^2) = {a:+.6f}')
print(f'    b (log)   = {b:+.6f}')
print(f'    c (const) = {c:+.6f}')
res = np.dot(X, beta) - y
print(f'  max |fit residual| = {np.max(np.abs(res)):.4f}')
print(f'  rel max = {np.max(np.abs(res/y)):.4e}')

# Implied H residual fit (by differentiation):
# Delta(w) = ∫_0^w residual(u) du - 2 C_2^2 w (boundary term).
# So d/dw Delta = residual(w) - 2 C_2^2.
# Delta(w) = a w log^2 w + b w log w + c w
# d/dw Delta = a (log^2 w + 2 log w) + b (log w + 1) + c
#            = a log^2 w + (2a + b) log w + (b + c)
# Matches H_residual(w) - 2 C_2^2.
print()
print(f'Implied H_residual(w):')
print(f'  H_residual(w) = a log^2 w + (2a + b) log w + (b + c + 2 C_2^2)')
C2 = 0.66016293819077
C2sq = C2*C2
print(f'  log^2 coeff = {a:+.6f}')
print(f'  log coeff   = {2*a + b:+.6f}')
print(f'  const       = {b + c + 2*C2sq:+.6f}')
print()

# Test specific candidates for a
print(f'Candidates for a (the log^2 coefficient in Delta/w):')
candidates = [
    ('-1', -1.0),
    ('-log(6) C_2^2', -math.log(6) * C2sq),
    ('-2 C_2^2', -2*C2sq),
    ('-pi^2/6 C_2^2', -math.pi**2/6 * C2sq),
    ('-C_2', -C2),
    ('-C_2^2 * something', None),
    ('-1/2', -0.5),
    ('-2/log(6)', -2/math.log(6)),
    ('-4/log(6)^2 * C_2^2', -4/math.log(6)**2 * C2sq),
]
for name, val in candidates:
    if val is not None:
        diff = abs(a - val)
        rel = diff / abs(a)
        print(f'  {name:<30s} = {val:+.6f}   |a - val|/|a| = {rel:.4e}')
"

