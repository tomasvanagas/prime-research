  [Bash] cat << 'EOF' > /tmp/verify_d22_p13.py
"""Verify the d=22 and p=13 cells from S166's table that the existing
spike_gallagher_proof.py does NOT compute."""
import math
import numpy as np


def sieve(N):
    is_p = np.ones(N + 1, dtype=bool); is_p[:2] = False
    for i in range(2, int(N**0.5) + 1):
        if is_p[i]: is_p[i*i::i] = False
    return np.nonzero(is_p)[0]


def diag_energy(prime_list, N, q):
    e = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1: continue
        a = 2*np.pi*k*prime_list/q
        e += (float(np.sum(np.cos(a)))**2 + float(np.sum(np.sin(a)))**2)/N
    return e


# d=22 (N=4M) vs claim:
# d=22: p=3 → emp 20881.27, pred 20881.80
#        p=5 → emp 10440.50, pred 10440.90
#        p=7 → emp 6960.26, pred 6960.60
#        p=11 → emp 4176.06, pred 4176.36
#        p=13 → ?? (not in synthesis but column claim)

print("d=22 row (synthesis claim):")
N = 2**22
primes = sieve(N)
pi_N = len(primes)
print(f"  N={N}, pi(N)={pi_N}")
for p in [3, 5, 7, 11, 13]:
    e_p = diag_energy(primes, N, p)
    e_2p = diag_energy(primes, N, 2*p)
    s = e_p + e_2p
    pred = 2 * pi_N**2 / ((p-1) * N)
    ratio = s / pred
    print(f"  p={p}: emp={s:.2f}, pred={pred:.2f}, ratio={ratio:.5f}")

# p=13 across all d to verify the p=13 column claim:
print("\np=13 column (synthesis claim):")
for d in [14, 16, 18, 20, 22]:
    N = 2**d
    primes = sieve(N)
    pi_N = len(primes)
    e_p = diag_energy(primes, N, 13)
    e_2p = diag_energy(primes, N, 26)
    s = e_p + e_2p
    pred = 2 * pi_N**2 / (12 * N)
    print(f"  d={d}: pi(N)={pi_N}, emp={s:.2f}, pred={pred:.2f}, ratio={s/pred:.5f}")
