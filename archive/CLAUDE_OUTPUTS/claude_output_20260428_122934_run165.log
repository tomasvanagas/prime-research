"""Independent verification of S166 theorem. 

Theorem claim:
  E(p, N) = ||P_{V_p^prim ⊕ V_{2p}^prim} chi_P||^2 = 2 (pi(N) - O(1))^2 / ((p-1) N) + O(p Var(p,N)/N)

Tests:
1. Compute E(p, N) using a fresh sieve + DIRECT Fourier sums; cross-check.
2. Check the OFFSET (does using p-1 vs 1 in the prediction matter?).
3. Compute actual subspace projection (via Gram matrix) at small N to check
   if "Sigma|S|^2/N" really equals the L^2-projection energy. If not, what's
   the gap?
4. Check edge case: p=2 (where 2p = 4 — degenerate).
5. Check the Ramanujan sum claim c_{2p}(k) = +1 by computing it directly
   for k coprime to 2p.
"""
import math
from sympy import primerange, sieve as sympy_sieve, totient, mobius
import numpy as np


def primes_le(N):
    """Use sympy as an INDEPENDENT sieve."""
    return list(primerange(2, N + 1))


def fourier_S(prime_list, q, k):
    """S_q^k = sum_p exp(2 pi i k p / q)."""
    s = 0+0j
    for p in prime_list:
        s += np.exp(2j * np.pi * k * p / q)
    return s


def diagonal_energy(prime_list, N, q):
    """Sum_{k coprime to q} |S_q^k|^2 / N."""
    e = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1:
            continue
        S = fourier_S(prime_list, q, k)
        e += (abs(S)**2) / N
    return e


def true_subspace_energy(prime_list, N, q_list):
    """Compute the actual L^2-energy of chi_P projected onto the span
    of all characters at frequencies k/q for q in q_list and k coprime to q.
    
    Returns (true_energy, diagonal_energy_sum).
    """
    # Collect characters
    chars = []
    for q in q_list:
        for k in range(1, q):
            if math.gcd(k, q) != 1:
                continue
            v = np.exp(2j * np.pi * k * np.arange(1, N+1) / q)
            chars.append(v)
    M = np.array(chars)  # rows = characters
    
    # chi_P
    chi = np.zeros(N, dtype=np.complex128)
    for p in prime_list:
        if 1 <= p <= N:
            chi[p - 1] = 1.0
    
    # Inner products
    inners = M @ chi  # length = number of chars
    
    # Gram matrix
    G = M @ M.conj().T  # complex Hermitian
    
    # Solve for projection: coeffs = G^{-1} inners. Energy = inners^* coeffs.
    coeffs = np.linalg.solve(G, inners)
    true_energy = float(np.real(np.vdot(inners, coeffs)))
    
    # Diagonal energy = sum |inners_i|^2 / G[i,i]
    diag_energy = float(np.real(np.sum(np.abs(inners)**2 / np.diag(G))))
    return true_energy, diag_energy


def ramanujan_sum_check(p):
    """Check c_{2p}(k) = +1 for k coprime to 2p (claim of S166)."""
    q = 2 * p
    results = {}
    for k in range(1, q):
        if math.gcd(k, q) != 1:
            continue
        # Direct: c_q(k) = sum_{a coprime to q} exp(2 pi i k a / q)
        s = 0+0j
        for a in range(1, q):
            if math.gcd(a, q) != 1:
                continue
            s += np.exp(2j * np.pi * k * a / q)
        results[k] = s
    return results


def main():
    print("=" * 60)
    print("S166 Independent Verification")
    print("=" * 60)
    
    # Test 1: Verify Ramanujan sum c_{2p}(k) = +1 for k coprime to 2p.
    print("\n--- Test 1: Ramanujan sum c_{2p}(k) for k coprime to 2p ---")
    for p in [3, 5, 7]:
        results = ramanujan_sum_check(p)
        print(f"p={p}, q=2p={2*p}:")
        for k, c in results.items():
            print(f"  c_{{{2*p}}}({k}) = {c:.6f} (claim: +1)")
    
    # Test 2: Reproduce diagonal-energy table independently.
    print("\n--- Test 2: Independent reproduction at N=2^14, 2^16 ---")
    for d in [10, 12, 14]:
        N = 2**d
        primes = primes_le(N)
        pi_N = len(primes)
        print(f"\nd={d}, N={N}, pi(N)={pi_N}")
        for p in [3, 5, 7]:
            e_p = diagonal_energy(primes, N, p)
            e_2p = diagonal_energy(primes, N, 2*p)
            stack_emp = e_p + e_2p
            
            # Predicted: 2 (pi(N) - 1)^2 / ((p-1) N) — note: paper uses (pi(N) - O(1)).
            # Test BOTH pi(N) and pi(N)-1 in the prediction.
            pred_naive = 2 * pi_N**2 / ((p-1) * N)
            pred_offset1 = 2 * (pi_N - 1)**2 / ((p-1) * N)
            pred_offset2 = 2 * (pi_N - 2)**2 / ((p-1) * N)
            
            print(f"  p={p}: V_p={e_p:.4f}, V_{{2p}}={e_2p:.4f}, sum={stack_emp:.4f}")
            print(f"    pred (pi(N)^2/(p-1)/N)*2  = {pred_naive:.4f}, ratio = {stack_emp/pred_naive:.5f}")
            print(f"    pred ((pi(N)-1)^2): {pred_offset1:.4f}, ratio = {stack_emp/pred_offset1:.5f}")
            print(f"    pred ((pi(N)-2)^2): {pred_offset2:.4f}, ratio = {stack_emp/pred_offset2:.5f}")
    
    # Test 3: True subspace projection vs diagonal sum.
    print("\n--- Test 3: True subspace energy vs diagonal-sum at small N ---")
    for d in [8, 10]:
        N = 2**d
        primes = primes_le(N)
        pi_N = len(primes)
        print(f"\nd={d}, N={N}, pi(N)={pi_N}")
        for p in [3, 5, 7]:
            true_e, diag_e = true_subspace_energy(primes, N, [p, 2*p])
            pred = 2 * pi_N**2 / ((p-1) * N)
            print(f"  p={p}: TRUE-projection energy = {true_e:.4f}, "
                  f"diagonal sum = {diag_e:.4f}, predicted = {pred:.4f}")
            print(f"    diag/true = {diag_e/true_e:.5f}, true/pred = {true_e/pred:.5f}")
    
    # Test 4: Edge case p=2 (degenerate, since 2p = 4).
    print("\n--- Test 4: Edge case p=2 (where 2p=4 not squarefree) ---")
    for d in [12, 14]:
        N = 2**d
        primes = primes_le(N)
        pi_N = len(primes)
        e_p = diagonal_energy(primes, N, 2)
        e_2p = diagonal_energy(primes, N, 4)
        # mu(4) = 0, so theorem's main term should fail at q=4
        pred = 2 * pi_N**2 / ((2-1) * N)  # p-1 = 1
        print(f"  d={d}: V_2={e_p:.4f}, V_4={e_2p:.4f}, sum={e_p+e_2p:.4f}, pred={pred:.4f}")
        print(f"    Note: mu(4) = {mobius(4)} (= 0), so theorem says V_4 main term = 0.")


if __name__ == "__main__":
    main()
