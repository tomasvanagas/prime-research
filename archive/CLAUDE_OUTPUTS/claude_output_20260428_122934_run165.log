"""Test the asymptotic K(p) = 2p/(p-1) claim by going to LARGER N. Use FFT-based
sieve and direct Fourier sum (vectorized) to handle N up to 2^24.
"""
import math
import numpy as np


def sieve(N):
    is_p = np.ones(N + 1, dtype=bool)
    is_p[:2] = False
    for i in range(2, int(N**0.5) + 1):
        if is_p[i]:
            is_p[i*i::i] = False
    return np.nonzero(is_p)[0]


def diagonal_energy(prime_list, N, q):
    e = 0.0
    for k in range(1, q):
        if math.gcd(k, q) != 1:
            continue
        angle = 2 * np.pi * k * prime_list / q
        S_re = float(np.sum(np.cos(angle)))
        S_im = float(np.sum(np.sin(angle)))
        e += (S_re*S_re + S_im*S_im) / N
    return e


def main():
    print("d  | N         | pi(N)    | p | K_emp(p,N) | K_pred(N) | K_inf | (Kemp-Kinf)/Kinf")
    for d in [14, 16, 18, 20, 22, 24]:
        N = 2**d
        primes = sieve(N)
        pi_N = len(primes)
        for p in [3, 5, 7]:
            e_p = diagonal_energy(primes, N, p)
            e_2p = diagonal_energy(primes, N, 2*p)
            stack_emp = e_p + e_2p
            log2N = math.log(N)**2
            K_emp = stack_emp * p * log2N / N
            
            # Asymptotic K_inf = 2p/(p-1)
            K_inf = 2 * p / (p - 1)
            # Finite-N predicted K = 2p/(p-1) * (pi(N) log N / N)^2
            K_pred = K_inf * (pi_N * math.log(N) / N)**2
            
            ratio = (K_emp - K_inf) / K_inf
            print(f"{d:2d} | {N:9d} | {pi_N:8d} | {p} | {K_emp:.5f}    | {K_pred:.5f}   | {K_inf:.4f} | {ratio:+.4f}")


if __name__ == "__main__":
    main()
