from pathlib import Path
sys.path.insert(0, str(Path('experiments/proposals').resolve()))
from pslq_delta_basis import compute_delta_hp, build_basis, load_zeros
import numpy as np
from mpmath import mp, mpf

mp.dps = 30
N = 200
delta, pn = compute_delta_hp(N, dps=30)
y = np.array([float(d) for d in delta])
print(f'delta range: [{y.min():.2f}, {y.max():.2f}], std={y.std():.2f}')

for K in (5, 10, 20, 50):
    gammas = load_zeros(K)
    rows = [build_basis(n, gammas) for n in range(1, N+1)]
    A = np.array([[float(x) for x in r] for r in rows])
    coef, _, _, _ = np.linalg.lstsq(A, y, rcond=None)
    pred = A @ coef
    err = y - pred
    print(f'K={K:>3} ({A.shape[1]} basis funcs): RMS={(err**2).mean()**0.5:.4f}  max|err|={abs(err).max():.4f}  R^2={1 - err.var()/y.var():.4f}')
