import sys
sys.path.insert(0, 'experiments/sieve/pi_mod_q_fixed')
from liouville_modular_structure import sieve_omega, compute_summatories
import numpy as np
N = 1000
Omega, spf = sieve_omega(N)
S = compute_summatories(Omega)
# Sanity: pi(10) = 4
print('pi(10) =', int(S['pi'][10]), 'expected 4')
print('pi(100) =', int(S['pi'][100]), 'expected 25')
print('pi(1000) =', int(S['pi'][1000]), 'expected 168')
# Sanity: L(x) and x parity match
n_arr = np.arange(N+1)
matches = ((S['L'] % 2) == (n_arr % 2)).all()
print('L(x) parity == x parity for all x in [0,N]:', matches)
# Sanity: pi == A - C3
diff = S['pi'] - (S['A'] - S['C3'])
# At small x, n=1 has Omega=0 (even) so it's in B not A and not C3. n=0 doesn't exist in pi.
# pi[0]=0, A[0]=0, C3[0]=0; pi[1]=0, A[1]=0, C3[1]=0; pi[2]=1, A[2]=1, C3[2]=0; ok.
print('max |pi - (A - C3)| =', int(np.abs(diff).max()))
print('Omega[1]=', int(Omega[1]), '(expected 0)')
print('lambda[1]=', 1 if Omega[1]%2==0 else -1)
"

