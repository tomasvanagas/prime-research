import sys
sys.path.insert(0, 'experiments/analytic/k_tuple_batched')
from slot2_cross_x import sieve_eratosthenes, singular_series, hl_window
import numpy as np, math

# Tiny check: pi_2(100, 50) for twin primes (0,2)
is_p = sieve_eratosthenes(200)
arr = np.frombuffer(is_p, dtype=np.uint8)
H = (0,2)
pair = arr[0:150].copy() & arr[2:152]
# count of i in [50, 100] with i, i+2 both prime
cnt = int(pair[50:101].sum())
# brute force
brute = sum(1 for i in range(50, 101) if is_p[i] and is_p[i+2])
print(f'sieve count = {cnt}, brute = {brute}, OK' if cnt==brute else 'MISMATCH')

# Test singular series for twin
s2 = singular_series((0,2))
print(f'C((0,2)) = {s2:.6f}, expected ~1.32032')

# HL window test
print(f'HL((0,2), x=10^4, w=200) = {hl_window(s2, 10000, 200, 2):.4f}')
"

