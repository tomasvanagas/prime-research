import math, sys
sys.path.insert(0, '/apps/aplikacijos/prime-research/experiments/analytic/batched_q_amortisation')
import mpmath as mp
from slot4_composite_q_multi_axis_fft import crt_decomp, build_crt_log_table

mp.mp.dps = 50

def L_func(q, char_index_tuple, s, N_factor=2000):
    primes, group_orders, prim_roots = crt_decomp(q)
    log_table = build_crt_log_table(q, primes, prim_roots)
    omega = [mp.exp(2j * mp.pi / order) for order in group_orders]
    N = int(N_factor * (1 + abs(mp.im(s))))
    total = mp.mpc(0)
    for n in range(1, N + 1):
        if math.gcd(n, q) != 1: continue
        tup = log_table[n % q]
        val = mp.mpc(1)
        for i, k in enumerate(tup):
            val *= omega[i] ** ((char_index_tuple[i] * k) % group_orders[i])
        total += val / mp.mpc(n) ** s
    return total

q = 15
char_idx = (1, 1)

# Use mpmath findroot to nail a zero starting from t=2.75
# Hardy Z is real on critical line; sign change gives a clean root
# But we need a real-valued function. Use Im(L) (one component) — for complex
# chi this might not change sign exactly at a zero of L.
# Use |L|^2 minimisation instead.

# Actually easier: use findroot on L directly (complex root finding via secant)
def L_at(t):
    return L_func(q, char_idx, mp.mpc(mp.mpf("0.5"), t), N_factor=5000)

# Try near 2.75
for guess in [2.5, 2.75, 3.0]:
    try:
        # Use findroot in complex
        # find t s.t. L(0.5 + i*t) = 0
        zero_t = mp.findroot(lambda t: L_at(t), mp.mpf(guess), tol=1e-20)
        L_val = L_at(zero_t)
        print(f"  start={guess:.3f}  zero at t={float(zero_t):.6f}  |L|={float(abs(L_val)):.3e}")
    except Exception as e:
        print(f"  start={guess:.3f}  failed: {e}")

print("\nFine grid around t=2.7 (high precision):")
for i in range(11):
    t = 2.65 + 0.01 * i
    L = L_at(t)
    print(f"  t={t:.3f}  |L|={float(abs(L)):.6e}")
