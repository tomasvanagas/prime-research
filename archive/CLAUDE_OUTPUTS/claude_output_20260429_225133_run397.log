"""Directly evaluate |L(0.5+it, chi)| at slot-4 candidates and compare to
mpmath candidates, to validate which set are actual zeros."""
import math
import sys
import os
sys.path.insert(0, '/apps/aplikacijos/prime-research/experiments/analytic/batched_q_amortisation')

import mpmath as mp
from slot4_composite_q_multi_axis_fft import (
    crt_decomp, build_crt_log_table, factor_squarefree, euler_phi
)

mp.mp.dps = 30

def L_func_high_precision(q, char_index_tuple, s, N_factor=200):
    primes, group_orders, prim_roots = crt_decomp(q)
    log_table = build_crt_log_table(q, primes, prim_roots)
    omega = [mp.exp(2j * mp.pi / order) for order in group_orders]
    
    N = int(N_factor * (1 + abs(mp.im(s))))
    total = mp.mpc(0)
    for n in range(1, N + 1):
        if math.gcd(n, q) != 1:
            continue
        tup = log_table[n % q]
        val = mp.mpc(1)
        for i, k in enumerate(tup):
            j = char_index_tuple[i]
            val *= omega[i] ** ((j * k) % group_orders[i])
        total += val / mp.mpc(n) ** s
    return total

# Test at q=15, char (1,1)
q = 15
char_idx = (1, 1)
print(f"=== q={q}, char {char_idx} ===\n")

slot4_candidates = [2.697, 5.229, 8.383, 10.232, 11.896]
mpmath_candidates = [2.575, 2.739, 5.241, 8.423, 10.189]

print("slot-4 candidates:")
for t in slot4_candidates:
    s = mp.mpc(0.5, t)
    L = L_func_high_precision(q, char_idx, s)
    print(f"  t={t:8.4f}  |L|={abs(L):.6e}  arg(L)={float(mp.arg(L)):.4f}")

print("\nmpmath candidates:")
for t in mpmath_candidates:
    s = mp.mpc(0.5, t)
    L = L_func_high_precision(q, char_idx, s)
    print(f"  t={t:8.4f}  |L|={abs(L):.6e}  arg(L)={float(mp.arg(L)):.4f}")

# Also evaluate at fine grid around slot-4's first claim 2.697 vs mpmath's 2.575
print("\nFine grid around small-t region (t in [2.0, 3.5]):")
for i in range(31):
    t = 2.0 + 0.05 * i
    s = mp.mpc(0.5, t)
    L = L_func_high_precision(q, char_idx, s)
    print(f"  t={t:5.2f}  |L|={abs(L):.6e}")
