    100	# ---------------------------------------------------------------------------
    101	# Fast singular-series for tuple {0, 2, m, m+2}, m admissible (m % 6 == 0)
    102	# ---------------------------------------------------------------------------
    103	#
    104	# At each prime p:
    105	#   p = 2: factor = 8 (m even, ν=1)
    106	#   p = 3: factor = 27/16 (m ≡ 0 mod 3, ν=2)
    107	#   p >= 5: factor depends on m mod p as
    108	#       m mod p == 0:        f_p(0) = (1 - 2/p) / (1-1/p)^4
    109	#       m mod p == 2 or p-2: f_p(2) = (1 - 3/p) / (1-1/p)^4
    110	#       otherwise:           f_p(other) = (1 - 4/p) / (1-1/p)^4
    111	#
    112	# For large p, f_p(other) ~ 1 - 4/p^2 + O(1/p^3).  We cache f_p(other) for
    113	# every prime up to PRIME_BOUND, and only update factors for primes that
    114	# divide m, m-2, or m+2 (the "special" primes for that m).  The "other"
    115	# product at every prime is a fixed constant for all m; it is precomputed
    116	# once.
    117	#
    118	# Concretely we write
    119	#     S_4(m) = OTHER_PRODUCT * prod_{p | m, p>=5} (f_p(0)/f_p(other))
    120	#                            * prod_{p | m-2 or p | m+2, p>=5}
    121	#                                            (f_p(2)/f_p(other))
    122	# for m admissible with m >= 6.
    123	#
    124	# OTHER_PRODUCT = factor at p=2 (=8) * factor at p=3 (=27/16) *
    125	#                 prod_{p>=5} f_p(other).
    126	
    127	# Precompute per-prime factors and ratios.
    128	F_OTHER: dict[int, float] = {}       # f_p(other), p >= 5
    129	RATIO_F0_OVER_FOTHER: dict[int, float] = {}   # f_p(0)/f_p(other)
