  [Bash] cat > /tmp/verify_chi_P_I3.py << 'EOF'
import sys
sys.path.insert(0, '/apps/aplikacijos/prime-research/experiments/algebraic/gct_chi_p_orbit')
from plethysm_subframe_I3 import (
    weak_compositions, build_action_structure, generate_orbit_samples,
    chi_P_d3_n4, poly_to_coef_vec
)
import numpy as np
import sympy as sp
import time

n, d = 4, 3
M = 3000
syms_full = sp.symbols(f"x1:{n+1}")
basis_d = list(weak_compositions(d, n))
basis_dict = {tuple(a): i for i, a in enumerate(basis_d)}
N = len(basis_d)
print(f"N = {N}, ambient dim Sym^3(Sym^3 V_4) = {N*(N+1)*(N+2)//6}")

structure = build_action_structure(n, d, basis_d, basis_dict)
f_vec = poly_to_coef_vec(chi_P_d3_n4(syms_full), basis_d, syms_full)

print("Generating orbit samples...")
t0 = time.time()
orbit_coefs = generate_orbit_samples(f_vec, structure, N, n, M, seed=999, coef_max=2)
print(f"  {time.time()-t0:.1f}s")

# Find largest block: weight γ with most triples
weight_to_triples = {}
for i in range(N):
    for j in range(i, N):
        for k in range(j, N):
            w = tuple(int(basis_d[i][p] + basis_d[j][p] + basis_d[k][p]) for p in range(n))
            weight_to_triples.setdefault(w, []).append((i, j, k))

block_sizes = [(len(plist), w) for w, plist in weight_to_triples.items()]
block_sizes.sort(reverse=True)
print(f"\nTop 5 largest weight blocks:")
for sz, w in block_sizes[:5]:
    print(f"  weight {w}: block size {sz}")

# For the largest block, compute SVD with M=3000 and report singular value distribution
big_w, big_plist = block_sizes[0][1], weight_to_triples[block_sizes[0][1]]
sz = len(big_plist)
print(f"\nLargest block at weight {big_w}, size {sz}")
E = np.empty((M, sz), dtype=np.float64)
for col, (i, j, k) in enumerate(big_plist):
    E[:, col] = orbit_coefs[:, i] * orbit_coefs[:, j] * orbit_coefs[:, k]
s = np.linalg.svd(E, compute_uv=False)
print(f"  SV distribution: top={s[0]:.3e}, bottom={s[-1]:.3e}, ratio={s[-1]/s[0]:.3e}")
print(f"  All SVs: {s}")
tol = max(M, sz) * np.finfo(float).eps * s[0]
rank = int(np.sum(s > tol))
print(f"  tol = {tol:.3e}, rank = {rank} / {sz}, kernel dim = {sz - rank}")

# Also check total dim_I_3 with M=3000
print("\nFull I_3 computation with M=3000:")
total_I3 = 0
total_full = 0
weight_kernels = {}
for w, plist in weight_to_triples.items():
    bs = len(plist)
    total_full += bs
    E_w = np.empty((M, bs), dtype=np.float64)
    for col, (i, j, k) in enumerate(plist):
        E_w[:, col] = orbit_coefs[:, i] * orbit_coefs[:, j] * orbit_coefs[:, k]
    if bs == 1:
        rank = 1 if np.max(np.abs(E_w)) > 1e-10 else 0
    else:
        s = np.linalg.svd(E_w, compute_uv=False)
        scale = s[0] if len(s) > 0 else 1.0
        tol = max(M, bs) * np.finfo(float).eps * max(scale, 1.0)
        rank = int(np.sum(s > tol))
    kdim = bs - rank
    if kdim > 0:
        weight_kernels[w] = kdim
    total_I3 += kdim
print(f"  Total dim I_3 = {total_I3} (out of {total_full})")
print(f"  Non-zero weight kernels: {len(weight_kernels)}")
if weight_kernels:
    for w, k in sorted(weight_kernels.items(), key=lambda x: -x[1])[:5]:
        print(f"    weight {w}: kernel dim {k}")
