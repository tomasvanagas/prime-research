import csv
from collections import defaultdict

with open('paired_kernels_summary.csv') as f:
    rows = list(csv.DictReader(f))

# Build (anchor, K) -> kernel -> ratio_obs/hard
grid = defaultdict(dict)
for r in rows:
    grid[(int(r['anchor_log10']), int(r['K_compute']))][r['kernel']] = float(r['ratio_obs_over_hard'])

kernels = ['hard','paired_hann','paired_triangle','paired_riesz','antipair_03','antipair_05','half_int','boundary_pair']
print(f'{\"(x, K)\":<14} ', end='')
for k in kernels:
    print(f'{k[:12]:>13s}', end='')
print()
for (anc, K) in sorted(grid):
    print(f'10^{anc}, {K:<7d}', end=' ')
    for k in kernels:
        print(f'{grid[(anc, K)][k]:>13.4f}', end='')
    print()

print()
print('Per-kernel mean/min ratio across 12 cells:')
by_kernel = defaultdict(list)
for r in rows:
    by_kernel[r['kernel']].append(float(r['ratio_obs_over_hard']))
for k in kernels:
    if k == 'hard': continue
    rs = by_kernel[k]
