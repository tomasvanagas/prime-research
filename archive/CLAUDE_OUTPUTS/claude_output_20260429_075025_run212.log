import sys
sys.path.insert(0, '.')
from plethysm_subframe_I2 import schur_dim_in_n_vars

# Check S_(4,2) at n=5
print('S_(4,2) at n=5:', schur_dim_in_n_vars((4,2), 5))
print('S_(6,) at n=5:', schur_dim_in_n_vars((6,), 5))
print('S_(2,2,2) at n=5:', schur_dim_in_n_vars((2,2,2), 5))

# Direct manual computation
def schur_dim(lam, n):
    L = list(lam) + [0] * (n - len(lam))
    num = 1
    den = 1
    for i in range(n):
        for j in range(i + 1, n):
            print(f'  (i={i},j={j}): L[i]={L[i]}, L[j]={L[j]}, term={L[i]-L[j]+j-i}, denom_term={j-i}')
            num *= (L[i] - L[j] + j - i)
            den *= (j - i)
    print(f'num={num}, den={den}, ratio={num/den}')
    return num // den

print('Manual S_(4,2) at n=5:')
schur_dim((4,2), 5)
