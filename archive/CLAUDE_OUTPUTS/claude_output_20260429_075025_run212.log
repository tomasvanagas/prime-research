decomp_I2 = schur_decompose_from_weights(weight_I2, n, total_deg=6)
weight_quot = {w: weight_full[w] - weight_I2.get(w, 0) for w in weight_full}
decomp_quot = schur_decompose_from_weights(weight_quot, n, total_deg=6)
decomp_full = schur_decompose_from_weights(weight_full, n, total_deg=6)
print(f'Schur of full Sym^2(Sym^3 V_3): {dict(decomp_full)}')
print(f'Schur of I_2: {dict(decomp_I2)}')
print(f'Schur of Sym^2/I_2: {dict(decomp_quot)}')
