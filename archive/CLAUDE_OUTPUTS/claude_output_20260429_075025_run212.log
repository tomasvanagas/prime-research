import sys, time
sys.path.insert(0, '.')
from plethysm_subframe_I2 import (
    weak_compositions, build_action_structure, multinomial,
    poly_to_coef_vec, f_chi_P_homogenised, det_2_padded, perm_2_padded,
    matched_random_homogenised, x1_cubed,
    weight_dims_of_sym_2_sym_d, schur_decompose_from_weights,
    schur_dim_in_n_vars)
import sympy as sp
import numpy as np
import itertools

# Build a FAST orbit-sample generator by precomputing for each support monomial.
n, d = 5, 4
syms_full = sp.symbols(f'x1:{n+1}')
basis_d = list(weak_compositions(d, n))
basis_dict = {tuple(a): i for i, a in enumerate(basis_d)}
N = len(basis_d)
N2 = N * (N + 1) // 2
print(f'N={N}, N2={N2}', flush=True)

# Build per-alpha contribution structure: for each alpha (input mono), list of (B, coef, beta_idx)
# such that R(g)[beta_idx, alpha_idx] picks up contributions of B with coef * prod g[i,j]^B[i,j].
# We'll batch compute g_powers and contract.
print('Building structure...', flush=True)
t0 = time.time()
# For each alpha_idx, list of (coef, B, beta_idx) entries
per_alpha = {}
for alpha_idx, alpha in enumerate(basis_d):
    rows_per_i = [list(weak_compositions(int(alpha[i]), n)) for i in range(n)]
    entries = []
    for B_rows in itertools.product(*rows_per_i):
        B = np.array(B_rows, dtype=int)
        beta = tuple(B.sum(axis=0).tolist())
        if beta not in basis_dict:
            continue
        beta_idx = basis_dict[beta]
        coef = 1
        for i in range(n):
            row_vals = [int(B[i, j]) for j in range(n)]
            coef *= multinomial(row_vals)
        entries.append((coef, B, beta_idx))
    per_alpha[alpha_idx] = entries
print(f'  built in {time.time()-t0:.1f}s, {sum(len(v) for v in per_alpha.values())} entries')

def fast_orbit_sample(f_vec, g, per_alpha, N, n):
    '''Compute R(g) @ f_vec directly without building R.'''
    out = np.zeros(N, dtype=np.float64)
    # Precompute g powers for fast lookup: g_pow[i,j,k] = g[i,j]**k for k=0..d
    g_pow = np.ones((n, n, d + 1), dtype=np.float64)
    for k in range(1, d + 1):
        g_pow[:, :, k] = g_pow[:, :, k-1] * g
    # For each alpha with f_vec[alpha] != 0, accumulate contributions
    for alpha_idx in np.nonzero(f_vec)[0]:
        c_alpha = f_vec[alpha_idx]
        for coef, B, beta_idx in per_alpha[int(alpha_idx)]:
            prod = float(coef)
            for i in range(n):
                for j in range(n):
                    e = B[i, j]
                    if e > 0:
                        prod *= g_pow[i, j, e]
            out[beta_idx] += c_alpha * prod
    return out

# Test on f_chi_P_n4_d4 = f_chi_P^(4) padded to deg 4 in 5 vars.
f_chi = f_chi_P_homogenised(4, d, syms_full)
print(f'f_chi = {f_chi}', flush=True)
f_vec = poly_to_coef_vec(f_chi, basis_d, syms_full)

# Generate orbit samples
M = 2600
print(f'Generating {M} orbit samples for f_chi_P_n4...', flush=True)
t0 = time.time()
rng = np.random.default_rng(4242)
orbit_coefs = np.zeros((M, N), dtype=np.float64)
n_done = 0
attempts = 0
while n_done < M and attempts < 10 * M:
    g = rng.integers(-2, 3, size=(n, n)).astype(float)
    if abs(np.linalg.det(g)) < 0.5:
        attempts += 1
        continue
    orbit_coefs[n_done] = fast_orbit_sample(f_vec, g, per_alpha, N, n)
    n_done += 1
    attempts += 1
print(f'  done in {time.time()-t0:.1f}s', flush=True)

# Compute kernel per weight
print('Computing per-weight kernels...', flush=True)
t0 = time.time()
pairs = [(i, j) for i in range(N) for j in range(i, N)]
weight_to_pairs = {}
for k, (i, j) in enumerate(pairs):
    w = tuple(int(a + b) for a, b in zip(basis_d[i], basis_d[j]))
    weight_to_pairs.setdefault(w, []).append((k, i, j))

weight_I2 = {}
weight_full = {}
for w, plist in weight_to_pairs.items():
    block_size = len(plist)
    weight_full[w] = block_size
    E_w = np.zeros((M, block_size))
    for col, (_, i, j) in enumerate(plist):
        E_w[:, col] = orbit_coefs[:, i] * orbit_coefs[:, j]
    if block_size == 1:
        rank = 1 if np.max(np.abs(E_w)) > 1e-10 else 0
    else:
        s = np.linalg.svd(E_w, compute_uv=False)
        scale = s[0] if len(s) > 0 else 1.0
        tol = max(M, block_size) * np.finfo(float).eps * max(scale, 1.0)
        rank = int(np.sum(s > tol))
    weight_I2[w] = block_size - rank

dim_I2_total = sum(weight_I2.values())
print(f'  done in {time.time()-t0:.1f}s', flush=True)
print(f'dim I_2(tilde_f_chi_P n=5,d=4) = {dim_I2_total}', flush=True)

# Decompose
weight_quot = {w: weight_full[w] - weight_I2.get(w, 0) for w in weight_full}
decomp_full = schur_decompose_from_weights(weight_full, n, total_deg=2 * d)
decomp_I2 = schur_decompose_from_weights(weight_I2, n, total_deg=2 * d)
decomp_quot = schur_decompose_from_weights(weight_quot, n, total_deg=2 * d)
print(f'Sym^2(Sym^4 V_5) decomp: {dict(decomp_full)}', flush=True)
print(f'I_2 decomp: {dict(decomp_I2)}', flush=True)
print(f'Quotient decomp: {dict(decomp_quot)}', flush=True)
