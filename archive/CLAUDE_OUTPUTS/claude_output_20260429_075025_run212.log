    g_pow = np.ones((n, n, d + 1), dtype=np.float64)
    for k in range(1, d + 1):
        g_pow[:, :, k] = g_pow[:, :, k-1] * g
    for alpha_idx in np.nonzero(f_vec)[0]:
        c_alpha = f_vec[alpha_idx]
        for coef, B, beta_idx in per_alpha[int(alpha_idx)]:
            prod = float(coef)
            for i in range(n):
                for j in range(n):
                    e = B[i, j]
                    if e > 0:
                        prod *= g_pow[i, j, e]
            out[beta_idx] += c_alpha * prod
    return out

# Pairs and weight grouping
pairs = [(i, j) for i in range(N) for j in range(i, N)]
weight_to_pairs = {}
for k, (i, j) in enumerate(pairs):
    w = tuple(int(a + b) for a, b in zip(basis_d[i], basis_d[j]))
    weight_to_pairs.setdefault(w, []).append((k, i, j))

def compute_dim_I2(f_vec, M, seed):
    rng = np.random.default_rng(seed)
    orbit_coefs = np.zeros((M, N))
    n_done = 0
    attempts = 0
    while n_done < M and attempts < 10 * M:
        g = rng.integers(-2, 3, size=(n, n)).astype(float)
        if abs(np.linalg.det(g)) < 0.5:
            attempts += 1
            continue
        orbit_coefs[n_done] = fast_orbit_sample(f_vec, g, per_alpha, N, n, d)
        n_done += 1
        attempts += 1
    weight_I2 = {}
    for w, plist in weight_to_pairs.items():
        block_size = len(plist)
        E_w = np.zeros((M, block_size))
        for col, (_, i, j) in enumerate(plist):
            E_w[:, col] = orbit_coefs[:, i] * orbit_coefs[:, j]
        if block_size == 1:
            rank = 1 if np.max(np.abs(E_w)) > 1e-10 else 0
        else:
            s = np.linalg.svd(E_w, compute_uv=False)
            scale = s[0] if len(s) > 0 else 1.0
            tol = max(M, block_size) * np.finfo(float).eps * max(scale, 1.0)
            rank = int(np.sum(s > tol))
        weight_I2[w] = block_size - rank
    return weight_I2

M = 2600
weight_full = weight_dims_of_sym_2_sym_d(basis_d, n)
print(f'Sym^2(Sym^{d} V_{n}) total dim = {sum(weight_full.values())}', flush=True)
print(f'Schur of full: {dict(schur_decompose_from_weights(weight_full, n, total_deg=2*d))}', flush=True)

results = {}
test_polys = [
    ('chi_P_n4_d4', f_chi_P_homogenised(4, d, syms_full)),
    ('det_2_y2', det_2_padded(syms_full, d)),
    ('perm_2_y2', perm_2_padded(syms_full, d)),
    ('baseline_0', matched_random_homogenised(4, d, syms_full, seed=4252)),
    ('baseline_1', matched_random_homogenised(4, d, syms_full, seed=4253)),
    ('baseline_2', matched_random_homogenised(4, d, syms_full, seed=4254)),
    ('x_1^4 (Veronese control)', syms_full[0]**4),
]
for name, f_expr in test_polys:
    print(f'\\n=== {name} ===', flush=True)
    print(f'  f = {f_expr}', flush=True)
    f_vec = poly_to_coef_vec(f_expr, basis_d, syms_full)
    t0 = time.time()
    weight_I2 = compute_dim_I2(f_vec, M, 4242)
    dim_I2 = sum(weight_I2.values())
    print(f'  dim I_2 = {dim_I2}  ({time.time()-t0:.0f}s)', flush=True)
    weight_quot = {w: weight_full[w] - weight_I2.get(w, 0) for w in weight_full}
    if dim_I2 > 0:
        decomp_I2 = schur_decompose_from_weights(weight_I2, n, total_deg=2*d)
        decomp_quot = schur_decompose_from_weights(weight_quot, n, total_deg=2*d)
        print(f'  I_2 decomp: {dict(decomp_I2)}', flush=True)
        print(f'  Sym^2/I_2 decomp: {dict(decomp_quot)}', flush=True)
    results[name] = {'dim_I2': dim_I2, 'weight_I2': {str(k):v for k,v in weight_I2.items()}}

import json
with open('plethysm_subframe_I2_n5_d4_results.json', 'w') as fp:
    json.dump(results, fp, indent=2, default=str)
