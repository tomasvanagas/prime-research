  [Bash] python3 -c "
import sys, time
sys.path.insert(0, '.')
from plethysm_subframe_I2 import (
    weak_compositions, build_action_structure, generate_orbit_samples,
    poly_to_coef_vec, f_chi_P_homogenised)
import sympy as sp
import numpy as np

# Verify with M=2000 and check singular values gap.
n, d = 5, 3
syms_full = sp.symbols(f'x1:{n+1}')
basis_d = list(weak_compositions(d, n))
basis_dict = {tuple(a): i for i, a in enumerate(basis_d)}
N = len(basis_d)
N2 = N*(N+1)//2
print(f'N={N}, N2={N2}')

structure = build_action_structure(n, d, basis_d, basis_dict)

# tilde f_chi_P^(4)
f1 = f_chi_P_homogenised(4, d, syms_full)
f_vec = poly_to_coef_vec(f1, basis_d, syms_full)
print(f'f1 = {f1}')

t0 = time.time()
M = 2000
orbit_coefs = generate_orbit_samples(f_vec, structure, N, n, M, seed=12345)
print(f'orbit samples generated: {time.time()-t0:.1f}s')

pairs = [(i, j) for i in range(N) for j in range(i, N)]
E = np.zeros((M, N2))
for k, (i, j) in enumerate(pairs):
    E[:, k] = orbit_coefs[:, i] * orbit_coefs[:, j]

s = np.linalg.svd(E, compute_uv=False)
print(f'top 3 SVs: {s[:3]}')
print(f'bottom 5 SVs: {s[-5:]}')
print(f'rank gap: {s[N2-1] / s[0]:.3e}')
tol = max(M, N2) * np.finfo(float).eps * s[0]
rank = int(np.sum(s > tol))
print(f'rank E = {rank} (out of N2={N2})')
print(f'dim I_2 = {N2 - rank}')
