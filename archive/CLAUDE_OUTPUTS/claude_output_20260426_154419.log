    75	# ---------- Sieve Omega(n) and lambda(n) -----------------------------------
    76	
    77	
    78	def sieve_spf(N: int) -> np.ndarray:
    79	    """Smallest-prime-factor sieve.  spf[n] = smallest prime dividing n,
    80	    spf[0] = spf[1] = 0."""
    81	    spf = np.zeros(N + 1, dtype=np.int32)
    82	    for p in range(2, N + 1):
    83	        if spf[p] == 0:
    84	            # mark all multiples of p whose spf is not yet set
    85	            mask_slice = spf[p::p]
    86	            unset = mask_slice == 0
    87	            mask_slice[unset] = p
    88	            spf[p::p] = mask_slice
    89	    return spf
    90	
    91	
    92	def sieve_omega(N: int) -> np.ndarray:
    93	    """Return array Omega[0..N] where Omega[n] = number of prime factors of
    94	    n counted with multiplicity.  Uses spf sieve + recurrence."""
    95	    spf = sieve_spf(N)
    96	    Omega = np.zeros(N + 1, dtype=np.int32)
    97	    # Recurrence: Omega(n) = Omega(n / spf(n)) + 1; need n in increasing order.
    98	    for n in range(2, N + 1):
    99	        Omega[n] = Omega[n // spf[n]] + 1
    100	    return Omega, spf
    101	
