import json, math
from sympy import primepi, isprime
import numpy as np

# Independent reproduction: load saved S82 sigmas, sum top-k_*, compare to 0.21 * pi(N)
# Use a wholly different sieve for pi(N)
results = {}
for d, k_star in [(14,5), (18,15), (20,26)]:
    with open(f'experiments/constructions/spike_eigenvectors_chi_p/spike_d{d}_results.json') as f:
        data = json.load(f)
    # Locate sigmas
    keys = list(data.keys())
    # Find 'chi_p_spikes'
    spikes = data.get('chi_p_spikes')
    sigmas = spikes['sigmas']  # list
    N = 2**d
    # Skip the rank-1 mean (k=0); sum k=1..k_star of sigma^2
    block = sum(s*s for s in sigmas[1:1+k_star])
    pi_N = int(primepi(N))
    target = 0.21 * pi_N
    results[d] = (N, pi_N, block, block/pi_N, block/target)
    print(f"d={d:2}  N={N}  pi(N)={pi_N}  k_*={k_star}  block_sum={block:.4f}  block/pi(N)={block/pi_N:.6f}  ratio_to_0.21pi={block/target:.6f}")

# Compare with published
print("\nPublished values from results.json svd_block:")
with open('experiments/constructions/spike_block_21pct_test/spike_block_21pct_test_results.json') as f:
