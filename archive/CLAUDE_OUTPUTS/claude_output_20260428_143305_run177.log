import json
from sympy import primepi
for d, k_star in [(14,5), (18,15), (20,26)]:
    with open(f'experiments/constructions/spike_eigenvectors_chi_p/spike_d{d}_results.json') as f:
        data = json.load(f)[0]
    spikes = data['chi_p_spikes']  # list of dicts with 'k' and 'sigma'
    # Sort by k ascending and take k=1..k_star (k=0 is rank-1 mean)
    by_k = sorted(spikes, key=lambda s: s['k'])
    block = 0.0
    used = []
    for s in by_k:
        if 1 <= s['k'] <= k_star:
            block += s['sigma']**2
