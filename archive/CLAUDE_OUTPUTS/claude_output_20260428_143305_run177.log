# Source the parse_grade and is_critique_session functions
parse_grade() {
    local f="$1"
    [ -z "$f" ] || [ ! -f "$f" ] && return
    local g
    g=$(head -30 "$f" 2>/dev/null \
        | grep -iE "(self-grade|\*\*grade\*\*|^grade:|^\*\*grade:)" \
        | head -3 \
        | grep -oE "[ABCF]" \
        | head -1)
    if [ -z "$g" ]; then
        g=$(grep -oE "\*\*[ABCF]-grade" "$f" 2>/dev/null \
            | head -1 | grep -oE "[ABCF]")
    fi
    echo "$g"
}
is_critique_session() {
    local f="$1"
    case "$(basename "$f")" in
        *_critique*.md|*critique*_*.md) return 0 ;;
        *_frontier_gen*.md|*frontier-gen*.md) return 0 ;;
        *_verify*.md|*verify*_*.md) return 0 ;;
        *) return 1 ;;
    esac
}

