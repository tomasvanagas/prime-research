  [Bash] python3 << 'EOF'
import numpy as np
# From independent reproduction
d_vals = np.array([14, 18, 20])
ratio_pi = np.array([0.223583, 0.221186, 0.219783])  # block / pi(N)

# Test: linear extrapolation in 1/d, what asymptote does the data alone give?
# Fit: y = a + b/d
A = np.vstack([np.ones_like(d_vals), 1.0/d_vals]).T
coef, *_ = np.linalg.lstsq(A, ratio_pi, rcond=None)
a_data, b_data = coef
print(f"Linear-in-1/d fit: ratio = {a_data:.6f} + {b_data:.4f}/d")
print(f"  ⇒ data-only asymptote: {a_data:.6f}")

# How much does this constrain the asymptote?
# Bootstrap-style: perturb each ratio by 5e-3 (typical SVD top-spike sensitivity)
# and re-fit
asymptotes = []
np.random.seed(42)
for _ in range(2000):
    perturbed = ratio_pi + np.random.normal(0, 5e-3, size=3)
    coef, *_ = np.linalg.lstsq(A, perturbed, rcond=None)
    asymptotes.append(coef[0])
asymptotes = np.array(asymptotes)
print(f"  bootstrap (sigma=5e-3 per point): asymptote = {asymptotes.mean():.4f} ± {asymptotes.std():.4f}")
print(f"  90% CI: [{np.percentile(asymptotes, 5):.4f}, {np.percentile(asymptotes, 95):.4f}]")

# Test alternative asymptote shapes
print()
print("=== fit ratio = a + b/log_2(N) (same as a + b/d) ===")
print(f"  asymptote = {a_data:.4f}")

# Fit y = a (1 + c/log Q*) where Q* = Q_eff
Q_eff = np.array([6, 10, 13])  # from results.json
log_Q = np.log(Q_eff)
# y/a = 1 + c/log Q  ⇒ minimize over (a,c): y = a + (a*c)/log Q
# Treat as linear in (a, b=ac): y = a + b/log Q
A2 = np.vstack([np.ones_like(log_Q), 1.0/log_Q]).T
coef2, *_ = np.linalg.lstsq(A2, ratio_pi, rcond=None)
print(f"=== fit ratio = a + b/log(Q_eff) ===")
print(f"  ratio = {coef2[0]:.6f} + {coef2[1]:.4f}/log(Q_eff)")
print(f"  asymptote: {coef2[0]:.6f}")

# Residuals for both fits
print("\n=== Per-d residuals ===")
print("d   ratio       1/d-fit       1/log(Q*)-fit")
for i, d in enumerate(d_vals):
    pred1 = a_data + b_data/d
    pred2 = coef2[0] + coef2[1]/log_Q[i]
    print(f"{d}   {ratio_pi[i]:.6f}   {pred1:.6f}     {pred2:.6f}")
