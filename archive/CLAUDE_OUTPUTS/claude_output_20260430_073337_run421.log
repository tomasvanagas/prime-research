The empirical knee scales precisely with √x/log x. Let me verify the named-exponent formula with a quick analysis of the variance decomposition, then write up.
  [Bash] python3 -c "
import math, csv

# Read truncation table, build eps_Q[h, Q]
eps = {}
S_inf = {}
with open('experiments/analytic/batched_pi_h/slot3_truncation.csv') as f:
    r = csv.DictReader(f)
    for row in r:
        h = int(row['h'])
        S_inf[h] = float(row['S_inf'])
        for Q in [30, 50, 100, 200, 500, 1000, 2000, 5000]:
            eps[(h, Q)] = float(row[f'abs_eps_{Q}'])

# Predicted sigma_truncation contribution to cross-h variance
import math
def li2_approx(x):
    from scipy.integrate import quad
    v, _ = quad(lambda t: 1.0/math.log(t)**2, 2.0, float(x), limit=400)
    return v

H = sorted(S_inf.keys())
N = len(H)
print('Predicted vs empirical sigma_HL_Q (anchor 10^7, x=10^7):')
li2_x = li2_approx(10**7)
print(f'  li_2(10^7) = {li2_x:.0f}')
F = 0.7
S_bar = sum(S_inf[h] for h in H) / N
sigma_inf_pred = F * math.sqrt(S_bar * li2_x)
print(f'  Predicted sigma_inf ~ F sqrt(S_bar li_2) = {F}*sqrt({S_bar:.3f}*{li2_x:.0f}) = {sigma_inf_pred:.0f}')

# read empirical slot3_knee.csv
with open('experiments/analytic/batched_pi_h/slot3_knee.csv') as f:
    r = csv.DictReader(f)
    for row in r:
        if int(row['anchor_log10']) == 7 and int(row['x']) == 10**7:
            print(f'  Empirical sigma_inf at (7, 10^7): {float(row[\"sigma_inf\"]):.0f}')
            for Q in [30, 50, 100, 200, 500, 1000, 2000, 5000]:
                emp = float(row[f'sigma_Q_{Q}'])
                # truncation contribution to cross-h variance
                trunc_var = sum((eps[(h, Q)] * li2_x)**2 for h in H) / N
                pred = math.sqrt(float(row['sigma_inf'])**2 + trunc_var)
                print(f'  Q={Q:>5d}: emp={emp:7.0f}  predicted={pred:7.0f}  trunc_sigma={math.sqrt(trunc_var):7.0f}')
            break
print()
li2_x = li2_approx(10**8)
print(f'  li_2(10^8) = {li2_x:.0f}')
sigma_inf_pred = F * math.sqrt(S_bar * li2_x)
print(f'  Predicted sigma_inf ~ F sqrt(S_bar li_2) = {F}*sqrt({S_bar:.3f}*{li2_x:.0f}) = {sigma_inf_pred:.0f}')
with open('experiments/analytic/batched_pi_h/slot3_knee.csv') as f:
    r = csv.DictReader(f)
    for row in r:
        if int(row['anchor_log10']) == 8 and int(row['x']) == 10**8:
            print(f'  Empirical sigma_inf at (8, 10^8): {float(row[\"sigma_inf\"]):.0f}')
            for Q in [30, 50, 100, 200, 500, 1000, 2000, 5000]:
                emp = float(row[f'sigma_Q_{Q}'])
                trunc_var = sum((eps[(h, Q)] * li2_x)**2 for h in H) / N
                pred = math.sqrt(float(row['sigma_inf'])**2 + trunc_var)
                print(f'  Q={Q:>5d}: emp={emp:7.0f}  predicted={pred:7.0f}  trunc_sigma={math.sqrt(trunc_var):7.0f}')
            break
print()

# Knee position prediction: smallest Q s.t. trunc_sigma <= 0.05 sigma_inf
print('Predicted knee Q (where trunc_sigma <= 0.32 sigma_inf, so total <= 1.05*sigma_inf):')
for anc_log in [7, 8]:
    li2_x = li2_approx(10**anc_log)
    sigma_inf_target = F * math.sqrt(S_bar * li2_x)  # rough
    knee_pred = 'inf'
    for Q in [30, 50, 100, 200, 500, 1000, 2000, 5000]:
        trunc_var = sum((eps[(h, Q)] * li2_x)**2 for h in H) / N
        trunc_sigma = math.sqrt(trunc_var)
        if trunc_sigma <= 0.32 * sigma_inf_target:
            knee_pred = Q
            break
    print(f'  x=10^{anc_log}: sqrt(x)/log(x) = {math.sqrt(10**anc_log)/math.log(10**anc_log):.0f}, predicted knee Q = {knee_pred}')
"

