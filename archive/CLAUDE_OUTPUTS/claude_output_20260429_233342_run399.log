  [Bash] python3 -c "
# Quick last sanity: compute the strict prime-power count > N/2 with omega=1
from sympy import primerange, isprime, primepi
for N in [64, 128, 256, 512, 1024, 2048, 4096, 8192]:
    count = 0
    pps = []
    for p in primerange(2, int(N**0.5)+2):
        k = 2
        while p**k <= N:
            if p**k > N//2:
                count += 1
                pps.append((p, k, p**k))
            k += 1
    print(f'N={N}: strict prime powers in (N/2, N] with omega=1: {count}; pi(N)-pi(N/2)={int(primepi(N))-int(primepi(N//2))}')
"

