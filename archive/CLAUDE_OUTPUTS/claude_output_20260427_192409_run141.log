from math import gcd
from sympy import isprime, totient

def find_triangulation(W):
    """Try to find a triangulation of the WxW slab (j=1) with rows in [0, W).
    Returns (dead, rho, sigma) or None."""
    live_cols = [k for k in range(W) if gcd(k+1, W) == 1]
    dead_candidates = [k for k in range(W) if gcd(k+1, W) != 1 and isprime(k+1)]
    phi = int(totient(W))
    R = phi + 1
    if not dead_candidates:
        return None  # cannot exhibit dead column with chiP=1 at row 0
    
    from itertools import combinations as comb
    
    for dead in dead_candidates:
        cols_set = sorted(live_cols + [dead])
        row_pool = list(range(W))
        # Enumerate row subsets — bound size by combinatorial limit
        n_combs = 1
        from math import comb as binom
        n_combs = binom(W, R)
        if n_combs > 5_000_000:
            return f"too-large (W={W}, R={R}, combos={n_combs})"
        
        for rows in comb(row_pool, R):
            R_arr = list(rows)
            P = [[1 if isprime(r*W + c + 1) else 0 for c in cols_set] for r in R_arr]
            
            # Greedy peel: find a sequence such that at each step, some remaining row
            # has exactly one 1 in remaining cols
            P_arr = [row[:] for row in P]
            cols_remaining = list(range(R))
            rows_remaining = list(range(R))
            row_order = []
            col_order = []
            ok = True
            for step in range(R):
                found = -1
                for ri in rows_remaining:
                    ones = [ci for ci in cols_remaining if P_arr[ri][ci] == 1]
                    if len(ones) == 1:
                        found = ri
                        c_found = ones[0]
                        break
                if found == -1:
                    ok = False
                    break
                row_order.append(found)
                col_order.append(c_found)
                rows_remaining.remove(found)
                cols_remaining.remove(c_found)
            if ok:
                row_order = row_order[::-1]
                col_order = col_order[::-1]
                rho = [R_arr[i] for i in row_order]
                sigma = [cols_set[k] for k in col_order]
                return (dead, rho, sigma)
    return None

# Test each W
test_Ws = [21, 22, 25, 26, 27, 28, 33, 35, 36]
done_set = {2, 3, 4, 5, 6, 8, 12, 18, 20}

for W in test_Ws:
    if W in done_set:
        continue
    R = int(totient(W)) + 1
    print(f"W={W}, phi={int(totient(W))}, R={R} ...", end=" ", flush=True)
    result = find_triangulation(W)
    if result is None:
        print("NO TRIANGULATION (structurally obstructed)")
    elif isinstance(result, str):
        print(result)
    else:
        dead, rho, sigma = result
        print(f"FOUND! dead={dead}")
        print(f"  rho = {rho}")
        print(f"  sigma = {sigma}")
        diag_primes = [rho[i]*W + sigma[i] + 1 for i in range(R)]
        print(f"  diag primes: {diag_primes}")
        max_diag = max(diag_primes)
        print(f"  max_diag = {max_diag}")
