  [Bash] cat <<'PY' > /tmp/w9_analysis.py
from math import gcd
from sympy import isprime, totient
import numpy as np
from itertools import combinations as comb, permutations

W = 9
live_cols = [k for k in range(W) if gcd(k+1, W) == 1]
dead_candidates = [k for k in range(W) if gcd(k+1, W) != 1 and isprime(k+1)]
R = int(totient(W)) + 1
print(f"W=9: phi=6, R={R}, live={live_cols}, dead_cands={dead_candidates}")

# Only viable dead is k=2 (chiP(3) = 1)
dead = 2
cols_set = sorted(live_cols + [dead])
print(f"cols_set = {cols_set}")

# Compute the W x R matrix
M = np.zeros((W, R), dtype=int)
for r in range(W):
    for k_idx, c in enumerate(cols_set):
        n = r*W + c + 1
        M[r, k_idx] = 1 if isprime(n) else 0
print("\nW=9 j=1 slab restricted to chosen R cols, full 9 rows:")
print(M)
print("Cols are mapped: idx 0->0, 1->1, 2->2(dead), 3->3, 4->4, 5->6, 6->7")

# Try all C(9, 7) = 36 row subsets and check if det != 0
print("\nLooking for any 7-row subset with nonzero determinant:")
found_invertibles = []
for rows in comb(range(W), R):
    sub = M[list(rows), :]
    d = round(np.linalg.det(sub.astype(float)))
    if d != 0:
        found_invertibles.append((rows, d))

print(f"Found {len(found_invertibles)} invertible 7-row subsets:")
for rows, d in found_invertibles[:5]:
    print(f"  rows={rows}, det={d}")

# Also try block structure detection
print("\nBlock structure detection for the FULL 9 rows (for whichever rho works):")
# Can we permute to block diagonal? Check if there's a way to split rows + cols into blocks
# such that the matrix is block-diagonal.
# Equivalent to bipartite graph G(rows, cols) with edge iff entry != 0,
# and finding the connected components.
# 
# But block-DIAGONAL is too strict; block-TRIANGULAR is more permissive.

# Let's pick rows = all 9 (or first 7 with nonzero det)
if found_invertibles:
    best_rows = list(found_invertibles[0][0])
    print(f"\nUsing rows={best_rows}:")
    sub = M[best_rows, :]
    print(sub)
    print("Det =", round(np.linalg.det(sub.astype(float))))
    
    # Try to find block-triangular permutation
    # Build bipartite incidence graph: rows, cols
    # Find row/col blocks: connected components when treating it as a bipartite graph
    # restricted to nonzero entries
    
    nrows, ncols = sub.shape
    parent = list(range(nrows + ncols))
    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x
    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb: parent[ra] = rb
    for i in range(nrows):
        for j in range(ncols):
            if sub[i, j] != 0:
                union(i, nrows + j)
    
    components = {}
    for i in range(nrows):
        components.setdefault(find(i), {'rows': [], 'cols': []})['rows'].append(i)
    for j in range(ncols):
        components.setdefault(find(nrows + j), {'rows': [], 'cols': []})['cols'].append(j)
    
    print(f"\nConnected components ({len(components)}):")
    for cid, comp in components.items():
        print(f"  comp {cid}: rows={comp['rows']}, cols={comp['cols']}")
        if comp['rows'] and comp['cols']:
            block = sub[np.ix_(comp['rows'], comp['cols'])]
            print(f"  block:\n{block}")
            if len(comp['rows']) == len(comp['cols']):
                bd = round(np.linalg.det(block.astype(float)))
                print(f"  block det = {bd}")
