  [Bash] cat <<'PY' > /tmp/w_search2.py
from math import gcd
from sympy import isprime, totient

def find_triangulation_dp(W):
    """DP-based search. For each dead col candidate, try to find sigma (col ordering)
    via DP over subsets of R cols, then assign rows."""
    live_cols = [k for k in range(W) if gcd(k+1, W) == 1]
    dead_candidates = [k for k in range(W) if gcd(k+1, W) != 1 and isprime(k+1)]
    R = int(totient(W)) + 1
    
    if not dead_candidates:
        return None
    if R > 20:
        return f"R={R} too large"
    
    for dead in dead_candidates:
        cols_set = sorted(live_cols + [dead])
        # signature for each row r in [0, W): bitmask over R cols
        sig = []
        for r in range(W):
            s = 0
            for k, c in enumerate(cols_set):
                if isprime(r*W + c + 1):
                    s |= (1 << k)
            sig.append(s)
        
        full = (1 << R) - 1
        reach = [False] * (1 << R)
        pred = [-1] * (1 << R)
        reach[0] = True
        
        # Bottom-up: for each T in increasing popcount
        for T in range(1, 1 << R):
            for c in range(R):
                if not (T & (1 << c)):
                    continue
                T_prev = T & ~(1 << c)
                if not reach[T_prev]:
                    continue
                # ∃ r with sig[r] & T_prev == 0 and sig[r] & (1<<c) != 0
                found = False
                for r in range(W):
                    if (sig[r] & T_prev) == 0 and (sig[r] & (1 << c)):
                        found = True
                        break
                if found:
                    reach[T] = True
                    pred[T] = c
                    break
        
        if not reach[full]:
            continue  # try next dead col
        
        # Recover sigma_order
        sigma_order = []
        T = full
        while T != 0:
            c = pred[T]
            sigma_order.append(c)
            T &= ~(1 << c)
        sigma_order.reverse()
        
        # Recover rho rows: distinct rows with first-σ-position matching each step
        rho_rows = []
        placed = 0
        used = set()
        for c_idx in sigma_order:
            picked = -1
            for r in range(W):
                if r in used:
                    continue
                if (sig[r] & placed) == 0 and (sig[r] & (1 << c_idx)):
                    picked = r
                    break
            if picked < 0:
                # Should not happen given DP existence, but check
                rho_rows = None
                break
            rho_rows.append(picked)
            used.add(picked)
            placed |= (1 << c_idx)
        
        if rho_rows is None:
            continue
        
        sigma = [cols_set[c_idx] for c_idx in sigma_order]
        return (dead, rho_rows, sigma)
    
    return None

test_Ws = [26, 28, 33, 35, 36]

for W in test_Ws:
    R = int(totient(W)) + 1
    print(f"W={W}, phi={int(totient(W))}, R={R} ...", flush=True)
    result = find_triangulation_dp(W)
    if result is None:
        print("  NO TRIANGULATION (structurally obstructed)")
    elif isinstance(result, str):
        print(f"  {result}")
    else:
        dead, rho, sigma = result
        diag_primes = [rho[i]*W + sigma[i] + 1 for i in range(R)]
        max_diag = max(diag_primes)
        print(f"  FOUND! dead={dead}, max_diag={max_diag}")
        print(f"  rho = {rho}")
        print(f"  sigma = {sigma}")
        print(f"  diag primes: {diag_primes}")
        # verify below-diag composites
        composites = []
        for i in range(R):
            for k in range(i):
                n = rho[i]*W + sigma[k] + 1
                if isprime(n):
                    print(f"  BUG: ({i},{k}) is prime n={n}")
                else:
                    composites.append(n)
        print(f"  below-diag composites: {sorted(set(composites))}")
