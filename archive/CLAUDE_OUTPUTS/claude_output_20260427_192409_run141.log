from itertools import permutations, combinations
from sympy import isprime

W = 22
# columns
live_cols = [k for k in range(W) if not isprime  and gcd(k+1, W) == 1] if False else None
from math import gcd
live_cols = [k for k in range(W) if gcd(k+1, W) == 1]
# dead candidates that yield 1 at row 0 (i.e., k+1 prime)
dead_candidates = [k for k in range(W) if gcd(k+1, W) != 1 and isprime(k+1)]
print("live cols:", live_cols, "len", len(live_cols))
print("dead candidates:", dead_candidates)

# R = phi(W)+1 = 11
phi = sum(1 for k in range(1, W+1) if gcd(k, W)==1)
R = phi + 1
print("R =", R)

# entry at (i, k) is chiP(i*W + k + 1)
# We want to find rho: R rows in [0, W) (the "leading" attempt — extended pool)
# and sigma: R columns total = (live_cols ∪ {dead_choice})
# such that submatrix is upper-triangular (after reorder), with 1's on diagonal,
# 0's below the diagonal.

def ut_check(rows, cols):
    # rows and cols are sequences of length R; we treat them as rho, sigma
    # Construct R x R matrix
    M = [[1 if isprime(rows[i]*W + cols[k] + 1) else 0 for k in range(R)] for i in range(R)]
    # Diagonal must all be 1, below-diagonal must all be 0 (above diagonal anything)
    for i in range(R):
        if M[i][i] != 1: return False
        for k in range(i):
            if M[i][k] != 0: return False
    return True

# Strategy: greedy. For each dead choice, try all R-row selections from [0, W) and
# all R-col permutations of (live ∪ {dead}). Too many for brute force (C(22,11)*11!).
# Instead, use diagonal-search: pick any R rows (combos), then for each one search
# a permutation of cols that gives upper triangular with 1's on diag.

def find(rows_pool_size_max=None):
    for dead in dead_candidates:
        cols_set = sorted(live_cols + [dead])
        # Enumerate row subsets
        from itertools import combinations as comb
        # Allow rows from [0, W) — keep small
        row_pool = list(range(W))
        for rows in comb(row_pool, R):
            # We need a column permutation of cols_set such that:
            # for each i, primality(rows[?]*W + cols[i]+1) and below-diag zeros
            # Try via rho permutations too — pick ordering of rows
            # Compute boolean R x R matrix M[i][k] for rows in chosen ordering and cols in canonical order
            R_arr = list(rows)
            # full primality matrix for these rows with cols_set
            P = [[1 if isprime(r*W + c + 1) else 0 for c in cols_set] for r in R_arr]
            # Try each row permutation (rho) and column permutation (sigma)
            # That's R! * R! ~ 1.6e15. Too much. So instead:
            # Use the fact: for each i, we need rows[rho_inv[i]]*W + cols[sigma_inv[i]]+1 to be prime (diagonal)
            # And for j < i: rows[rho_inv[i]]*W + cols[sigma_inv[j]]+1 must be NOT prime
            # ⇒ pick a perfect matching between rows and cols where row i is matched to col k(i) iff entry is prime,
            # then find a topological ordering on the digraph: i < j if (row i has a prime at col k(j))?
            # Equivalent to: assign permutations rho, sigma so that the chosen R diagonal entries are primes,
            # and for the resulting reordered matrix, all below-diagonal entries are 0.
            # Easier: recursive selection.
            # Step 1: find a matching M of rows to cols where (r, c) ∈ M iff entry = 1 (prime).
            # Then order them such that triangulation holds.
            # For triangulation: there must exist a row permutation rho and col permutation sigma such that
            # diagonal = chosen matching entries (all 1), and for each i < j in the order, 
            # the entry (rho^{-1}(j), sigma^{-1}(i)) is 0 (i.e., row r_j at col c_i is composite).
            # 
            # This is the question: given a 0-1 matrix, can we permute rows AND cols so that it's upper triangular with 1's on diagonal?
            # Equivalent to: find a perfect matching of 1's; let order of (r_t, c_t) pairs satisfy that for s < t,
            # entry P[r_t][c_s] = 0.
            # 
            # Greedy: build the matching iteratively, last to first. The "last" diagonal element (r, c)
            # must have ALL entries P[r][c'] = 0 for c' != c, c' in remaining cols. (That's the bottom row condition.)
            # Then remove r and c, recurse on the smaller submatrix.
            # 
            # Wait — actually for upper triangular, the bottom row (i = R-1) has only the diagonal element nonzero.
            # No: diagonal at column R-1, columns 0..R-2 must be 0. So entries P[r_{R-1}][c_0..c_{R-2}] = 0.
            # That means r_{R-1} has 1 in only one column among the chosen R columns.
            # 
            # So the greedy peel-off: find any row that has exactly one 1 in the chosen R columns.
            # That row is r_{R-1}, the column where the 1 is is c_{R-1}.
            # Remove r_{R-1} and c_{R-1}, recurse.
            # 
            # If no row has exactly one 1 → fail.
            
            P_arr = [row[:] for row in P]
            cols_remaining = list(range(R))
            rows_remaining = list(range(R))
            row_order = []
            col_order = []
            ok = True
            for step in range(R):
                # find a row with exactly one 1 in remaining cols
                found = -1
                for ri in rows_remaining:
                    ones = [ci for ci in cols_remaining if P_arr[ri][ci] == 1]
                    if len(ones) == 1:
                        found = ri
                        c_found = ones[0]
                        break
                if found == -1:
                    ok = False
                    break
                row_order.append(found)
                col_order.append(c_found)
                rows_remaining.remove(found)
                cols_remaining.remove(c_found)
            if ok:
                # row_order is in order (R-1), (R-2), ..., 0 (bottom-up); reverse to get rho order
                row_order = row_order[::-1]
                col_order = col_order[::-1]
                # Map back to original row indices (R_arr) and original col indices (cols_set)
                rho = [R_arr[i] for i in row_order]
                sigma = [cols_set[k] for k in col_order]
                return dead, rho, sigma
    return None

import sys
sys.setrecursionlimit(10**5)
result = find()
if result is None:
    print("no triangulation found")
else:
    dead, rho, sigma = result
    print(f"FOUND!  dead={dead}")
    print(f"rho = {rho}")
    print(f"sigma = {sigma}")
    # Print the resulting triangular submatrix
    from sympy import isprime as ip
    diagonal_primes = []
    below_diag = []
    print("Submatrix:")
    for i in range(R):
        row_str = []
        for k in range(R):
            n = rho[i]*W + sigma[k] + 1
            row_str.append(f"{1 if ip(n) else 0}")
            if i == k:
                diagonal_primes.append(n)
            if k < i and ip(n):
                print(f"BUG: below-diagonal entry not zero at ({i},{k}): chiP {n} is prime")
            if k < i and not ip(n):
                below_diag.append(n)
        print(f"  i={i}: " + ", ".join(row_str))
    print(f"diagonal n-values: {[rho[i]*W + sigma[i] + 1 for i in range(R)]}")
    print(f"diagonal primes: {diagonal_primes}")
    print(f"below-diagonal n-values: {sorted(below_diag)}")
