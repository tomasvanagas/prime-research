from math import gcd
from sympy import isprime, totient
import numpy as np
from itertools import permutations

W = 9
R = 7
live_cols = [0, 1, 3, 4, 6, 7]
dead = 2
cols_set = sorted(live_cols + [dead])  # [0, 1, 2, 3, 4, 6, 7]

# Use rows {0, 1, 2, 3, 4, 5, 6}
rows = list(range(R))
M = np.zeros((R, R), dtype=int)
for i, r in enumerate(rows):
    for k, c in enumerate(cols_set):
        n = r*W + c + 1
        M[i, k] = 1 if isprime(n) else 0
print("M (7x7):")
print(M)
print(f"det(M) = {round(np.linalg.det(M.astype(float)))}")

# DP-triangulate function
def can_triangulate(MM, debug=False):
    """Check if the matrix MM (NxN, 0/1) can be permuted to upper triangular with 1 on diag."""
    N = MM.shape[0]
    sig = []
    for i in range(N):
        s = 0
        for j in range(N):
            if MM[i, j] == 1:
                s |= (1 << j)
        sig.append(s)
    full = (1 << N) - 1
    reach = [False] * (1 << N)
    pred = [-1] * (1 << N)
    reach[0] = True
    for T in range(1, 1 << N):
        for c in range(N):
            if not (T & (1 << c)):
                continue
            T_prev = T & ~(1 << c)
            if not reach[T_prev]:
                continue
            for r in range(N):
                if (sig[r] & T_prev) == 0 and (sig[r] & (1 << c)):
                    reach[T] = True
                    pred[T] = c
                    break
            if reach[T]:
                break
    return reach[full], pred if reach[full] else None

# col 0 has nonzero at rows 2, 4 (using row indices in [0..6])
# Wait, M[2,0]=1 and M[4,0]=1; check
print(f"\nCol 0: {M[:, 0]}")  # row indices 0..6 within M
# So cofactor along col 0:
# det(M) = sum over rows i of (-1)^(i+0) * M[i, 0] * det(M with row i and col 0 removed)
# = M[2,0] * (+1) * det(minor 2,0) + M[4,0] * (+1) * det(minor 4,0)
# Why +1? (-1)^(2+0) = 1, (-1)^(4+0) = 1.

# Compute the two 6x6 minors
def remove_row_col(M, i, j):
    keep_rows = [r for r in range(M.shape[0]) if r != i]
    keep_cols = [c for c in range(M.shape[1]) if c != j]
    return M[np.ix_(keep_rows, keep_cols)]

minor_20 = remove_row_col(M, 2, 0)
minor_40 = remove_row_col(M, 4, 0)
print(f"\nminor (row 2, col 0):\n{minor_20}")
print(f"det(minor_20) = {round(np.linalg.det(minor_20.astype(float)))}")
print(f"\nminor (row 4, col 0):\n{minor_40}")
print(f"det(minor_40) = {round(np.linalg.det(minor_40.astype(float)))}")

# Check triangulation for each
print(f"\nminor_20 triangulizable: {can_triangulate(minor_20)[0]}")
print(f"minor_40 triangulizable: {can_triangulate(minor_40)[0]}")
