from math import gcd
from sympy import isprime, totient

W = 9
live_cols = [k for k in range(W) if gcd(k+1, W) == 1]
R = int(totient(W)) + 1
dead = 2  # the unique viable dead

cols_set = sorted(live_cols + [dead])
sig = []
for r in range(W):
    s = 0
    for k, c in enumerate(cols_set):
        if isprime(r*W + c + 1):
            s |= (1 << k)
    sig.append(s)

# Print sig binary to understand
print("Row signatures (R=7 bits, MSB to LSB indexed by cols [0,1,2,3,4,6,7]):")
for r in range(W):
    print(f"  r={r}: {bin(sig[r])[2:].zfill(R)}")

full = (1 << R) - 1
reach = [False] * (1 << R)
reach[0] = True

for T in range(1, 1 << R):
    for c in range(R):
        if not (T & (1 << c)):
            continue
        T_prev = T & ~(1 << c)
        if not reach[T_prev]:
            continue
        found = any((sig[r] & T_prev) == 0 and (sig[r] & (1 << c)) for r in range(W))
        if found:
            reach[T] = True
            break

print(f"\nDP reach[full] = {reach[full]}")
print(f"Reach popcount distribution:")
from collections import Counter
counts = Counter(bin(t).count('1') for t in range(1 << R) if reach[t])
for popcount in sorted(counts.keys()):
    print(f"  popcount {popcount}: {counts[popcount]} reachable subsets")

# Largest reachable popcount
max_reach = max((bin(t).count('1'), t) for t in range(1 << R) if reach[t])
print(f"  max reachable: popcount={max_reach[0]}, T={bin(max_reach[1])[2:].zfill(R)}")
