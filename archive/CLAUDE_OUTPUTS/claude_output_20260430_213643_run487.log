  [Bash] python3 -c "
import sys, os
sys.path.insert(0, '.')
import numpy as np, csv
from p11_ulam_bounded import sieve_primes, ulam_coords_array, bounded_greedy_line_cover
from p11_lp_relaxation import enumerate_lines, solve_lp

rows = []
for N in [1000, 5000, 10000]:
    K = 5
    X32, Y32 = ulam_coords_array(N)
    X = X32.astype(np.int64); Y = Y32.astype(np.int64)
    primes = sieve_primes(N)
    pi_N = len(primes)
    px = X[primes]; py = Y[primes]
    L_g, _ = bounded_greedy_line_cover(px, py, K, verbose=False)
    lines_p = enumerate_lines(px, py, K)
    L_lp_p, _, _ = solve_lp(pi_N, lines_p, verbose=False)
    rng = np.random.default_rng(123)
    L_g_b = []; L_lp_b = []
    for trial in range(3):
        sample = rng.choice(np.arange(1, N+1), size=pi_N, replace=False)
        rx = X[sample]; ry = Y[sample]
        Lg, _ = bounded_greedy_line_cover(rx, ry, K, verbose=False)
        L_g_b.append(Lg)
        lines_b = enumerate_lines(rx, ry, K)
        Llp, _, _ = solve_lp(pi_N, lines_b, verbose=False)
        L_lp_b.append(Llp)
    sqrt_N = N ** 0.5
    print(f'N={N}, pi={pi_N}, sqrt={sqrt_N:.2f}: '
          f'primes greedy={L_g} LP={L_lp_p:.4f}; '
          f'baseline greedy_mean={sum(L_g_b)/3:.1f} LP_mean={sum(L_lp_b)/3:.4f} '
          f'(LP std={np.std(L_lp_b):.4f})')
    rows.append([N, pi_N, sqrt_N, L_g, L_lp_p, sum(L_g_b)/3, sum(L_lp_b)/3])

with open('lp_scaling_summary.csv', 'w', newline='') as f:
    w = csv.writer(f)
    w.writerow(['N', 'pi_N', 'sqrt_N', 'L_greedy_primes', 'L_lp_primes',
                'L_greedy_random_mean', 'L_lp_random_mean'])
    for r in rows:
        w.writerow([r[0], r[1], f'{r[2]:.3f}', r[3], f'{r[4]:.4f}',
                    f'{r[5]:.2f}', f'{r[6]:.4f}'])
print('wrote lp_scaling_summary.csv')
