import numpy as np
s = np.load('/tmp/sigmas_d22.npy')
pi_N = 295947; d=22; N=1<<d

# Key q-cum values at d=22 from my fresh sieve (computed above):
cum_at = {2:20881.52, 3:31322.23, 5:36542.51, 6:46983.07, 7:50463.23,
          10:55683.44, 11:57771.48, 13:59511.53, 14:62991.64, 15:65601.75,
          17:66906.75, 19:68066.78, 21:69806.86, 22:71894.87, 23:72844.00,
          26:74584.03, 29:75329.82, 30:77939.89}

# For each plausible k_* at d=22, find matching Q_eff
print('k_* | spike block | spike/pi(N) | Q_eff (cum>=spike) | log Q_eff / log N')
for k_star in [20, 26, 28, 30, 35, 40, 45, 50]:
    block = float(np.sum(s[1:1+k_star]**2))
    Q_eff = None
    for q, c in sorted(cum_at.items()):
        if c >= block: Q_eff = q; break
    exp = np.log(Q_eff)/np.log(N) if Q_eff else float('nan')
    print(f'{k_star:3d} | {block:9.2f} | {block/pi_N:.4f}   | {Q_eff}            | {exp:.4f}')

# What about extending S82's pattern? At d=14, k_*=5; d=18, 15; d=20, 26
# Look at log k_*/log N
print('\\nS169-claimed k_star scaling extension to d=22:')
ds = [14, 18, 20]
ks = [5, 15, 26]
for d_,k_ in zip(ds,ks):
    print(f'  d={d_}: k_*={k_}, log k_*/log N = {np.log(k_)/np.log(2**d_):.4f}')

# Linear extrapolation to d=22?
import numpy as np
slope = np.polyfit(ds, [np.log(k) for k in ks], 1)
print(f'  fit log k_* = {slope[0]:.4f}*d + {slope[1]:.4f}')
for d_pred in [22, 24]:
    k_pred = np.exp(slope[0]*d_pred + slope[1])
    print(f'  d={d_pred}: predicted k_* = {k_pred:.1f}')
"

