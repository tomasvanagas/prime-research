t0 = time.time()
chi = sieve(N)[1:N+1].astype(np.float64)  # length N
print(f'sieve done in {time.time()-t0:.2f}s, sum={chi.sum()}')
pi_N = int(chi.sum())
M = chi.reshape(2048, 2048)
t0 = time.time()
U, s, Vt = np.linalg.svd(M, full_matrices=False)
print(f'SVD done in {time.time()-t0:.2f}s')
print(f'top 30 sigmas:')
for i, sig in enumerate(s[:30]):
