import numpy as np, math, time, json
def sieve(N):
    is_p = np.ones(N+1, dtype=bool)
    is_p[:2]=False
    for i in range(2, int(N**0.5)+1):
        if is_p[i]: is_p[i*i::i]=False
    return is_p

# d=22: N = 2^22 = 4194304, reshape to (2^11, 2^11) = (2048, 2048)
d = 22
N = 1 << d
