The exponent 0.40 is borderline interesting but R²=0.11 is weak. Let me extend the experiment with larger n and windowed RMS to get a cleaner exponent.
  [Bash] cat > /tmp/halving_v2.py <<'PYEOF'
import sympy, numpy as np, time
n_max = 50000
print(f"computing {n_max} primes...")
t0=time.time()
primes = np.zeros(n_max+1, dtype=np.int64)
p = 1
for n in range(1, n_max+1):
    p = sympy.nextprime(p); primes[n]=p
print(f"done in {time.time()-t0:.2f}s")

n_grid = np.arange(20, n_max+1)
theta = (primes[n_grid] - 2*primes[n_grid//2]).astype(float)
n = n_grid.astype(float)

# fit theta with full polylog basis
cols = [np.ones_like(n), n, n*np.log(n), n*np.log(np.log(n)),
        np.log(n), np.log(n)**2, np.sqrt(n), n/np.log(n)]
names= ["1","n","n_logn","n_log_logn","logn","log2n","sqrt_n","n_over_logn"]
A = np.column_stack(cols)
coefs, *_ = np.linalg.lstsq(A, theta, rcond=None)
pred = A @ coefs
resid = theta - pred

# also compute delta(n) = p(n) - li_inv(n) for comparison
from mpmath import li, findroot, mp
mp.dps = 20
def li_inv_arr(ns):
    out = np.zeros_like(ns, dtype=float)
    for i, k in enumerate(ns):
        try:
            out[i] = float(findroot(lambda y: li(y)-int(k), float(k)*np.log(max(int(k),2)), tol=1e-3))
        except:
            out[i] = float(k)*np.log(max(int(k),2))
    return out

# downsample for li_inv (slow)
sub = n_grid[::200]
liinv = li_inv_arr(sub)
delta_sub = primes[sub] - liinv

# windowed RMS for residual and delta
def windowed_rms(x_arr, y_arr, n_windows=20):
    edges = np.geomspace(x_arr[0], x_arr[-1], n_windows+1)
    centers = []; rms = []
    for i in range(n_windows):
        mask = (x_arr >= edges[i]) & (x_arr < edges[i+1])
        if mask.sum() < 5: continue
        centers.append(np.sqrt(edges[i]*edges[i+1]))
        rms.append(np.sqrt(np.mean(y_arr[mask]**2)))
    return np.array(centers), np.array(rms)

c1, r1 = windowed_rms(n_grid, resid, 20)
c2, r2 = windowed_rms(sub, delta_sub.astype(float), 15)

# power law fits
def pl_fit(c, r):
    lx = np.log(c); ly = np.log(r)
    A2 = np.column_stack([lx, np.ones_like(lx)])
    sol,*_ = np.linalg.lstsq(A2, ly, rcond=None)
    pred = A2 @ sol
    ss_res = np.sum((ly-pred)**2); ss_tot = np.sum((ly-np.mean(ly))**2)
    r2v = 1.0 - ss_res/ss_tot if ss_tot > 0 else 0.0
    return sol[0], np.exp(sol[1]), r2v

b_resid, a_resid, r2_resid = pl_fit(c1, r1)
b_delta, a_delta, r2_delta = pl_fit(c2, r2)

print(f"\n=== theta-residual (windowed RMS) ===")
print(f"  windows: {len(c1)}")
print(f"  fit: RMS_window ~ {a_resid:.3e} * n^{b_resid:.3f}, R^2={r2_resid:.3f}")
for i in range(0, len(c1), 4):
    print(f"  n~{c1[i]:.1f}  RMS={r1[i]:.2f}")

print(f"\n=== delta(n)=p(n)-li^{-1}(n) (windowed RMS, sub-sample) ===")
print(f"  windows: {len(c2)}")
print(f"  fit: RMS_window ~ {a_delta:.3e} * n^{b_delta:.3f}, R^2={r2_delta:.3f}")
for i in range(0, len(c2), 3):
    print(f"  n~{c2[i]:.1f}  RMS={r2[i]:.2f}")

# fitting coefficients
print(f"\n=== theta(n) basis fit coefficients ===")
for nm, c in zip(names, coefs):
    print(f"  {nm:>14s}: {c:+.4e}")
print(f"  RMSE residual = {np.sqrt(np.mean(resid**2)):.3e}")
print(f"  max |residual| = {np.max(np.abs(resid)):.3e}")
