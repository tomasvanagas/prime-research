  [Bash] python3 - <<'EOF'
import csv
import math
import numpy as np

for tag, path in [("1e5", "experiments/analytic/connes_amortisation/connes_amortisation_fluctuation_1e5.csv"),
                  ("1e6", "experiments/analytic/connes_amortisation/connes_amortisation_fluctuation_1e6.csv")]:
    with open(path) as f:
        rows = list(csv.DictReader(f))
    print(f"\n=== center {tag}: {len(rows)} samples ===")
    Ksust = [int(r['K_sustained']) for r in rows]
    sqrtx = [float(r['sqrt_x']) for r in rows]
    valid_pairs = [(k,s) for k,s in zip(Ksust, sqrtx) if k > 0]
    n_unstab = sum(1 for k in Ksust if k <= 0)
    print(f"unstabilised at K_max: {n_unstab}/{len(rows)}")
    if valid_pairs:
        ratios = np.array([k/s for k,s in valid_pairs])
        print(f"K_sust/sqrt(x): n={len(ratios)} min={ratios.min():.2f} med={np.median(ratios):.2f} mean={ratios.mean():.2f} max={ratios.max():.2f} std={ratios.std():.2f}")

    # hit rates per policy
    for col in ['hit_at_K_log2x', 'hit_at_K_log3x', 'hit_at_K_5log2x', 'hit_at_K_sqrtx', 'hit_at_K_halfsqrtx']:
        n_hit = sum(int(r[col]) for r in rows)
        print(f"  {col}: {n_hit}/{len(rows)} = {n_hit/len(rows):.2%}")

    # median |error| at each K policy
    print("  policy             median |err|     90th-pctile |err|")
    for col in ['abs_err_at_K_log2x', 'abs_err_at_K_log3x', 'abs_err_at_K_5log2x', 'abs_err_at_K_sqrtx', 'abs_err_at_K_halfsqrtx']:
        errs = np.array([float(r[col]) for r in rows])
        print(f"  {col:25s}  {np.median(errs):10.3f}    {np.percentile(errs, 90):10.3f}")
