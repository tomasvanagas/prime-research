    99	def fourier_energy_at_q(prime_arr, q, N):
    100	    """E(q, N) = (1/N) sum_{k coprime to q} |sum_{p' prime <= N} omega_q^{k p'}|^2."""
    101	    energy = 0.0
    102	    for k in range(1, q):
    103	        if math.gcd(k, q) != 1:
    104	            continue
    105	        angle = 2 * np.pi * k * prime_arr / q
    106	        c = float(np.sum(np.cos(angle)))
    107	        s = float(np.sum(np.sin(angle)))
    108	        energy += (c * c + s * s) / N
    109	    return energy
