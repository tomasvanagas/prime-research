  [Bash] # Wait for the sequential job to hit checkpoint at k>=5000 OR for parallel to finish
# The sequential checkpoint file gets updated every 50 zeros
# We need it to reach line count 3000 (zeros 2001..5000 = 3000 lines)
echo "Waiting for sequential checkpoint to reach 3000 lines (k>=5000) AND parallel workers to finish..."
until [ "$(pgrep -f gen_zeros_parallel | wc -l)" -eq "0" ]; do sleep 30; done
echo "PARALLEL WORKERS DONE."

# Now wait for sequential to reach k=5000
until [ "$(wc -l < data/zeta_zeros_8000.checkpoint 2>/dev/null || echo 0)" -ge "3000" ]; do sleep 15; done

# Kill sequential 
SEQ_PID=$(pgrep -f gen_zeros_8000.py)
if [ -n "$SEQ_PID" ]; then
    kill $SEQ_PID
    echo "Killed sequential PID $SEQ_PID"
fi

# Final cleanup wait
until [ "$(pgrep -f gen_zeros | wc -l)" -eq "0" ]; do sleep 5; done

echo "ALL DONE."
echo "Sequential lines:" $(wc -l < data/zeta_zeros_8000.checkpoint 2>/dev/null)
echo "Parallel chunks:"
for f in data/parallel_chunks/chunk_*.txt; do
    echo "  $f: $(wc -l < $f) lines"
done
