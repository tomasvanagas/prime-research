import sys, importlib
sys.path.insert(0, 'experiments/analytic/zeta_structure/large_n_correlations')
import large_n_battery as lnb
importlib.reload(lnb)
import numpy as np

gammas = lnb.load_zeros(lnb.DATA_2000)
u = lnb.unfold(gammas)
T_mean = (gammas[0] + gammas[-1]) / 2.0
L = np.log(T_mean / (2*np.pi))

# Pair correlation residual
centers, R2 = lnb.pair_correlation(u)
R2_gue = lnb.gue_R2(centers)
D = R2 - R2_gue

# BK predicted residual
bk = lnb.bk_predicted_residual(centers, T_mean)

# Pearson on bulk
mask = centers > 0.5
rho = lnb.pearson(D[mask], bk[mask])
print(f'Pearson(D, BK_pred) (s>0.5) = {rho:+.4f}')
print(f'|D|_max (s>0.5) = {np.abs(D[mask]).max():.4f}')
print(f'|BK|_max (s>0.5) = {np.abs(bk[mask]).max():.6f}')
print(f'L = log(T_mean/2pi) = {L:.3f}')
print(f'1/L^2 = {1/L**2:.4f}')

# Also compute Fourier residual peaks
print()
print('Looking for peaks in D(s) at frequencies log(p)/L for small primes:')
# We restrict to s ∈ [0.1, 5.0]; mask out level-repulsion bin
s_bulk = centers[centers > 0.5]
D_bulk = D[centers > 0.5]
# Compute discrete Fourier amplitudes at specific frequencies
print(f'  N bulk bins: {len(s_bulk)}')
ds = centers[1] - centers[0]
total_span = s_bulk[-1] - s_bulk[0]
# Energy at frequency f: |sum D(s) exp(-2pi i f s) ds|² / span
for p in [2, 3, 5, 7, 11, 13]:
    f = np.log(p) / L  # frequency in cycles per unit s
    amp = np.sum(D_bulk * np.exp(-2j*np.pi*f*s_bulk)) * ds
    print(f'  p={p}: f={f:.4f}, amplitude={abs(amp):.4f}, phase={np.angle(amp):+.2f}')

# Compare to random frequencies (control)
print()
print('Control: amplitude at random non-prime frequencies:')
np.random.seed(42)
random_amps = []
for _ in range(20):
    f = np.random.uniform(0.05, 0.4)
    amp = np.sum(D_bulk * np.exp(-2j*np.pi*f*s_bulk)) * ds
    random_amps.append(abs(amp))
print(f'  median random |amp|: {np.median(random_amps):.4f}')
print(f'  max random |amp|:    {np.max(random_amps):.4f}')
