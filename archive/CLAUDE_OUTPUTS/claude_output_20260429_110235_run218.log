import json
with open('/apps/aplikacijos/prime-research/experiments/wildcard/bit_J_pn_dip_scaling/bit_J_pn_dip_scaling_results.json') as f:
    r = json.load(f)
# F5: m=5 local max
def get(mm):
    return next(r2 for r2 in r['rows'] if r2['m'] == mm)
g4, g5, g6, g7 = get(4), get(5), get(6), get(7)
print('F5 (m=5 local max in rel_emp):')
print(f'  rel(4)={g4[\"rel_emp\"]:.4f}, rel(5)={g5[\"rel_emp\"]:.4f}, rel(6)={g6[\"rel_emp\"]:.4f}, rel(7)={g7[\"rel_emp\"]:.4f}')
print(f'  rel(5) > rel(4)? {g5[\"rel_emp\"] > g4[\"rel_emp\"]}')
print(f'  rel(5) > rel(6)? {g5[\"rel_emp\"] > g6[\"rel_emp\"]}')
print(f'  rel(5) > rel(7)? {g5[\"rel_emp\"] > g7[\"rel_emp\"]}')
print()
print('F6 (Gaussian-Y also predicts m=5 local max):')
print(f'  rel_pY(4)={g4[\"rel_pred_gaussian_Y\"]:.4f}, rel_pY(5)={g5[\"rel_pred_gaussian_Y\"]:.4f}, rel_pY(6)={g6[\"rel_pred_gaussian_Y\"]:.4f}, rel_pY(7)={g7[\"rel_pred_gaussian_Y\"]:.4f}')
print()
# F7 composite vs prime parent
print('F7 (composite m vs prime parent within 30% of rel_emp):')
def relerr(c, p):
    rc = get(c)['rel_emp']
    rp = get(p)['rel_emp']
    return abs(rc - rp) / rp * 100
for c, p in [(4,2),(8,2),(9,3),(16,2),(25,5),(27,3)]:
    e = relerr(c, p)
    print(f'  m={c} (rad {p}): rel_emp={get(c)[\"rel_emp\"]:.4f}, parent rel_emp={get(p)[\"rel_emp\"]:.4f}, diff={e:.1f}%  {\"PASS\" if e <= 30 else \"FAIL\"}')

# Peak structure check
print()
print('PEAK structure (rel_emp > 1):')
for row in r['rows']:
    if row['rel_emp'] > 1.0:
        print(f'  m={row[\"m\"]:>3}  J*={row[\"J_star\"]}  mu_Y={row[\"mu_Y\"]:.3f}  rel_emp={row[\"rel_emp\"]:.4f}  rel_pY={row[\"rel_pred_gaussian_Y\"]:.4f}')
"

