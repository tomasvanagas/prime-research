  [Bash] python3 -c "
import numpy as np
from scipy import stats
# Single low-zero mode: arcsine distribution, excess kurtosis = -1.5
rng = np.random.default_rng(0)
N = 100000
# Draw x log-uniformly in [10^6, 10^7]
log_x = rng.uniform(np.log(1e6), np.log(1e7), N)
gammas = [14.13, 21.02, 25.01, 30.42, 32.94, 37.59, 40.92, 43.33, 48.01, 49.77]
weights = [2.0/g for g in gammas]  # weight ~ 2/gamma_rho
phases = rng.uniform(0, 2*np.pi, len(gammas))  # random phases (but they're deterministic in reality)
D_synthetic = np.zeros(N)
for k, (g, w) in enumerate(zip(gammas, weights)):
    D_synthetic += -w * np.cos(g * log_x + phases[k])
D_synthetic = -D_synthetic  # match sign convention
print(f'10-zero synthetic D: mean={D_synthetic.mean():.4f}, std={D_synthetic.std():.4f}')
print(f'  skew={stats.skew(D_synthetic):.4f}, excess_kurt={stats.kurtosis(D_synthetic):.4f}')
# Now with just the first zero
D1 = -weights[0] * np.cos(gammas[0]*log_x + phases[0])
print(f'1-zero only:  std={D1.std():.4f}, skew={stats.skew(D1):.4f}, kurt={stats.kurtosis(D1):.4f}')
# 3 zeros
D3 = sum(-weights[k]*np.cos(gammas[k]*log_x + phases[k]) for k in range(3))
print(f'3-zero:       std={D3.std():.4f}, skew={stats.skew(D3):.4f}, kurt={stats.kurtosis(D3):.4f}')
# 5 zeros
D5 = sum(-weights[k]*np.cos(gammas[k]*log_x + phases[k]) for k in range(5))
print(f'5-zero:       std={D5.std():.4f}, skew={stats.skew(D5):.4f}, kurt={stats.kurtosis(D5):.4f}')
# 10 zeros
D10 = D_synthetic
print(f'10-zero:      std={D10.std():.4f}, skew={stats.skew(D10):.4f}, kurt={stats.kurtosis(D10):.4f}')
# 50 zeros
gammas50 = gammas + [52.97, 56.45, 59.35, 60.83, 65.11, 67.08, 69.55, 72.07, 75.70, 77.14] + list(range(80, 200, 4))
weights50 = [2.0/g for g in gammas50]
phases50 = rng.uniform(0, 2*np.pi, len(gammas50))
D50 = sum(-w*np.cos(g*log_x + p) for g, w, p in zip(gammas50, weights50, phases50))
print(f'~30-zero:     std={D50.std():.4f}, skew={stats.skew(D50):.4f}, kurt={stats.kurtosis(D50):.4f}')
"

