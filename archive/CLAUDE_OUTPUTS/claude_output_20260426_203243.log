    52	def wasserstein1_to_normal(samples: np.ndarray,
    53	                           mu: float | None = None,
    54	                           sigma: float | None = None) -> float:
    55	    """
    56	    Compute W_1 between empirical distribution of `samples` and
    57	    N(mu, sigma^2), using sorted-CDF integration in closed form.
    58	
    59	    For sorted x_(1) <= ... <= x_(K),
    60	        W_1 = sum_k integral_{(k-1)/K}^{k/K} |x_(k) - F^{-1}(u)| du
    61	    where F is the Gaussian CDF.  We use the substitution u = F(t)
    62	    and split each [x_(k-?), F^{-1}(k/K)] piece accordingly.
    63	    """
    64	    K = len(samples)
    65	    if mu is None:
    66	        mu = float(np.mean(samples))
    67	    if sigma is None:
    68	        sigma = float(np.std(samples, ddof=0))
    69	    if sigma == 0:
    70	        sigma = 1e-30
    71	    s = np.sort(samples)
    72	    # quantile boundaries u_k = k/K, k = 0..K
    73	    us = np.arange(K + 1) / K
    74	    # F^{-1}(u) for u in (0, 1); endpoints are infinite -> use eps clamp
    75	    eps = 1e-12
    76	    us_clipped = np.clip(us, eps, 1 - eps)
    77	    inv = stats.norm.ppf(us_clipped, loc=mu, scale=sigma)
    78	    inv[0] = mu - 6 * sigma  # numerical infinity sentinel
    79	    inv[-1] = mu + 6 * sigma
    80	    # On interval (u_{k-1}, u_k), empirical inverse is s[k-1] (constant).
    81	    # |s[k-1] - F^{-1}(u)| du.  Use trapezoidal w/ 4 subdivisions per slab.
