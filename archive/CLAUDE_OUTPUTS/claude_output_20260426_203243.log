  [Bash] python3 -c "
import time
import numpy as np
from ripser import ripser
rng = np.random.default_rng(0)
for M in [1000, 2000, 3000]:
    x = rng.exponential(1.0, size=M)
    cloud = np.stack([x[:M-2], x[1:M-1], x[2:M]], axis=1)
    t0 = time.time()
    res = ripser(cloud, maxdim=1, thresh=4.0)
    dt = time.time() - t0
    print(f'M={M}, d=3: {dt:.2f}s; H1 features={len(res[\"dgms\"][1])}')"

