Let me also test the Hasse identity for other arithmetic divisors to see if it generalizes.
  [Bash] python3 -c "
from baker_norine_chi_p import q_reduce
from baker_norine_hasse import hasse_graph
from sympy import isprime, factorint, mobius

def liouville(n):
    if n == 1: return 1
    return (-1) ** sum(factorint(n).values())

def squarefree(n):
    if n == 1: return 1
    return 1 if max(factorint(n).values()) == 1 else 0

def divisor_count(n):
    return len(list(d for d in range(1, n+1) if n % d == 0))

print('Test on Hasse: does D\\'(q=1) = (deg of divisor restricted to N(q))? aka, count of neighbors of 1 with chips')
print()
for N in [32, 64, 128]:
    V, adj = hasse_graph(N)
    print(f'\\n--- N={N} ---')
    primes = [p for p in V if isprime(p)]
    
    # Different divisors
    test_divisors = {
        'D_P (primes)': lambda v: 1 if isprime(v) else 0,
        'D_sqfree (no chip at 1)': lambda v: squarefree(v) if v != 1 else 0,
        'D_lam_pos': lambda v: 1 if v != 1 and liouville(v) == 1 else 0,
        'D_mu_pos': lambda v: 1 if v != 1 and mobius(v) == 1 else 0,
        'D_two_pf (Omega=2)': lambda v: 1 if v != 1 and sum(factorint(v).values()) == 2 else 0,
    }
    
    for name, f in test_divisors.items():
        D = {v: f(v) for v in V}
        Dr = q_reduce(D, 1, V, adj)
        # Predict: chips on neighbors of 1 in original D = sum of D[p] for p prime
        # Plus chips that 'cascade' down from non-neighbors of 1
        chips_on_N1 = sum(D[v] for v in adj[1])
        sum_D = sum(D.values())
        nonq_supp_size = sum(1 for v in V if v != 1 and Dr[v] > 0)
        nonq_chips = sum(Dr[v] for v in V if v != 1 and Dr[v] > 0)
