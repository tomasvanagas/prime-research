  [Bash] python3 -c "
from baker_norine_chi_p import divisibility_graph, q_reduce
from sympy import isprime, factorint, mobius
import random

def liouville(n):
    if n == 1:
        return 1
    return (-1) ** sum(factorint(n).values())

def squarefree(n):
    if n == 1:
        return 1
    return 1 if max(factorint(n).values()) == 1 else 0

for N in [32, 64, 128]:
    V, adj = divisibility_graph(N)
    q = 1
    print(f'\\n=== N={N} ===')
    
    # Prime divisor
    D = {v: (1 if isprime(v) else 0) for v in V}
    Dr = q_reduce(D, q, V, adj)
    print(f'  D_prime: D\\'(q)={Dr[q]}, |supp non-q|={sum(1 for v in V if v != q and Dr[v] > 0)}, '
          f'sum={sum(Dr.values())}, min={min(Dr.values())}, max={max(Dr.values())}')
    
    # Squarefree divisor (excluding 1, since 1 is q)
    D = {v: (squarefree(v) if v != 1 else 0) for v in V}
    Dr = q_reduce(D, q, V, adj)
    print(f'  D_sqfree: D\\'(q)={Dr[q]}, |supp non-q|={sum(1 for v in V if v != q and Dr[v] > 0)}, '
          f'sum={sum(Dr.values())}, min={min(Dr.values())}, max={max(Dr.values())}')
    
    # Liouville-positive divisor (chips at v with lambda(v) = +1, but not at 1)
    D = {v: (1 if v != 1 and liouville(v) == 1 else 0) for v in V}
    Dr = q_reduce(D, q, V, adj)
    print(f'  D_lam+:  D\\'(q)={Dr[q]}, |supp non-q|={sum(1 for v in V if v != q and Dr[v] > 0)}, '
          f'sum={sum(Dr.values())}, min={min(Dr.values())}, max={max(Dr.values())}')
    
    # Mobius-positive (mu(v) = +1)
    D = {v: (1 if v != 1 and mobius(v) == 1 else 0) for v in V}
    Dr = q_reduce(D, q, V, adj)
    print(f'  D_mu+:   D\\'(q)={Dr[q]}, |supp non-q|={sum(1 for v in V if v != q and Dr[v] > 0)}, '
          f'sum={sum(Dr.values())}, min={min(Dr.values())}, max={max(Dr.values())}')
    
    # Even divisor (chips on every even v)
    D = {v: (1 if v != 1 and v % 2 == 0 else 0) for v in V}
    Dr = q_reduce(D, q, V, adj)
    print(f'  D_even:  D\\'(q)={Dr[q]}, |supp non-q|={sum(1 for v in V if v != q and Dr[v] > 0)}, '
          f'sum={sum(Dr.values())}, min={min(Dr.values())}, max={max(Dr.values())}')
