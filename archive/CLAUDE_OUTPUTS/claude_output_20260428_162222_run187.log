import json
for d in (14,18,20):
    data = json.load(open(f'experiments/constructions/spike_eigenvectors_chi_p/spike_d{d}_results.json'))
    rec = data[0]
    spikes = rec['chi_p_spikes']
    k_star = rec['k_star_assumed']
    # Convention: skip rank-1 mean (first), take next k_star
    block = sum(s['sigma']**2 for s in spikes[1:1+k_star])
    pi_N = {14: 1900, 18: 23000, 20: 82025}[d]
    print(f'd={d} k*={k_star} N={rec[\"N\"]} pi_N={pi_N} block={block:.4f} block/pi_N={block/pi_N:.6f} block/(0.21*pi_N)={block/(0.21*pi_N):.6f}')
    sigmas = [s['sigma'] for s in spikes]
    print(f'   top sigma (excluded as rank-1 mean): {sigmas[0]:.3f}')
    # k_star=5 means we sum spikes[1..5], i.e. indices 1..5
    print(f'   sigmas[1:1+k*]: {[round(s,3) for s in sigmas[1:1+k_star]]}')
"

