import json
import math
# Check what the spike-vs-bulk transition looks like at the cliff
for d in (14,18,20):
    data = json.load(open(f'experiments/constructions/spike_eigenvectors_chi_p/spike_d{d}_results.json'))
    rec = data[0]
    spikes = rec['chi_p_spikes']
    k_star = rec['k_star_assumed']
    sigmas = [s['sigma'] for s in spikes]
    pi_N = {14: 1900, 18: 23000, 20: 82025}[d]
    N = rec['N']
    p = pi_N / N
    # Marchenko-Pastur null upper edge for an M x M matrix, p_N = pi(N)/N
    # M^T M has eigenvalues with MP density on [(1-sqrt(p))^2 * M, (1+sqrt(p))^2 * M]?
    # For a sqrt(M) x sqrt(M) matrix with Bernoulli(p) entries
    M = int(math.sqrt(N))
    # singular values squared / M ~ MP density
    # Top edge in sigma scale: sqrt(M*p*(1-p)) * (1 + sqrt(M/M))? = 2*sqrt(M*p*(1-p))? no
    # For symmetric N(0,1) Wigner: eigenvalues edge 2*sqrt(M)
    # For chi_P entries are 0 or 1 with prob p; M = sqrt(N) here. variance = p(1-p)
    # Centered Wigner-like: top edge of sigma² ~ 4*M*p*(1-p)
    mp_top_sigma = 2 * math.sqrt(M * p * (1-p))
    print(f'd={d} M=sqrt(N)={M} k*={k_star}')
    print(f'   sigmas around k_star: {[round(s,3) for s in sigmas[max(0,k_star-2):k_star+5]]}')
    print(f'   MP-edge sigma estimate: {mp_top_sigma:.3f}')
    print(f'   sigma at k_star-1 (last spike): {sigmas[k_star-1]:.3f}')
    print(f'   sigma at k_star (first non-spike): {sigmas[k_star]:.3f}')
    print()
"

