import math
# Monte Carlo std error of sigma_eff = rms(|err|) at N=20 under half-normal:
# Var(sigma_eff) ~ sigma^2 / (2N) (delta method on mean(X^2)).
N = 20
cv = math.sqrt(1.0/(2*N))
print(f'N={N}: CV(sigma_eff) = {cv:.3f} ({cv*100:.1f}%)')
# Std error of ratio sigma1/sigma2 (independent samples): roughly sqrt(2)*CV
cv_ratio = cv * math.sqrt(2)
print(f'CV(ratio) ~ {cv_ratio:.3f} ({cv_ratio*100:.1f}%)')
print(f'1-sigma band on ratio = (1 +/- {cv_ratio:.3f})')
print(f'2-sigma band on ratio = (1 +/- {2*cv_ratio:.3f})')
# How many of the cells with ratio >= 1.10 are 1-sigma significant?
# Look at the ratios 1.10, 1.16, 1.20, 1.24, 1.30, 1.35, 1.40, 1.49, 1.62
ratios_above = [1.0581, 1.0593, 1.1023, 1.1096, 1.1155, 1.1622, 1.1832, 1.2055, 1.2435, 1.2904, 1.3055, 1.3070, 1.3332, 1.3438, 1.3728, 1.3840, 1.4309, 1.4399, 1.4918, 1.5205, 1.5414, 1.5589, 1.5737, 1.6166]
n_above_1sig = sum(1 for r in ratios_above if r > 1 + cv_ratio)
n_above_2sig = sum(1 for r in ratios_above if r > 1 + 2*cv_ratio)
print(f'Of {len(ratios_above)} ratios > 1.05, {n_above_1sig} are > 1-sigma above 1.0, {n_above_2sig} are > 2-sigma')
# Sub-1 ratios
ratios_below = [0.9349, 0.9684, 0.9692, 0.9722, 0.9731, 0.9757, 0.9769, 0.9805, 0.9809]
n_below_1sig = sum(1 for r in ratios_below if r < 1 - cv_ratio)
print(f'Of {len(ratios_below)} sub-1 ratios, {n_below_1sig} are 1-sigma below 1.0')
print('Min sub-1:', min(ratios_below))
print('1 - 1-sigma threshold:', 1 - cv_ratio)
