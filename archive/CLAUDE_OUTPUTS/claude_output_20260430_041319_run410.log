Let me do a paired comparison to strengthen the conclusion.
  [Bash] python3 -c "
import csv
from collections import defaultdict

# Load per-sample data
errs = defaultdict(dict)  # (anchor, x, K, kernel) -> abs_err
with open('experiments/analytic/polylog_approx_pi/smoothed_kernels_data.csv') as f:
    reader = csv.DictReader(f)
    for r in reader:
        key = (int(r['anchor_log10']), int(r['x']), int(r['K_compute']))
        errs[key][r['kernel']] = float(r['abs_err'])

# Per (anchor, K), per kernel: paired ratio = sqrt( mean( err_kernel^2 ) / mean( err_hard^2 ) )
# vs unpaired estimate. Also compute 'wins' = #x where err_kernel < err_hard.
import math
print(f'{\"anchor\":>6s} {\"K\":>5s} {\"kernel\":>9s} {\"ratio\":>7s} {\"wins\":>5s} {\"N\":>3s} {\"sig_test\":>10s}')
print('-' * 60)
agg = defaultdict(lambda: defaultdict(list))  # (anchor, K) -> kernel -> list of (err_K, err_H) tuples
for key, kerr in errs.items():
    if 'hard' not in kerr: continue
    h = kerr['hard']
    for kn, e in kerr.items():
        agg[(key[0], key[2])][kn].append((e, h))

for (anc, K) in sorted(agg.keys()):
    for kn in ['hard','tukey25','tukey50','cosine','riesz','triangle','riesz4','hamming','hann']:
        if kn not in agg[(anc, K)]: continue
        pairs = agg[(anc, K)][kn]
        N = len(pairs)
        sumK = sum(e**2 for e,_ in pairs)
        sumH = sum(h**2 for _,h in pairs)
        ratio = math.sqrt(sumK/sumH) if sumH > 0 else float('nan')
        # Paired sign test: how often is err_kernel <= err_hard?
        wins = sum(1 for e,h in pairs if e < h)
        # Wilcoxon-style: under null (no difference), wins ~ Binomial(N, 0.5)
        # P(wins >= w) = sum k>=w binom(N,k) * 0.5^N
        from math import comb
        pval = sum(comb(N, k) for k in range(wins, N+1)) / (2**N) if kn != 'hard' else float('nan')
        print(f'{anc:>6d} {K:>5d} {kn:>9s} {ratio:>7.3f} {wins:>3d}/{N} {pval:>10.4f}')
    print()
"

